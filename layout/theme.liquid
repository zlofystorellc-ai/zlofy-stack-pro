<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="day">
<head>
  {%- comment -%}
    Minimal OS 2.0 shell for the ap-* product page.
    If you merge these files into an existing theme, KEEP your theme's own layout and only
    make sure it renders snippets/ap-tokens.liquid inside <head> (see README).
  {%- endcomment -%}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_sand | default: '#F4EDE4' }}">
  <script>
    (function () {
      try {
        var t = localStorage.getItem('ap-theme');
        if (t !== 'day' && t !== 'night') {
          var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var h = new Date().getHours();
          t = dark ? 'night' : (h >= 6 && h < 18 ? 'day' : 'night');
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'day');
      }
    })();
  </script>
  <title>
    {{- page_title -}}
    {%- if current_page != 1 %} – {{ 'ap.general.page' | t: number: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif %}
  {%- liquid
    assign canon = canonical_url
    if template.name == 'product' and settings.hero_product != blank and product.id == settings.hero_product.id
      assign canon = shop.url | append: routes.root_url
    endif
  -%}
  <link rel="canonical" href="{{ canon }}">
  {%- if template.name == 'collection' or template.name == 'list-collections' or template.name == 'search' or template.suffix == 'addon' %}
    <meta name="robots" content="noindex,follow">
  {%- endif %}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:url" content="{{ canon }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if template.name == 'product' or template.name == 'index' %}product{% else %}website{% endif %}">
  {%- if page_description %}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif %}
  {%- assign og_product = settings.hero_product | default: product -%}
  {%- if og_product.featured_image %}
    <meta property="og:image" content="https:{{ og_product.featured_image | image_url: width: 1200 }}">
  {%- endif %}

  <link rel="icon" type="image/svg+xml" href="{{ 'ap-favicon.svg' | asset_url }}">
  {%- if template.name == 'index' %}
    <script type="application/ld+json">
    { "@context": "https://schema.org", "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} }
    </script>
  {%- endif %}
  {% render 'ap-tokens' %}

  {%- comment -%}
    The product LCP image is the ONLY preloaded asset: sections/ap-hero.liquid uses image_tag's
    `preload: true` (HTTP Link header) with loading: eager + fetchpriority: high on the first image.
  {%- endcomment -%}

  {{ content_for_header }}
</head>
<body class="apx-body template-{{ template.name | handleize }}">
  <a class="apx-skip" href="#MainContent">{{ 'ap.general.skip_to_content' | t }}</a>

  {% sections 'header-group' %}
  {% render 'ap-header' %}
  <script src="{{ 'ap-motion.js' | asset_url }}" type="module"></script>

  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% render 'ap-footer' %}
</body>
</html>
