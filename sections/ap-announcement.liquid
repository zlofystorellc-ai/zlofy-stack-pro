{%- comment -%}
  Announcement bar: ONE static line, no carousel, no countdown.
  Leave the text empty to show the free-shipping line from Theme settings (Landing page / Purchase and cart).
{%- endcomment -%}
{%- assign line = section.settings.text -%}
{%- if line == blank and settings.free_shipping_threshold > 0 -%}
  {%- assign thr_money = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
  {%- assign line = 'ap.buybox.free_shipping' | t: amount: thr_money -%}
{%- endif -%}
{%- if line != blank -%}
<div class="apx-announce" role="region" aria-label="{{ 'ap.announcement.label' | t }}">
  <p class="apx-announce__line">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ line }}</a>{%- else -%}{{ line }}{%- endif -%}
  </p>
</div>
{%- endif -%}

{% stylesheet %}
  .apx-announce{background:var(--ap-dark);color:var(--ap-on-dark)}
  .apx-announce__line{margin:0;padding:10px var(--ap-gutter);text-align:center;font-size:.875rem;font-weight:600;letter-spacing:.02em}
  .apx-announce a{color:var(--ap-on-dark)}
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "info": "One line. Leave empty to show the free-shipping line from Theme settings." },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ],
  "presets": [ { "name": "Announcement bar" } ]
}
{% endschema %}
