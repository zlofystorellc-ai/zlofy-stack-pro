{%- comment -%}
  Before / after slider. Use ONLY photos of real, consenting customers, unedited (no filters, retouching,
  or different lighting between the two photos), and photos you own. The disclaimer below is shown under the sliders.
  Renders nothing until at least one pair has both images. No outcome claims are written for you.
{%- endcomment -%}
{%- assign pair_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.settings.before != blank and block.settings.after != blank -%}{%- assign pair_count = pair_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if pair_count > 0 -%}
<section class="apx-ba apx-section" aria-labelledby="{{ section.id }}-title">
  <div class="apx-ba__bg" aria-hidden="true">
    <i class="apx-ba__blob apx-ba__blob--1"></i><i class="apx-ba__blob apx-ba__blob--2"></i><i class="apx-ba__blob apx-ba__blob--3"></i>
    <b style="--x:6%;--s:34px;--d:15s;--l:0s"></b><b style="--x:17%;--s:20px;--d:19s;--l:-6s"></b><b style="--x:29%;--s:46px;--d:23s;--l:-11s"></b><b style="--x:44%;--s:24px;--d:17s;--l:-3s"></b><b style="--x:58%;--s:38px;--d:21s;--l:-14s"></b><b style="--x:71%;--s:18px;--d:16s;--l:-8s"></b><b style="--x:83%;--s:42px;--d:24s;--l:-2s"></b><b style="--x:93%;--s:26px;--d:18s;--l:-12s"></b>
  </div>
  <div class="apx-wrap apx-ba__in">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if section.settings.tab_before != blank -%}
      <div class="apx-ba__ctl" data-ap-ba-ctl>
        <div class="apx-ba__seg" role="group" aria-label="{{ 'ap.before_after.slider' | t }}">
          <button type="button" data-ap-ba-all="100" aria-pressed="false">{{ section.settings.tab_before }}</button>
          <button type="button" data-ap-ba-all="50" aria-pressed="true">{{ section.settings.tab_split }}</button>
          <button type="button" data-ap-ba-all="0" aria-pressed="false">{{ section.settings.tab_after }}</button>
        </div>
        <p class="apx-ba__pct" aria-live="polite"><i aria-hidden="true"></i><span data-ap-ba-pct>50% before · 50% after</span></p>
      </div>
    {%- endif -%}
    <div class="apx-ba__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.before != blank and block.settings.after != blank -%}
          {%- assign ba_label = block.settings.caption | default: block.settings.name | default: product.title -%}
          <figure class="apx-ba__item" data-ap-ba data-pos="50" {{ block.shopify_attributes }}>
            <div class="apx-ba__stage">
              {{ block.settings.after | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 450px, (min-width: 760px) 45vw, 92vw', class: 'apx-ba__img apx-ba__img--after', alt: block.settings.after.alt | default: 'Illustration of a worn patch that has turned white in the middle' }}
              <div class="apx-ba__clip">
                {{ block.settings.before | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 450px, (min-width: 760px) 45vw, 92vw', class: 'apx-ba__img', alt: block.settings.before.alt | default: 'Illustration of a small spot before the patch is worn' }}
              </div>
              <span class="apx-ba__bar" aria-hidden="true"><i></i></span>
              <button type="button" class="apx-ba__tag apx-ba__tag--b" data-ap-ba-snap="100" aria-pressed="false">{{ 'ap.before_after.before' | t }}</button>
              <button type="button" class="apx-ba__tag apx-ba__tag--a" data-ap-ba-snap="0" aria-pressed="false">{{ 'ap.before_after.after' | t }}</button>
              <span class="apx-ba__hint" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/></svg>{{ 'ap.before_after.drag' | t }}</span>
              {%- if section.settings.badge != blank -%}<span class="apx-ba__badge">{{ section.settings.badge }}</span>{%- endif -%}
              <input class="apx-ba__range" type="range" min="0" max="100" value="50" step="1" data-ap-ba-range aria-label="{{ 'ap.before_after.slider' | t }}: {{ ba_label | escape }}">
            </div>
            {%- if block.settings.name != blank or block.settings.caption != blank or block.settings.sub != blank -%}
              <figcaption>
                {%- if block.settings.name != blank -%}<strong>{{ block.settings.name }}</strong>{%- endif -%}
                {%- if block.settings.caption != blank -%}<span>{{ block.settings.caption }}</span>{%- endif -%}
                {%- if block.settings.sub != blank -%}<span class="apx-ba__sub">{{ block.settings.sub }}</span>{%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.disclaimer != blank -%}<p class="apx-fine apx-center apx-ba__fine">{{ section.settings.disclaimer }}</p>{%- endif -%}
  </div>
</section>
<script src="{{ 'ap-before-after.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .apx-ba__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px;margin:clamp(28px,4vw,48px) auto 0;max-width:920px}
  .apx-ba__grid:has(.apx-ba__item:only-child){max-width:440px}
  .apx-ba__item{margin:0}
  .apx-ba__stage{--pos:50%;position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:24px;background:var(--ap-sand);box-shadow:0 18px 40px rgba(59,10,20,.1);touch-action:pan-y}
  .apx-ba__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none;user-select:none}
  .apx-ba__clip{position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--pos)) 0 0)}
  .apx-ba__tag{position:absolute;top:14px;padding:.35rem .8rem;border-radius:999px;background:rgba(255,255,255,.92);color:var(--ap-ink);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;pointer-events:none}
  .apx-ba__tag--b{left:14px}
  .apx-ba__tag--a{right:14px}
  .apx-ba__bar{position:absolute;top:0;bottom:0;left:var(--pos);width:2px;margin-left:-1px;background:var(--ap-white);pointer-events:none;box-shadow:0 0 12px rgba(0,0,0,.25)}
  .apx-ba__bar i{position:absolute;left:50%;top:50%;width:44px;height:44px;margin:-22px 0 0 -22px;border-radius:50%;background:var(--ap-white);box-shadow:0 4px 14px rgba(59,10,20,.3)}
  .apx-ba__bar i::before,.apx-ba__bar i::after{content:"";position:absolute;top:50%;margin-top:-5px;border:5px solid transparent}
  .apx-ba__bar i::before{left:9px;border-right-color:var(--ap-blush-deep);border-left-width:0}
  .apx-ba__bar i::after{right:9px;border-left-color:var(--ap-blush-deep);border-right-width:0}
  .apx-ba__range{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize;-webkit-appearance:none;appearance:none}
  .apx-ba__stage:has(.apx-ba__range:focus-visible){outline:3px solid var(--ap-blush-deep);outline-offset:3px}
  .apx-ba__item figcaption{display:grid;gap:2px;margin-top:12px;text-align:center}
  .apx-ba__item figcaption span{color:var(--ap-ink-soft);font-size:.9375rem}
  @media (max-width:759px){.apx-ba__grid{gap:28px;max-width:460px}}

  /* interactive polish */
  .apx-ba__item{transition:transform .5s cubic-bezier(.2,.7,.2,1),opacity .7s ease;will-change:transform}
  .apx-ba.is-armed .apx-ba__item{opacity:0;transform:translateY(28px)}
  .apx-ba.is-armed.is-in .apx-ba__item{opacity:1;transform:none}
  .apx-ba.is-armed.is-in .apx-ba__item:nth-child(2){transition-delay:.12s}
  .apx-ba__stage{isolation:isolate;box-shadow:0 30px 60px rgba(110,20,35,.18),0 8px 20px rgba(59,10,20,.12),0 0 0 6px rgba(255,255,255,.7);transition:box-shadow .4s ease,transform .25s cubic-bezier(.2,.7,.2,1);transform:perspective(900px) translateY(var(--lift,0px)) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg))}
  @media (hover:hover){.apx-ba__item:hover .apx-ba__stage{--lift:-6px;box-shadow:0 44px 80px rgba(110,20,35,.26),0 10px 24px rgba(59,10,20,.14),0 0 0 6px #fff}}
  .apx-ba__stage::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:linear-gradient(180deg,rgba(42,8,16,.35),transparent 22%,transparent 70%,rgba(42,8,16,.4));z-index:1}
  .apx-ba__img,.apx-ba__clip{transform:scale(1.02)}
  .apx-ba__bar{z-index:2;width:3px;margin-left:-1.5px;border-radius:2px}
  .apx-ba__bar i{width:52px;height:52px;margin:-26px 0 0 -26px;box-shadow:0 8px 24px rgba(0,0,0,.4)}
  .apx-ba__bar i::before,.apx-ba__bar i::after{margin-top:-6px;border-width:6px}
  .apx-ba__bar i::before{left:11px}.apx-ba__bar i::after{right:11px}
  .apx-ba__bar i::before,.apx-ba__bar i::after{transition:transform .25s ease}
  .apx-ba__bar i{animation:apx-ba-ping 2.8s ease-out infinite}
  .apx-ba__item.is-touched .apx-ba__bar i{animation:none}
  @keyframes apx-ba-ping{0%{box-shadow:0 8px 24px rgba(0,0,0,.4),0 0 0 0 rgba(255,255,255,.55)}70%,100%{box-shadow:0 8px 24px rgba(0,0,0,.4),0 0 0 22px rgba(255,255,255,0)}}
  .apx-ba__tag{z-index:3;top:16px;border:0;cursor:pointer;font-family:inherit;background:rgba(42,8,16,.55);color:#fff;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);box-shadow:inset 0 0 0 1px rgba(255,255,255,.35);pointer-events:auto;transition:background .3s ease,color .3s ease,transform .2s ease;min-height:36px}
  .apx-ba__tag:hover{transform:translateY(-1px)}
  .apx-ba__tag:focus-visible{outline:3px solid #fff;outline-offset:2px}
  .apx-ba__item[data-side="before"] .apx-ba__tag--b,.apx-ba__item[data-side="after"] .apx-ba__tag--a{background:#fff;color:var(--ap-ink);box-shadow:0 6px 18px rgba(0,0,0,.3)}
  .apx-ba__hint{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);z-index:3;display:inline-flex;align-items:center;gap:.5rem;padding:.5rem .95rem;border-radius:999px;background:rgba(42,8,16,.6);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:#fff;font-size:.8125rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;pointer-events:none;transition:opacity .4s ease,transform .4s ease}
  .apx-ba__item.is-touched .apx-ba__hint{opacity:0;transform:translate(-50%,8px)}
  .apx-ba__badge{position:absolute;right:14px;bottom:18px;z-index:3;padding:.3rem .65rem;border-radius:8px;background:rgba(42,8,16,.55);color:#F5E6E8;font-size:.6875rem;letter-spacing:.04em;pointer-events:none}
  .apx-ba__item figcaption{margin-top:20px}
  .apx-ba__item figcaption span{color:var(--ap-ink-soft);font-weight:600}
  .apx-ba__item figcaption strong{font-family:var(--ap-display,inherit);font-size:1.0625rem}
  @media (max-width:759px){.apx-ba__tag{top:12px;font-size:.6875rem;padding:.3rem .7rem}.apx-ba__badge{display:none}.apx-ba__hint{bottom:14px}}
  @media (prefers-reduced-motion:reduce){.apx-ba__item,.apx-ba__stage{transition:none;transform:none}.apx-ba.is-armed .apx-ba__item{opacity:1;transform:none}.apx-ba__bar i{animation:none}}

  /* soft brand background that matches the rest of the site (blush, lilac, apricot) */
  .apx-ba{position:relative;overflow:hidden;background:linear-gradient(180deg,#FBF7F5 0%,#F5E6E8 52%,#F7EBED 100%);color:var(--ap-ink)}
  .apx-ba__in{position:relative;z-index:1}
  .apx-ba__bg{position:absolute;inset:0;pointer-events:none;overflow:hidden}
  .apx-ba__blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.55;will-change:transform;transform:translate3d(0,calc(var(--sp,0) * -60px),0)}
  .apx-ba__blob--1{width:480px;height:480px;left:-140px;top:-120px;background:var(--ap-blush);opacity:.28;animation:apx-ba-drift 16s ease-in-out infinite alternate}
  .apx-ba__blob--2{width:520px;height:520px;right:-160px;top:18%;background:var(--ap-lilac);opacity:.5;animation:apx-ba-drift 20s ease-in-out -6s infinite alternate-reverse}
  .apx-ba__blob--3{width:420px;height:420px;left:30%;bottom:-200px;background:var(--ap-apricot);opacity:.32;animation:apx-ba-drift 18s ease-in-out -3s infinite alternate}
  @keyframes apx-ba-drift{from{margin:0 0 0 0}to{margin:50px 0 0 60px}}
  .apx-ba__bg b{position:absolute;left:var(--x);bottom:-60px;width:var(--s);height:var(--s);border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.95),rgba(255,255,255,.35) 60%,rgba(255,255,255,.1));box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.9),0 6px 14px rgba(110,20,35,.12);opacity:0;animation:apx-ba-rise var(--d) linear var(--l) infinite}
  @keyframes apx-ba-rise{0%{transform:translate3d(0,0,0) scale(.8);opacity:0}12%{opacity:.9}85%{opacity:.7}100%{transform:translate3d(24px,-115vh,0) scale(1.1);opacity:0}}
  .apx-ba .apx-eyebrow{background:#fff;color:var(--ap-blush-deep);border-color:rgba(110,20,35,.28)}
  .apx-ba__fine{margin-top:28px;color:var(--ap-ink-soft)}
  .apx-ba__stage:has(.apx-ba__range:focus-visible){outline-color:var(--ap-blush-deep)}
  .apx-ba__stage::before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;border-radius:inherit;opacity:0;transition:opacity .3s ease;background:radial-gradient(circle at var(--gx,50%) var(--gy,30%),rgba(255,255,255,.35),transparent 45%)}
  .apx-ba__item:hover .apx-ba__stage::before{opacity:1}
  .apx-ba__bar{background:#fff}
  /* headline lines rise in one after another */
  .apx-ba.is-armed .apx-center>*{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
  .apx-ba.is-armed.is-in .apx-center>*{opacity:1;transform:none}
  .apx-ba.is-in .apx-center>:nth-child(2){transition-delay:.08s}.apx-ba.is-in .apx-center>:nth-child(3){transition-delay:.16s}
  .apx-ba.is-armed .apx-ba__fine{opacity:0;transition:opacity .8s ease .5s}.apx-ba.is-armed.is-in .apx-ba__fine{opacity:1}
  @media (prefers-reduced-motion:reduce){.apx-ba__blob,.apx-ba__bg b{animation:none}.apx-ba__bg b{opacity:.5;bottom:20%}.apx-ba__blob{transform:none}.apx-ba.is-armed .apx-center>*,.apx-ba.is-armed .apx-ba__fine{opacity:1;transform:none;transition:none}}
  @media (max-width:759px){
    .apx-ba__grid{display:flex;gap:14px;max-width:none;margin-inline:calc(var(--ap-gutter) * -1);padding:6px var(--ap-gutter) 12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
    .apx-ba__grid::-webkit-scrollbar{display:none}
    .apx-ba__item{flex:0 0 84%;scroll-snap-align:center}
    .apx-ba__tag{min-height:36px;font-size:.6875rem}
  }
  @media (max-width:759px){.apx-ba__bg b{display:none}}
  @media (max-width:759px){.apx-ba__tag{min-height:40px}}

  /* look: cream background, segmented control + live percentage chip, two-line captions */
  .apx-ba{background:linear-gradient(180deg,#FDF8F6 0%,#FAF0EF 100%)}
  .apx-ba__ctl{display:grid;justify-items:center;gap:12px;margin-top:1.6rem}
  .apx-ba__seg{display:flex;max-width:100%;padding:5px;gap:2px;overflow-x:auto;border:1px solid var(--ap-line);border-radius:999px;background:#fff;scrollbar-width:none}
  .apx-ba__seg::-webkit-scrollbar{display:none}
  .apx-ba__seg button{flex:none;min-height:44px;padding:0 18px;border:0;border-radius:999px;background:transparent;color:var(--ap-ink);font:inherit;font-size:.9375rem;font-weight:600;white-space:nowrap;cursor:pointer;transition:background .2s,color .2s}
  .apx-ba__seg button[aria-pressed="true"]{background:var(--ap-ink);color:#fff}
  .apx-ba__seg button:focus-visible{outline:3px solid var(--ap-blush-deep);outline-offset:2px}
  .apx-ba__pct{display:inline-flex;align-items:center;gap:8px;margin:0;padding:.4rem .95rem;border:1px solid var(--ap-line);border-radius:999px;background:#fff;font-size:.8125rem;font-weight:600;color:var(--ap-ink)}
  .apx-ba__pct i{width:6px;height:6px;border-radius:50%;background:var(--ap-ink)}
  .apx-ba__grid{max-width:1100px}
  .apx-ba__item figcaption{margin-top:16px;gap:4px}
  .apx-ba__item figcaption span{font-size:.9375rem;font-weight:400;color:var(--ap-ink)}
  .apx-ba__item figcaption .apx-ba__sub{font-size:.8125rem;font-weight:700;color:var(--ap-ink-soft)}
  @media (max-width:520px){.apx-ba__seg button{padding:0 12px;font-size:.8125rem}}
  @media (prefers-reduced-motion:reduce){.apx-ba__seg button{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "Before and after",
  "tag": "div",
  "enabled_on": { "templates": ["product", "index"] },
  "settings": [
    { "type": "paragraph", "content": "Use only photos of real, consenting customers, unedited and taken in the same light, and photos you own. Nothing shows until a pair has both images." },
    { "type": "text", "id": "eyebrow", "label": "Pill label", "default": "Real photos" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before and after, from real customers" },
    { "type": "textarea", "id": "text", "label": "Intro (optional)", "default": "Drag the slider to compare." },
    { "type": "header", "content": "Switch above the photos (empty first text hides it)" },
    { "type": "text", "id": "tab_before", "label": "Button 1 (all photos to before)", "default": "Before wearing (0 hrs)" },
    { "type": "text", "id": "tab_split", "label": "Button 2 (50/50)", "default": "50 / 50 split view" },
    { "type": "text", "id": "tab_after", "label": "Button 3 (all photos to after)", "default": "After wearing (6–8 hrs)" },
    { "type": "text", "id": "badge", "label": "Small corner badge on each photo", "default": "Illustration", "info": "Leave it in for illustrated or computer-made photos. Clear it only for your own real photos." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Photos are from real customers, shared with permission and not retouched. Results vary from person to person." }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Photo pair",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "before", "label": "Before photo" },
        { "type": "image_picker", "id": "after", "label": "After photo" },
        { "type": "text", "id": "name", "label": "First name (optional)" },
        { "type": "text", "id": "sub", "label": "Second caption line (optional)", "info": "For example Day patch · 0.15 mm ultra-thin matte." },
        { "type": "text", "id": "caption", "label": "Caption (optional)", "info": "For example how long the patch was worn. State only what actually happened." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before and after",
      "blocks": [ { "type": "pair" }, { "type": "pair" } ]
    }
  ]
}
{% endschema %}
