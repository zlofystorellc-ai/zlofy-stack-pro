{%- comment -%}
  Comparison table: your brand vs typical single-type patches.
  Never name competitors or use their trademarks. Every cell must be factual and substantiated.
  A "Price per patch" block fills the brand cell from the variant/product metafield custom.patch_count.
{%- endcomment -%}
{%- liquid
  assign cmp_variant = product.selected_or_first_available_variant
  assign cmp_count = cmp_variant.metafields.custom.patch_count.value | default: product.metafields.custom.patch_count.value
  assign other_label = section.settings.other_label | default: 'Typical single-type patches'
  assign other_lc = other_label | downcase
-%}
<section class="apx-cmp apx-section">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'ap.comparison.heading' | t: brand: settings.brand_name, other: other_lc }}
        {%- endif -%}
      </h2>
    </div>

    <div class="apx-cmp__scroll" tabindex="0" role="region" aria-label="{{ 'ap.comparison.region' | t }}">
      <table class="apx-cmp__table">
        <caption class="apx-sr">{{ 'ap.comparison.caption' | t: brand: settings.brand_name }}</caption>
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="apx-cmp__us">{{ settings.brand_name }}</th>
            <th scope="col">{{ other_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              {%- if block.type == 'price_per_patch' -%}
                <th scope="row">{{ 'ap.comparison.price_per_patch' | t }}</th>
                <td class="apx-cmp__us">
                  {%- if cmp_count > 0 -%}
                    {{ cmp_variant.price | times: 1.0 | divided_by: cmp_count | round | money }}
                  {%- else -%}
                    <span class="apx-fine">{{ 'ap.comparison.set_metafield' | t }}</span>
                  {%- endif -%}
                </td>
                <td>{{ block.settings.other_value }}</td>
              {%- else -%}
                <th scope="row">{{ block.settings.feature }}</th>
                {%- assign us = block.settings.brand_value | strip -%}
                {%- assign them = block.settings.other_value | strip -%}
                <td class="apx-cmp__us">
                  {%- if us == 'yes' -%}{% render 'ap-icon', name: 'check', size: 22 %}<span class="apx-sr">{{ 'ap.comparison.yes' | t }}</span>
                  {%- elsif us == 'no' -%}{% render 'ap-icon', name: 'x', size: 22 %}<span class="apx-sr">{{ 'ap.comparison.no' | t }}</span>
                  {%- else -%}{{ us }}{%- endif -%}
                </td>
                <td>
                  {%- if them == 'yes' -%}{% render 'ap-icon', name: 'check', size: 22 %}<span class="apx-sr">{{ 'ap.comparison.yes' | t }}</span>
                  {%- elsif them == 'no' -%}{% render 'ap-icon', name: 'x', size: 22 %}<span class="apx-sr">{{ 'ap.comparison.no' | t }}</span>
                  {%- else -%}{{ them }}{%- endif -%}
                </td>
              {%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    <p class="apx-center apx-fine">{{ 'ap.comparison.footnote' | t }}</p>
  </div>
</section>

{% stylesheet %}
  .apx-cmp__scroll{margin-top:28px;overflow-x:auto}
  .apx-cmp__table{width:100%;min-width:480px;max-width:860px;margin-inline:auto;border-collapse:separate;border-spacing:0;border:1px solid var(--ap-line);border-radius:var(--ap-radius);overflow:hidden}
  .apx-cmp__table th,.apx-cmp__table td{padding:14px 16px;text-align:left;vertical-align:middle;border-top:1px solid var(--ap-line)}
  .apx-cmp__table thead th,.apx-cmp__table thead td{border-top:0;background:var(--ap-sand);font-family:var(--ap-font-display)}
  .apx-cmp__table tbody th{font-weight:600}
  .apx-cmp__us{background:#FBEDEF;font-weight:700}
  .apx-cmp__table thead .apx-cmp__us{background:var(--ap-blush-deep);color:var(--ap-white)}
  .apx-cmp__us .apx-icon{color:var(--ap-blush-deep)}
{% endstylesheet %}

{% schema %}
{
  "name": "Comparison",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Every cell must be factual and substantiated. Do not name competitors or use their trademarks. Type yes or no in a cell to show a check or a cross."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave blank for \"BRAND vs typical single-type patches\"." },
    { "type": "text", "id": "other_label", "label": "Other column label", "default": "Typical single-type patches" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Day and night formats in one kit" },
        { "type": "text", "id": "brand_value", "label": "Our value", "default": "yes" },
        { "type": "text", "id": "other_value", "label": "Other value", "default": "Varies" }
      ]
    },
    {
      "type": "price_per_patch",
      "name": "Price per patch (automatic)",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "other_value", "label": "Other value", "default": "Varies" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Day and night formats in one kit", "brand_value": "yes", "other_value": "Varies" } },
        { "type": "row", "settings": { "feature": "Several sizes in one kit", "brand_value": "yes", "other_value": "Varies" } },
        { "type": "row", "settings": { "feature": "Refill pouch available", "brand_value": "yes", "other_value": "Varies" } },
        { "type": "row", "settings": { "feature": "Subscribe and save", "brand_value": "yes", "other_value": "Varies" } },
        { "type": "price_per_patch", "settings": { "other_value": "Varies" } }
      ]
    }
  ]
}
{% endschema %}
