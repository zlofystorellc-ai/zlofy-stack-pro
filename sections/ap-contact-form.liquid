{%- comment -%}
  Contact page: a simple message form that goes to your store's email (Shopify's own contact form), plus the support email and a
  "write in Gmail" link for people who prefer email. Works for every visitor, even without an email app on their device.
  Create a page in Shopify admin (for example "Contact") and pick the page.contact template.
  The form sends to the store's customer email (Settings > Notifications > Sender email).
{%- endcomment -%}
<section class="apx-cf apx-section" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap apx-cf__wrap">
    <div class="apx-cf__head">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="apx-cf__card">
      {%- form 'contact', class: 'apx-cf__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="apx-cf__ok" role="status">{{ section.settings.success_text }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="apx-cf__err" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="apx-cf__row">
          <label class="apx-cf__f"><span>{{ section.settings.name_label }}</span>
            <input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
          <label class="apx-cf__f"><span>{{ section.settings.email_label }}</span>
            <input type="email" name="contact[email]" autocomplete="email" inputmode="email" required value="{{ form.email }}"></label>
        </div>
        <label class="apx-cf__f"><span>{{ section.settings.order_label }}</span>
          <input type="text" name="contact[Order number]" autocomplete="off"></label>
        <label class="apx-cf__f"><span>{{ section.settings.message_label }}</span>
          <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea></label>
        <button type="submit" class="apx-cf__btn">{{ section.settings.button_label }}</button>
      {%- endform -%}
      {%- if settings.support_email != blank -%}
        <p class="apx-cf__alt">
          {{ section.settings.alt_text }}
          <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>
          <span aria-hidden="true">·</span>
          <a href="https://mail.google.com/mail/?view=cm&fs=1&to={{ settings.support_email | url_encode }}" target="_blank" rel="noopener">{{ section.settings.gmail_label }}</a>
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .apx-cf{background:linear-gradient(180deg,#FBF7F5,#F5E6E8)}
  .apx-cf__wrap{max-width:760px}
  .apx-cf__head{text-align:center}
  .apx-cf__card{margin-top:clamp(24px,4vw,40px);padding:clamp(20px,4vw,36px);border:1px solid var(--ap-line);border-radius:24px;background:#fff;box-shadow:0 20px 44px rgba(59,10,20,.09)}
  .apx-cf__form{display:grid;gap:16px}
  .apx-cf__row{display:grid;gap:16px}
  .apx-cf__f{display:grid;gap:6px;font-size:.875rem;font-weight:700;color:var(--ap-ink)}
  .apx-cf__f input,.apx-cf__f textarea{width:100%;padding:13px 16px;border:1.5px solid var(--ap-line);border-radius:14px;background:#FBF7F5;color:var(--ap-ink);font:inherit;font-size:1rem;font-weight:400;transition:border-color .2s,box-shadow .2s}
  .apx-cf__f textarea{min-height:150px;resize:vertical}
  .apx-cf__f input:focus-visible,.apx-cf__f textarea:focus-visible{outline:none;border-color:var(--ap-ink);box-shadow:0 0 0 3px rgba(110,20,35,.18)}
  .apx-cf__btn{min-height:54px;border:0;border-radius:999px;background:var(--ap-blush-deep);color:#fff;font:inherit;font-size:1rem;font-weight:800;cursor:pointer;box-shadow:0 14px 28px rgba(59,10,20,.28);transition:transform .2s,box-shadow .2s}
  .apx-cf__btn:hover{transform:translateY(-2px);box-shadow:0 20px 36px rgba(59,10,20,.34)}
  .apx-cf__btn:focus-visible{outline:3px solid var(--ap-ink);outline-offset:3px}
  .apx-cf__ok{margin:0;padding:14px 16px;border-radius:14px;background:#EAF4EC;color:#1F4D2B;font-weight:600}
  .apx-cf__err{margin:0;padding:14px 16px;border-radius:14px;background:#FCE8E8;color:#7A1426;font-weight:600}
  .apx-cf__alt{margin:20px 0 0;padding-top:18px;border-top:1px solid var(--ap-line);text-align:center;font-size:.9375rem;color:var(--ap-ink-soft)}
  .apx-cf__alt a{color:var(--ap-blush-deep);font-weight:700}
  @media (min-width:640px){.apx-cf__row{grid-template-columns:1fr 1fr}}
  @media (prefers-reduced-motion:reduce){.apx-cf__btn{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Questions about your order or the patches? Write to us and we will get back to you." },
    { "type": "text", "id": "name_label", "label": "Name field", "default": "Name" },
    { "type": "text", "id": "email_label", "label": "Email field", "default": "Email" },
    { "type": "text", "id": "order_label", "label": "Order number field (optional for the visitor)", "default": "Order number (optional)" },
    { "type": "text", "id": "message_label", "label": "Message field", "default": "How can we help?" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send message" },
    { "type": "text", "id": "success_text", "label": "Message after sending", "default": "Thanks, your message has been sent. We will get back to you." },
    { "type": "text", "id": "alt_text", "label": "Line under the form", "default": "Prefer email?" },
    { "type": "text", "id": "gmail_label", "label": "Gmail link text", "default": "Write in Gmail" }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
