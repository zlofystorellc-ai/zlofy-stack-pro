{%- comment -%}
  Split FAQ band: questions on a blush-red panel, image space on the right.
  The image area is intentionally EMPTY until you upload your own photo (Image setting).
  Upload only photos you own or have licensed. No FAQPage JSON-LD here: the main FAQ section already outputs it.
{%- endcomment -%}
<section class="apx-fs{% if section.settings.image == blank and section.settings.show_builtin_video == false %} apx-fs--noimg{% endif %}" id="faq" data-ap-hi-root aria-labelledby="{{ section.id }}-title">
  <div class="apx-fs__panel">
    <div class="apx-fs__inner">
      <h2 class="apx-fs__h" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      <div class="apx-fs__list">
        {%- for block in section.blocks -%}
          <details class="apx-fs__item" {% if forloop.first and section.settings.first_open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary><span>{{ block.settings.question }}</span><i class="apx-fs__pm" aria-hidden="true"></i></summary>
            <div class="apx-fs__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="apx-fs__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="apx-fs__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
    {%- elsif section.settings.show_builtin_video -%}
      <div class="apx-fs__side">
        <i class="apx-fs__blob apx-fs__blob--1" aria-hidden="true"></i><i class="apx-fs__blob apx-fs__blob--2" aria-hidden="true"></i>
        <figure class="apx-fs__vid" data-ap-hi>
          <video muted playsinline loop preload="none" poster="{{ 'ap-ingredient-video.jpg' | asset_url }}" aria-label="{{ section.settings.video_alt | escape }}" data-ap-hi-video>
            <source src="{{ 'ap-ingredient-video.mp4' | asset_url }}" type="video/mp4">
          </video>
          <button type="button" class="apx-fs__pause" data-ap-hi-pause aria-pressed="false" aria-label="{{ 'ap.ingredient.pause' | t }}">
            <svg class="apx-hi__i-pause" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
            <svg class="apx-hi__i-play" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 5l11 7-11 7z"/></svg>
          </button>
          {%- if section.settings.video_note != blank -%}<figcaption class="apx-fs__note">{{ section.settings.video_note }}</figcaption>{%- endif -%}
        </figure>
        {%- if section.settings.contact_title != blank -%}
          <div class="apx-fs__card">
            <p class="apx-fs__card-t">{{ section.settings.contact_title }}</p>
            {%- if section.settings.contact_text != blank -%}<p class="apx-fs__card-p">{{ section.settings.contact_text }}</p>{%- endif -%}
            {%- assign card_href = settings.contact_url -%}
            {%- if card_href == blank and settings.support_email != blank -%}{%- assign card_href = 'mailto:' | append: settings.support_email -%}{%- endif -%}
            {%- if card_href != blank and section.settings.contact_label != blank -%}
              <a class="apx-fs__card-a" href="{{ card_href }}">{{ section.settings.contact_label }}<span aria-hidden="true"> &rarr;</span></a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <script src="{{ 'ap-ingredient.js' | asset_url }}" type="module"></script>
    {%- elsif request.design_mode -%}
      <div class="apx-fs__empty">Image space: upload a photo in this section's settings</div>
    {%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | strip_html | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | json }} }
        }{% unless forloop.last %}, {% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% stylesheet %}
  .apx-fs{display:grid;background:var(--ap-blush-deep);color:var(--ap-white)}
  .apx-fs__panel{padding:56px 0}
  .apx-fs__inner{max-width:600px;margin-inline:auto;padding-inline:var(--ap-gutter,20px)}
  .apx-fs__h{margin:0 0 40px;color:inherit;font-size:clamp(2.25rem,5vw,3.5rem);font-weight:800;line-height:1.05}
  .apx-fs__item{border-top:1px solid rgba(255,255,255,.6)}
  .apx-fs__item:last-child{border-bottom:1px solid rgba(255,255,255,.6)}
  .apx-fs__item summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:64px;padding:14px 0;font-weight:600;font-size:1.0625rem;cursor:pointer;list-style:none}
  .apx-fs__item summary::-webkit-details-marker{display:none}
  .apx-fs__item summary:focus-visible,.apx-fs__btn:focus-visible{outline:3px solid var(--ap-white);outline-offset:3px}
  .apx-fs__pm{position:relative;flex:none;width:16px;height:16px}
  .apx-fs__pm::before,.apx-fs__pm::after{content:"";position:absolute;left:0;top:7px;width:16px;height:2px;background:currentColor}
  .apx-fs__pm::after{transform:rotate(90deg);transition:transform .2s}
  .apx-fs__item[open] .apx-fs__pm::after{transform:rotate(0)}
  .apx-fs__a{padding:0 0 20px;line-height:1.6}
  .apx-fs__a p{margin:0 0 .75rem}
  .apx-fs__a p:last-child{margin-bottom:0}
  .apx-fs__btn{display:inline-flex;align-items:center;margin-top:28px;min-height:52px;padding:0 2rem;border-radius:999px;background:var(--ap-ink);color:var(--ap-white);font-weight:700;letter-spacing:.02em;text-transform:uppercase;text-decoration:none}
  .apx-fs__media{min-height:0;background:var(--ap-sand)}
  .apx-fs__media img{display:block;width:100%;height:100%;object-fit:cover}
  .apx-fs__empty{display:grid;place-items:center;min-height:320px;padding:24px;text-align:center;color:var(--ap-ink-soft)}
  @media (min-width:990px){
    .apx-fs{grid-template-columns:1fr 1fr;min-height:max(680px,51vw)}
    .apx-fs__panel{display:flex;align-items:center;padding:96px 0}
    .apx-fs__inner{margin-inline:auto 0;padding-inline:56px 48px}
  }
  @media (max-width:989px){.apx-fs--noimg .apx-fs__media{display:none}}

  /* built-in right side: soft panel with a framed close-up video and a "still have a question" card */
  .apx-fs__side{position:relative;display:grid;place-items:center;min-height:100%;padding:48px 24px 96px;overflow:hidden;background:linear-gradient(160deg,#FBF7F5,#F5E6E8 60%,#F2DADF)}
  .apx-fs__blob{position:absolute;border-radius:50%;filter:blur(60px);pointer-events:none}
  .apx-fs__blob--1{width:340px;height:340px;right:-90px;top:-80px;background:var(--ap-blush);opacity:.28}
  .apx-fs__blob--2{width:360px;height:360px;left:-120px;bottom:-110px;background:var(--ap-lilac);opacity:.5}
  .apx-fs__vid{position:relative;z-index:1;margin:0;width:min(100%,360px);aspect-ratio:4/5;overflow:hidden;border-radius:26px;background:#3B1220;box-shadow:0 0 0 7px rgba(255,255,255,.85),0 0 0 8px rgba(110,20,35,.25),0 32px 64px rgba(59,10,20,.28)}
  .apx-fs__vid video{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 52%}
  .apx-fs__pause{position:absolute;right:12px;top:12px;z-index:2;display:grid;place-items:center;width:40px;height:40px;padding:0;border:1.5px solid rgba(255,255,255,.55);border-radius:50%;background:rgba(42,8,16,.6);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:#fff;cursor:pointer}
  .apx-fs__pause:focus-visible{outline:3px solid #fff;outline-offset:3px}
  .apx-fs__pause .apx-hi__i-play{display:none}
  .apx-fs__pause[aria-pressed="true"] .apx-hi__i-pause{display:none}
  .apx-fs__pause[aria-pressed="true"] .apx-hi__i-play{display:block}
  .apx-fs__note{position:absolute;left:12px;top:18px;padding:.22rem .6rem;border-radius:6px;background:rgba(42,8,16,.6);color:#F5E6E8;font-size:.6875rem;letter-spacing:.04em}
  .apx-fs__card{position:absolute;z-index:2;left:50%;bottom:28px;transform:translateX(-50%);width:min(calc(100% - 48px),360px);padding:16px 18px;border:1px solid var(--ap-line);border-radius:18px;background:#fff;color:var(--ap-ink);box-shadow:0 18px 40px rgba(59,10,20,.18)}
  .apx-fs__card-t{margin:0;font-family:var(--ap-font-display);font-size:1.25rem}
  .apx-fs__card-p{margin:4px 0 0;font-size:.875rem;line-height:1.5;color:var(--ap-ink-soft)}
  .apx-fs__card-a{display:inline-block;margin-top:10px;color:var(--ap-blush-deep);font-size:.875rem;font-weight:700;text-decoration:none;border-bottom:2px solid currentColor}
  .apx-fs__card-a:focus-visible{outline:3px solid var(--ap-ink);outline-offset:3px}
  @media (max-width:989px){.apx-fs__side{padding:40px 20px 100px}}
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ with image",
  "tag": "div",
  "enabled_on": { "templates": ["product", "index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs" },
    { "type": "checkbox", "id": "first_open", "label": "Open the first question", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore all FAQs" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Replaces the built-in video panel. Upload only photos you own or have licensed." },
    { "type": "checkbox", "id": "show_builtin_video", "label": "Show the built-in close-up video panel", "default": true, "info": "A short AI-generated close-up of a thin patch on skin (muted, loops, can be paused). It is an illustration, not a real customer." },
    { "type": "text", "id": "video_note", "label": "Note on the video", "default": "AI-generated illustration" },
    { "type": "text", "id": "video_alt", "label": "Video description", "default": "A close-up of a thin, clear round patch resting on skin" },
    { "type": "text", "id": "contact_title", "label": "Contact card title", "default": "Still have a question?" },
    { "type": "text", "id": "contact_text", "label": "Contact card text", "default": "Send us a message and we will get back to you." },
    { "type": "text", "id": "contact_label", "label": "Contact card link text", "default": "Send us a message", "info": "Goes to the contact page address in Theme settings, or to the support email if that is empty." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long do I wear a patch?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Describe the answer in your own words.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ with image",
      "blocks": [
        { "type": "question", "settings": { "question": "What are Zlofy Day and Night patches?", "answer": "<p>A day and night set of drug-free hydrocolloid patches. Day patches are thin and low-shine, night patches are thicker and more cushioned. Both cover and protect surfaced spots.</p>" } },
        { "type": "question", "settings": { "question": "How long do I wear a patch?", "answer": "<p>Leave a patch on for 6–8 hours, or until it turns white. Change it sooner if the edges lift.</p>" } },
        { "type": "question", "settings": { "question": "Can I wear makeup over the day patch?", "answer": "<p>You can try it: press the patch flat, then dab a thin layer of your usual product around the edges. Avoid rubbing, which can lift the patch.</p>" } },
        { "type": "question", "settings": { "question": "Does it work on deep or cystic bumps?", "answer": "<p>No. These patches are made for surfaced spots, the kind with a visible head. They are not designed for deep, under-the-skin bumps. If a breakout is painful, large or keeps coming back, see a dermatologist.</p>" } },
        { "type": "question", "settings": { "question": "Is it okay for sensitive skin?", "answer": "<p>The patches are drug-free hydrocolloid with no active ingredients. Everyone's skin is different, so try one on a small area first. Stop using it if you notice irritation, and contact us.</p>" } },
        { "type": "question", "settings": { "question": "How long does shipping take?", "answer": "<p>The shipping time is shown on the product page and again at checkout. You will get a tracking email when your order ships.</p>" } },
        { "type": "question", "settings": { "question": "How do I skip or cancel a subscription?", "answer": "<p>You can skip, change the delivery frequency or cancel any time from your account page, or email us before your next delivery.</p>" } },
        { "type": "question", "settings": { "question": "What if I am not happy with my order?", "answer": "<p>Contact us within the guarantee window shown on this page and we will help. Full terms are in our refund policy.</p>" } }
      ]
    }
  ]
}
{% endschema %}
