{%- comment -%} Four feature cards with an icon, a short title and one cosmetic sentence. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="apx-fc apx-section apx-section--sand" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ul class="apx-fc__grid">
      {%- for block in section.blocks -%}
        <li class="apx-fc__card" {{ block.shopify_attributes }}>
          <span class="apx-fc__icon">{% render 'ap-icon', name: block.settings.icon, size: 26 %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-fc__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:28px}
  .apx-fc__card{padding:24px 22px;border-radius:var(--ap-radius);background:var(--ap-white)}
  .apx-fc__icon{display:grid;place-items:center;width:52px;height:52px;margin-bottom:14px;border-radius:50%;background:var(--ap-sand);color:var(--ap-blush-deep)}
  .apx-fc__card h3{margin:0 0 .35rem;font-size:1.125rem}
  .apx-fc__card p{margin:0;color:var(--ap-ink-soft)}
{% endstylesheet %}

{% schema %}
{
  "name": "Feature cards",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How the patch helps" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to cover and protect" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Four small details that make the kit easy to live with." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "clock", "label": "Clock" },
            { "value": "sun", "label": "Sun" },
            { "value": "moon", "label": "Moon" },
            { "value": "check", "label": "Check" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Covers" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A thin, drug-free patch that covers a surfaced spot." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature cards",
      "blocks": [
        { "type": "card", "settings": { "icon": "shield", "title": "Covers the spot", "text": "A thin, drug-free patch that sits over a surfaced spot." } },
        { "type": "card", "settings": { "icon": "hand", "title": "Less picking", "text": "A patch gives your fingers something else to find." } },
        { "type": "card", "settings": { "icon": "sun", "title": "Day patch", "text": "Thin and low-shine, so it sits close to the skin." } },
        { "type": "card", "settings": { "icon": "moon", "title": "Night patch", "text": "Thicker and cushioned, so it stays put while you sleep." } }
      ]
    }
  ]
}
{% endschema %}
