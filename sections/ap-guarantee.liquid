{%- comment -%} Guarantee. The text is a placeholder: it MUST match your real return/refund policy. {%- endcomment -%}
<section class="apx-guar apx-section" aria-labelledby="{{ section.id }}-title">
  <div class="apx-guar__wrap">
    <span class="apx-guar__icon" aria-hidden="true">{% render 'ap-icon', name: 'shield', size: 44 %}</span>
    {%- if section.settings.eyebrow != blank -%}<p class="apx-guar__pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="apx-guar__h" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="apx-guar__sub">{{ section.settings.subheading }}</p>{%- endif -%}

    <div class="apx-guar__card">
      <p class="apx-guar__big"><span class="apx-guar__num">{{ section.settings.number }}</span><span class="apx-guar__unit">{{ section.settings.unit }}</span></p>
      {%- if section.settings.card_label != blank -%}<p class="apx-guar__label">{{ section.settings.card_label }}</p>{%- endif -%}
      <p class="apx-guar__text">{{ section.settings.text }}</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="apx-guar__chips">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.policy_link != blank -%}
      <p><a class="apx-guar__link" href="{{ section.settings.policy_link }}">{{ 'ap.guarantee.policy' | t }}</a></p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .apx-guar{padding-block:clamp(64px,9vw,140px);background:linear-gradient(180deg,#FFF6CF,#FFF3BC);color:var(--ap-ink)}
  .apx-guar__wrap{display:flex;flex-direction:column;align-items:center;max-width:760px;margin-inline:auto;padding-inline:var(--ap-gutter);text-align:center}
  .apx-guar__icon{position:relative;display:grid;place-items:center;width:84px;height:84px;border-radius:50%;background:var(--ap-white);color:var(--ap-accent-text);box-shadow:0 10px 24px rgba(207,39,73,.18)}
  .apx-guar__icon::after{content:"";position:absolute;inset:0;border-radius:50%;border:2px solid var(--ap-accent);animation:apx-ring 3.2s ease-out infinite;pointer-events:none}
  .apx-guar__pill{margin:20px 0 0;padding:.6rem 1.5rem;border-radius:999px;background:var(--ap-dark);color:var(--ap-butter);font-size:.8125rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .apx-guar__h{margin:24px 0 0;color:var(--ap-accent-text);font-size:clamp(2.75rem,6vw,4.25rem);font-weight:500;line-height:1.05}
  .apx-guar__sub{margin:12px 0 0;color:var(--ap-ink);font-size:clamp(1.25rem,2.4vw,1.75rem)}
  .apx-guar__card{width:100%;margin-top:clamp(32px,4vw,48px);padding:clamp(24px,4vw,40px);border:1px solid var(--ap-line);border-radius:28px;background:var(--ap-white);text-align:left}
  .apx-guar__big{display:flex;align-items:baseline;gap:.6rem;margin:0;color:var(--ap-accent-text)}
  .apx-guar__num{font-family:var(--ap-font-display);font-size:clamp(4rem,9vw,6.5rem);font-weight:500;line-height:1}
  .apx-guar__unit{font-size:1.125rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .apx-guar__label{margin:16px 0 0;color:var(--ap-accent-text);font-size:.8125rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
  .apx-guar__text{margin:20px 0 0;color:var(--ap-ink-soft);font-size:1.0625rem;line-height:1.6}
  .apx-guar__chips{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin:32px 0 0;padding:0;list-style:none}
  .apx-guar__chips li{display:inline-flex;align-items:center;gap:.6rem;min-height:48px;padding:0 1.25rem;border:1px solid var(--ap-line);border-radius:999px;background:var(--ap-white);color:var(--ap-accent-text);font-size:.8125rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .apx-guar__chips li::before{content:"";width:7px;height:7px;background:var(--ap-apricot);transform:rotate(45deg)}
  .apx-guar__link{display:inline-flex;align-items:center;min-height:44px;margin-top:12px;color:var(--ap-accent-text)}
{% endstylesheet %}

{% schema %}
{
  "name": "Guarantee",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "This is placeholder wording. It must match your real return and refund policy." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Risk-free" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Try it, and if it is not for you, tell us." },
    { "type": "text", "id": "card_label", "label": "Card label", "default": "Guarantee" },
    { "type": "text", "id": "number", "label": "Big number", "default": "30" },
    { "type": "text", "id": "unit", "label": "Unit", "default": "day" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Try the patches. If they are not for you, contact us within 30 days and we will help."
    },
    { "type": "url", "id": "policy_link", "label": "Refund policy link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Chip",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Easy refunds" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee",
      "blocks": [
        { "type": "point", "settings": { "text": "30-day guarantee" } },
        { "type": "point", "settings": { "text": "Cancel anytime" } },
        { "type": "point", "settings": { "text": "Support by email" } }
      ]
    }
  ]
}
{% endschema %}
