{%- comment -%}
  Home page banner: big benefit headline, two buttons, three small trust points, and a visual on the right.
  The visual is your own photo when you add one (Image setting); until then a drawn patch illustration fills the space,
  so the banner never looks empty. Upload only photos you own or have licensed.
  Cosmetic wording only; keep every line true for your product.
{%- endcomment -%}
<section class="apx-hh" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap apx-hh__grid">
    <div class="apx-hh__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-hh__pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="apx-hh__h" id="{{ section.id }}-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="apx-hh__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="apx-hh__cta">
        {%- if section.settings.button_label != blank -%}
          <a class="apx-btn apx-hh__btn" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="apx-hh__link" href="{{ section.settings.button2_link | default: '#how' }}">{{ section.settings.button2_label }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="apx-hh__perks">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'ap-icon', name: 'check', size: 18 %}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="apx-hh__visual">
      {%- if section.settings.image != blank -%}
        <div class="apx-hh__photo">
          {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '550, 800, 1100', sizes: '(min-width: 990px) 46vw, 92vw', alt: section.settings.image.alt | default: section.settings.heading }}
        </div>
      {%- else -%}
        <div class="apx-hh__art" aria-hidden="true">
          <span class="apx-hh__patch"></span>
          <span class="apx-hh__half"></span>
          <span class="apx-hh__mini apx-hh__mini--a"></span>
          <span class="apx-hh__mini apx-hh__mini--b"></span>
          <span class="apx-hh__mini apx-hh__mini--c"></span>
        </div>
      {%- endif -%}
      {%- if section.settings.badge1 != blank -%}<span class="apx-hh__badge apx-hh__badge--1">{% render 'ap-icon', name: 'sun', size: 18 %}{{ section.settings.badge1 }}</span>{%- endif -%}
      {%- if section.settings.badge2 != blank -%}<span class="apx-hh__badge apx-hh__badge--2">{% render 'ap-icon', name: 'moon', size: 18 %}{{ section.settings.badge2 }}</span>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .apx-hh{position:relative;isolation:isolate;overflow-x:clip;padding-block:clamp(36px,6vw,88px);background:linear-gradient(180deg,var(--ap-sand),var(--ap-white))}
  .apx-hh::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(560px 380px at 8% 12%,rgba(249,93,117,.2),transparent 70%),radial-gradient(520px 360px at 92% 8%,rgba(205,184,255,.34),transparent 70%),radial-gradient(460px 320px at 75% 95%,rgba(255,224,102,.26),transparent 70%);animation:apx-drift 16s ease-in-out infinite alternate}
  .apx-hh__grid{display:grid;gap:clamp(28px,5vw,64px);align-items:center}
  .apx-hh__pill{display:inline-block;margin:0 0 18px;padding:.45rem 1rem;border:1.5px solid var(--ap-blush-deep);border-radius:999px;background:var(--ap-white);color:var(--ap-blush-deep);font-size:.8125rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .apx-hh__h{margin:0;font-size:clamp(2.75rem,8vw,5.25rem);line-height:1.02;letter-spacing:-.02em}
  .apx-hh__text{max-width:34em;margin:20px 0 0;font-size:clamp(1.0625rem,2vw,1.3125rem);line-height:1.55;color:var(--ap-ink-soft)}
  .apx-hh__cta{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;margin-top:28px}
  .apx-hh__btn{min-height:56px;padding-inline:2rem;font-size:1.0625rem}
  .apx-hh__link{display:inline-flex;align-items:center;gap:.4rem;min-height:48px;color:var(--ap-ink);font-weight:700;text-decoration:none;border-bottom:2px solid var(--ap-blush)}
  .apx-hh__link:hover{color:var(--ap-blush-deep)}
  .apx-hh__perks{display:flex;flex-wrap:wrap;gap:10px 22px;margin:28px 0 0;padding:0;list-style:none}
  .apx-hh__perks li{display:inline-flex;align-items:center;gap:.5rem;font-size:.9375rem;font-weight:600}
  .apx-hh__perks .apx-icon{color:var(--ap-blush-deep)}
  .apx-hh__visual{position:relative;width:100%;max-width:560px;margin-inline:auto}
  .apx-hh__photo{overflow:hidden;aspect-ratio:4/5;border-radius:48% 48% 28px 28px / 36% 36% 28px 28px;background:var(--ap-sand);box-shadow:0 30px 60px rgba(31,31,58,.18)}
  .apx-hh__photo img{display:block;width:100%;height:100%;object-fit:cover}
  .apx-hh__art{position:relative;aspect-ratio:1}
  .apx-hh__patch{position:absolute;inset:9%;border-radius:50%;background:linear-gradient(145deg,var(--ap-blush),var(--ap-blush-deep));box-shadow:inset 0 0 0 4px rgba(255,255,255,.42),0 40px 70px rgba(207,39,73,.3);animation:apx-float 7s ease-in-out infinite}
  .apx-hh__patch::before{content:"";position:absolute;left:14%;top:12%;width:46%;height:46%;border:6px solid rgba(255,255,255,.6);border-right-color:transparent;border-bottom-color:transparent;border-radius:50%;transform:rotate(-12deg)}
  .apx-hh__patch::after{content:"";position:absolute;left:50%;top:54%;width:11%;height:11%;margin:-5.5%;border-radius:50%;background:rgba(255,255,255,.92)}
  .apx-hh__half{position:absolute;left:2%;bottom:8%;width:27%;aspect-ratio:1;border-radius:50%;background:linear-gradient(90deg,var(--ap-butter) 50%,var(--ap-ink) 50%);box-shadow:0 0 0 4px var(--ap-white),0 18px 34px rgba(31,31,58,.25);animation:apx-float 6s -2s ease-in-out infinite}
  .apx-hh__mini{position:absolute;border-radius:50%;background:var(--ap-lilac);box-shadow:inset 0 0 0 3px rgba(255,255,255,.55);animation:apx-float 5s ease-in-out infinite}
  .apx-hh__mini--a{right:3%;top:10%;width:15%;aspect-ratio:1}
  .apx-hh__mini--b{right:12%;bottom:6%;width:11%;aspect-ratio:1;background:var(--ap-apricot);animation-delay:-1.5s}
  .apx-hh__mini--c{left:8%;top:18%;width:8%;aspect-ratio:1;background:var(--ap-butter);animation-delay:-3s}
  .apx-hh__badge{position:absolute;display:inline-flex;align-items:center;gap:.45rem;padding:.6rem 1.1rem;border-radius:999px;background:var(--ap-white);color:var(--ap-ink);font-size:.9375rem;font-weight:800;box-shadow:0 14px 30px rgba(31,31,58,.18)}
  .apx-hh__badge .apx-icon{color:var(--ap-blush-deep)}
  .apx-hh__badge--1{left:-2%;top:14%;animation:apx-float 6s ease-in-out infinite}
  .apx-hh__badge--2{right:-2%;bottom:18%;animation:apx-float 6.5s -3s ease-in-out infinite}
  @keyframes apx-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
  @media (min-width:990px){.apx-hh__grid{grid-template-columns:minmax(0,6fr) minmax(0,5fr)}}
  @media (max-width:560px){.apx-hh__badge--1{left:0}.apx-hh__badge--2{right:0}}
{% endstylesheet %}

{% schema %}
{
  "name": "Home banner",
  "tag": "div",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "paragraph", "content": "Editor note: until you add a photo, a drawn patch illustration is shown. Upload only photos you own or have licensed." },
    { "type": "text", "id": "eyebrow", "label": "Pill label", "default": "Drug-free hydrocolloid patches" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cover the spot. Keep your day." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thin day patches for school and work. Cushioned night patches for sleep. One kit, a patch for every moment." },
    { "type": "text", "id": "button_label", "label": "Main button", "default": "Shop the kit" },
    { "type": "url", "id": "button_link", "label": "Main button link", "info": "Leave empty to open all products." },
    { "type": "text", "id": "button2_label", "label": "Second link", "default": "How it works" },
    { "type": "url", "id": "button2_link", "label": "Second link target", "info": "Leave empty to scroll to the how-to section." },
    { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
    { "type": "text", "id": "badge1", "label": "Badge 1", "default": "Day patch" },
    { "type": "text", "id": "badge2", "label": "Badge 2", "default": "Night patch" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Trust point",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Drug-free hydrocolloid" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home banner",
      "blocks": [
        { "type": "perk", "settings": { "text": "Drug-free hydrocolloid" } },
        { "type": "perk", "settings": { "text": "Day and night patches" } },
        { "type": "perk", "settings": { "text": "US-based support" } }
      ]
    }
  ]
}
{% endschema %}
