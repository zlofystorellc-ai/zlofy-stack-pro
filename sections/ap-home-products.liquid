{%- comment -%}
  Home page product cards. One product card (this is a one-product store): it shows the photo, name, price and a button.
  Cards for products that are not picked, or are unavailable, are skipped.
{%- endcomment -%}
{%- assign shown = 0 -%}
{%- for block in section.blocks -%}{%- if block.settings.product != blank -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- assign fallback = collections.all.products.first -%}
{%- if shown == 0 and fallback != blank and section.blocks.size > 0 -%}{%- assign shown = 1 -%}{%- endif -%}
{%- if shown > 0 -%}
<section class="apx-hp apx-section{% if shown == 1 %} apx-hp--single{% endif %}" id="shop" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if shown == 1 -%}
      {%- assign sp = fallback -%}
      {%- assign sb = section.blocks.first -%}
      {%- if sb.settings.product != blank -%}{%- assign sp = sb.settings.product -%}{%- endif -%}
      {%- assign sv = sp.selected_or_first_available_variant | default: sp.variants.first -%}
      <div class="apx-hk" {{ sb.shopify_attributes }}>
        <a class="apx-hk__media" href="{{ sp.url }}" aria-label="{{ sp.title | escape }}">
          {%- if sb.settings.badge != blank -%}<span class="apx-hk__badge">{{ sb.settings.badge }}</span>{%- endif -%}
          {%- if sp.featured_image != blank -%}
            {{ sp.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 40vw, 90vw', alt: sp.featured_image.alt | default: sp.title }}
          {%- endif -%}
          {%- if section.settings.caption != blank -%}<span class="apx-hk__cap">{{ section.settings.caption }}</span>{%- endif -%}
        </a>
        <div class="apx-hk__info">
          {%- if section.settings.meta != blank -%}<p class="apx-hk__meta">{{ section.settings.meta }}</p>{%- endif -%}
          <h3 class="apx-hk__title"><a href="{{ sp.url }}">{{ sp.title }}</a></h3>
          {%- if section.settings.desc != blank -%}<p class="apx-hk__desc">{{ section.settings.desc }}</p>{%- endif -%}

          <ul class="apx-hk__trust">
            {%- for n in (1..4) -%}
              {%- assign tk = 'trust_' | append: n | append: '_title' -%}
              {%- assign xk = 'trust_' | append: n | append: '_text' -%}
              {%- if section.settings[tk] != blank -%}
                <li>
                  <span class="apx-hk__ti" aria-hidden="true">{%- case n -%}{%- when 1 -%}{% render 'ap-icon', name: 'sun', size: 20 %}{%- when 2 -%}{% render 'ap-icon', name: 'hand', size: 20 %}{%- when 3 -%}{% render 'ap-icon', name: 'mail', size: 20 %}{%- else -%}{% render 'ap-icon', name: 'leaf', size: 20 %}{%- endcase -%}</span>
                  <span><b>{{ section.settings[tk] }}</b>{%- if section.settings[xk] != blank -%}<em>{{ section.settings[xk] }}</em>{%- endif -%}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          <p class="apx-hk__step">{{ section.settings.step2 }}</p>
          <ul class="apx-hk__plans">
            <li><a class="apx-hk__plan is-on" href="{{ sp.url }}"><i aria-hidden="true"></i><span><b>One-time purchase</b><em>Standard single-order dispatch</em></span><strong>{{ sv.price | money }}</strong></a></li>
            {%- if sv.selling_plan_allocations.size > 0 -%}
              <li><a class="apx-hk__plan" href="{{ sp.url }}"><i aria-hidden="true"></i><span><b>Subscribe &amp; save</b><em>Choose your delivery plan on the next page</em></span><strong>&rarr;</strong></a></li>
            {%- endif -%}
          </ul>

          <a class="apx-hk__btn" href="{{ sp.url }}">{{ section.settings.button_label }}<span aria-hidden="true">&rarr;</span><span class="apx-sr"> {{ sp.title }}</span></a>
          {%- if section.settings.footnote != blank -%}<p class="apx-hk__foot">{{ section.settings.footnote }}</p>{%- endif -%}
        </div>
      </div>
    {%- else -%}
    <ul class="apx-hp__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <li class="apx-hp__card" {{ block.shopify_attributes }}>
            <a class="apx-hp__link" href="{{ p.url }}">
              <span class="apx-hp__img">
                {%- if block.settings.badge != blank -%}<span class="apx-hp__badge">{{ block.settings.badge }}</span>{%- endif -%}
                {%- if p.featured_image != blank -%}
                  {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', sizes: '(min-width: 990px) 22vw, (min-width: 600px) 44vw, 90vw', alt: p.featured_image.alt | default: p.title }}
                {%- endif -%}
              </span>
              <span class="apx-hp__body">
                <span class="apx-hp__title">{{ p.title }}</span>
                {%- if block.settings.note != blank -%}<span class="apx-hp__note">{{ block.settings.note }}</span>{%- endif -%}
                <span class="apx-hp__price">
                  {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {% endif -%}
                  {{ p.price | money }}
                </span>
              </span>
            </a>
            <a class="apx-btn apx-hp__btn" href="{{ p.url }}">{{ section.settings.button_label }}<span class="apx-sr"> {{ p.title }}</span></a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
    {%- if section.settings.all_label != blank -%}
      <p class="apx-center apx-hp__all"><a href="{{ section.settings.all_link | default: '/collections/all' }}">{{ section.settings.all_label }} <span aria-hidden="true">&rarr;</span></a></p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-hp__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px;margin:clamp(28px,4vw,48px) 0 0;padding:0;list-style:none}
  .apx-hp__card{display:flex;flex-direction:column;gap:14px;padding:12px 12px 18px;border:1px solid var(--ap-line);border-radius:28px;background:var(--ap-white);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s}
  .apx-hp__link{display:block;color:inherit;text-decoration:none}
  .apx-hp__img{position:relative;display:block;overflow:hidden;aspect-ratio:1;border-radius:20px;background:var(--ap-sand)}
  .apx-hp__img img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .apx-hp__badge{position:absolute;left:12px;top:12px;z-index:1;padding:.3rem .8rem;border-radius:999px;background:var(--ap-ink);color:var(--ap-butter);font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .apx-hp__body{display:grid;gap:4px;padding:14px 8px 0}
  .apx-hp__title{font-family:var(--ap-font-display);font-size:1.5rem;line-height:1.15}
  .apx-hp__note{color:var(--ap-ink-soft);font-size:.9375rem}
  .apx-hp__price{font-size:1.125rem;font-weight:800;color:var(--ap-blush-deep)}
  .apx-hp__price s{margin-right:.3rem;font-weight:500;color:var(--ap-ink-soft)}
  .apx-hp__btn{margin:auto 8px 0;width:calc(100% - 16px)}
  .apx-hp--single .apx-hp__grid{grid-template-columns:minmax(0,1fr);max-width:420px;margin-inline:auto}
  @media (min-width:760px){
    .apx-hp--single .apx-hp__grid{max-width:900px}
    .apx-hp--single .apx-hp__card{display:grid;grid-template-columns:1fr 1fr;gap:0 40px;align-items:center;padding:18px}
    .apx-hp--single .apx-hp__link{display:contents}
    .apx-hp--single .apx-hp__img{grid-row:1 / span 2;border-radius:24px}
    .apx-hp--single .apx-hp__body{align-self:end;padding:0}
    .apx-hp--single .apx-hp__title{font-size:clamp(1.75rem,3vw,2.5rem)}
    .apx-hp--single .apx-hp__price{font-size:1.5rem}
    .apx-hp--single .apx-hp__btn{align-self:start;margin:20px 0 0;width:auto;justify-self:start;min-width:220px}
  }
  /* one-product "Shop the kit" panel: everything links to the product page */
  .apx-hk{display:grid;gap:24px;margin:clamp(24px,4vw,44px) auto 0;max-width:1180px;padding:clamp(14px,2.4vw,28px);border:1px solid var(--ap-line);border-radius:clamp(24px,3vw,40px);background:#fff;box-shadow:0 30px 70px rgba(59,10,20,.08)}
  .apx-hk__media{position:relative;display:block;overflow:hidden;aspect-ratio:1;border-radius:26px;background:linear-gradient(160deg,#F6E7E8,#F0D9DC);color:inherit;text-decoration:none}
  .apx-hk__media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .apx-hk__badge{position:absolute;left:16px;top:16px;z-index:1;padding:.45rem .9rem;border-radius:999px;background:var(--ap-ink);color:#fff;font-size:.75rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .apx-hk__cap{position:absolute;left:0;right:0;bottom:0;padding:34px 16px 16px;background:linear-gradient(0deg,rgba(59,10,20,.55),transparent);color:#fff;text-align:center;font-size:.9375rem;font-weight:700}
  .apx-hk__info{display:flex;flex-direction:column;justify-content:center;min-width:0;padding:4px 4px 8px}
  .apx-hk__meta{margin:0 0 .6rem;font-size:.75rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--ap-ink-soft)}
  .apx-hk__title{margin:0;font-family:var(--ap-font-display);font-size:clamp(1.9rem,3.4vw,2.9rem);line-height:1.05}
  .apx-hk__title a{color:var(--ap-ink);text-decoration:none}
  .apx-hk__desc{margin:.7rem 0 0;font-size:1rem;line-height:1.6;color:var(--ap-ink-soft)}
  .apx-hk__step{margin:1.4rem 0 .6rem;font-size:.8125rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--ap-ink)}
  .apx-hk__plans{display:grid;gap:10px;margin:0;padding:0;list-style:none}
  .apx-hk__trust{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:1.4rem 0 0;padding:0;list-style:none}
  .apx-hk__trust li{display:flex;gap:12px;align-items:flex-start;padding:14px;border:1px solid var(--ap-line);border-radius:16px;background:linear-gradient(160deg,#FFFBFB,#FBF1F2)}
  .apx-hk__ti{flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#fff;color:var(--ap-blush-deep);box-shadow:0 4px 12px rgba(59,10,20,.08)}
  .apx-hk__trust b{display:block;font-size:.9375rem;line-height:1.25;color:var(--ap-ink)}
  .apx-hk__trust em{display:block;margin-top:3px;font-style:normal;font-size:.8125rem;line-height:1.4;color:var(--ap-ink-soft)}
  .apx-hk a.apx-hk__plan{display:grid;border:1.5px solid var(--ap-line);border-radius:16px;background:#fff;color:var(--ap-ink);text-decoration:none;transition:border-color .2s,box-shadow .2s,transform .2s}
  .apx-hk a.apx-hk__plan{grid-template-columns:auto 1fr auto;align-items:center;gap:14px;padding:16px}
  .apx-hk__plan i{width:20px;height:20px;border:2px solid var(--ap-line);border-radius:50%}
  .apx-hk__plan.is-on i{border:6px solid var(--ap-ink)}
  .apx-hk__plan b{display:block;font-size:1rem}
  .apx-hk__plan em{display:block;margin-top:2px;font-style:normal;font-size:.875rem;color:var(--ap-ink-soft)}
  .apx-hk__plan strong{font-family:var(--ap-font-display);font-size:1.5rem;font-weight:400}
  .apx-hk a.is-on{border-color:var(--ap-ink)}
  .apx-hk a.apx-hk__plan:hover{border-color:var(--ap-blush-deep);box-shadow:0 10px 24px rgba(59,10,20,.1);transform:translateY(-1px)}
  .apx-hk__btn{display:flex;align-items:center;justify-content:center;gap:10px;min-height:58px;margin-top:1.4rem;padding:0 24px;border-radius:999px;background:var(--ap-ink);color:#fff;font-size:1.0625rem;font-weight:800;text-decoration:none;box-shadow:0 16px 30px rgba(59,10,20,.28);transition:transform .2s,box-shadow .2s}
  .apx-hk__btn:hover{transform:translateY(-2px);box-shadow:0 22px 38px rgba(59,10,20,.34)}
  .apx-hk a:focus-visible{outline:3px solid var(--ap-blush-deep);outline-offset:3px}
  .apx-hk__foot{margin:.9rem 0 0;text-align:center;font-size:.875rem;color:var(--ap-ink-soft)}
  @media (max-width:420px){.apx-hk__trust{grid-template-columns:minmax(0,1fr)}}
  @media (min-width:900px){.apx-hk{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:44px;align-items:center;padding:clamp(28px,3vw,52px)}.apx-hk__media{aspect-ratio:1/1.02}}
  @media (hover:hover){.apx-hk__media:hover img{transform:scale(1.04)}}
  @media (prefers-reduced-motion:reduce){.apx-hk__btn,.apx-hk a.apx-hk__plan,.apx-hk__media img{transition:none}}
  .apx-hp__all{margin-top:28px}
  .apx-hp__all a{font-weight:800}
  @media (hover:hover){.apx-hp__card:hover{transform:translateY(-6px);box-shadow:0 22px 44px rgba(59,10,20,.12)}.apx-hp__card:hover .apx-hp__img img{transform:scale(1.06)}}
{% endstylesheet %}

{% schema %}
{
  "name": "Home products",
  "tag": "div",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the kit" },
    { "type": "textarea", "id": "text", "label": "Intro (optional)", "default": "Day and night patches in one kit." },
    { "type": "text", "id": "button_label", "label": "Card button", "default": "Shop the kit" },
    { "type": "header", "content": "Big product panel (one-product store)" },
    { "type": "text", "id": "caption", "label": "Caption on the photo", "default": "Day and night patches in one kit" },
    { "type": "text", "id": "meta", "label": "Small line above the title", "default": "Day patches + night patches" },
    { "type": "textarea", "id": "desc", "label": "Short description", "default": "Wear the 0.15 mm ultra-thin matte Day patch to school or work. Switch to the 0.35 mm cushioned Night patch before bed." },
    { "type": "text", "id": "step2", "label": "Purchase options title", "default": "Purchase option" },
    { "type": "header", "content": "Trust points (empty title hides one). Keep every point true for your store." },
    { "type": "text", "id": "trust_1_title", "label": "Point 1 title", "default": "Day and night, sorted" },
    { "type": "text", "id": "trust_1_text", "label": "Point 1 text", "default": "A thin patch for the day and a cushioned one for the night." },
    { "type": "text", "id": "trust_2_title", "label": "Point 2 title", "default": "Easy to use" },
    { "type": "text", "id": "trust_2_text", "label": "Point 2 text", "default": "Clean, press on, peel and swap." },
    { "type": "text", "id": "trust_3_title", "label": "Point 3 title", "default": "Real people to talk to" },
    { "type": "text", "id": "trust_3_text", "label": "Point 3 text", "default": "Write to contact@zlofy.com and we will get back to you." },
    { "type": "text", "id": "trust_4_title", "label": "Point 4 title", "default": "Ingredients in plain sight" },
    { "type": "text", "id": "trust_4_text", "label": "Point 4 text", "default": "The full ingredient list is shown on the product page." },
    { "type": "text", "id": "footnote", "label": "Line under the button", "default": "Free US shipping on orders $35+", "info": "Keep this true for your store." },
    { "type": "text", "id": "all_label", "label": "See-all link text (leave empty for a one-product store)", "default": "" },
    { "type": "url", "id": "all_link", "label": "See-all link", "info": "Leave empty to open all products." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 1,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "For example Most popular. Only if it is true." },
        { "type": "text", "id": "note", "label": "One-line note (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home products",
      "blocks": [ { "type": "product" } ]
    }
  ]
}
{% endschema %}
