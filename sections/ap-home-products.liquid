{%- comment -%}
  Home page product cards. Pick up to four products in the theme editor; each card shows the photo, name, price and a button.
  Cards for products that are not picked, or are unavailable, are skipped.
{%- endcomment -%}
{%- assign shown = 0 -%}
{%- for block in section.blocks -%}{%- if block.settings.product != blank -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if shown > 0 -%}
<section class="apx-hp apx-section" id="shop" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ul class="apx-hp__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <li class="apx-hp__card" {{ block.shopify_attributes }}>
            <a class="apx-hp__link" href="{{ p.url }}">
              <span class="apx-hp__img">
                {%- if block.settings.badge != blank -%}<span class="apx-hp__badge">{{ block.settings.badge }}</span>{%- endif -%}
                {%- if p.featured_image != blank -%}
                  {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', sizes: '(min-width: 990px) 22vw, (min-width: 600px) 44vw, 90vw', alt: p.featured_image.alt | default: p.title }}
                {%- endif -%}
              </span>
              <span class="apx-hp__body">
                <span class="apx-hp__title">{{ p.title }}</span>
                {%- if block.settings.note != blank -%}<span class="apx-hp__note">{{ block.settings.note }}</span>{%- endif -%}
                <span class="apx-hp__price">
                  {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {% endif -%}
                  {{ p.price | money }}
                </span>
              </span>
            </a>
            <a class="apx-btn apx-hp__btn" href="{{ p.url }}">{{ section.settings.button_label }}<span class="apx-sr"> {{ p.title }}</span></a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if section.settings.all_label != blank -%}
      <p class="apx-center apx-hp__all"><a href="{{ section.settings.all_link | default: '/collections/all' }}">{{ section.settings.all_label }} <span aria-hidden="true">&rarr;</span></a></p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-hp__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px;margin:clamp(28px,4vw,48px) 0 0;padding:0;list-style:none}
  .apx-hp__card{display:flex;flex-direction:column;gap:14px;padding:12px 12px 18px;border:1px solid var(--ap-line);border-radius:28px;background:var(--ap-white);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s}
  .apx-hp__link{display:block;color:inherit;text-decoration:none}
  .apx-hp__img{position:relative;display:block;overflow:hidden;aspect-ratio:1;border-radius:20px;background:var(--ap-sand)}
  .apx-hp__img img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .apx-hp__badge{position:absolute;left:12px;top:12px;z-index:1;padding:.3rem .8rem;border-radius:999px;background:var(--ap-ink);color:var(--ap-butter);font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .apx-hp__body{display:grid;gap:4px;padding:14px 8px 0}
  .apx-hp__title{font-family:var(--ap-font-display);font-size:1.5rem;line-height:1.15}
  .apx-hp__note{color:var(--ap-ink-soft);font-size:.9375rem}
  .apx-hp__price{font-size:1.125rem;font-weight:800;color:var(--ap-blush-deep)}
  .apx-hp__price s{margin-right:.3rem;font-weight:500;color:var(--ap-ink-soft)}
  .apx-hp__btn{margin:auto 8px 0;width:calc(100% - 16px)}
  .apx-hp__all{margin-top:28px}
  .apx-hp__all a{font-weight:800}
  @media (hover:hover){.apx-hp__card:hover{transform:translateY(-6px);box-shadow:0 22px 44px rgba(31,31,58,.12)}.apx-hp__card:hover .apx-hp__img img{transform:scale(1.06)}}
{% endstylesheet %}

{% schema %}
{
  "name": "Home products",
  "tag": "div",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your kit" },
    { "type": "textarea", "id": "text", "label": "Intro (optional)", "default": "Day and night patches, in the size of kit that suits you." },
    { "type": "text", "id": "button_label", "label": "Card button", "default": "Shop now" },
    { "type": "text", "id": "all_label", "label": "See-all link text", "default": "See all products" },
    { "type": "url", "id": "all_link", "label": "See-all link", "info": "Leave empty to open all products." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "For example Most popular. Only if it is true." },
        { "type": "text", "id": "note", "label": "One-line note (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home products",
      "blocks": [ { "type": "product" }, { "type": "product" }, { "type": "product" } ]
    }
  ]
}
{% endschema %}
