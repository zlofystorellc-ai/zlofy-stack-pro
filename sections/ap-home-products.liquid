{%- comment -%}
  Home page product cards. One product card (this is a one-product store): it shows the photo, name, price and a button.
  Cards for products that are not picked, or are unavailable, are skipped.
{%- endcomment -%}
{%- assign shown = 0 -%}
{%- for block in section.blocks -%}{%- if block.settings.product != blank -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- assign fallback = collections.all.products.first -%}
{%- if shown == 0 and fallback != blank and section.blocks.size > 0 -%}{%- assign shown = 1 -%}{%- endif -%}
{%- if shown > 0 -%}
<section class="apx-hp apx-section{% if shown == 1 %} apx-hp--single{% endif %}" id="shop" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if shown == 1 -%}
      {%- assign sp = fallback -%}
      {%- assign sb = section.blocks.first -%}
      {%- if sb.settings.product != blank -%}{%- assign sp = sb.settings.product -%}{%- endif -%}
      {%- assign sv = sp.selected_or_first_available_variant | default: sp.variants.first -%}
      {%- assign alloc = sv.selling_plan_allocations.first -%}
      <form class="apx-hk" method="post" action="{{ routes.cart_add_url }}" data-ap-quick-add data-ap-hk data-unit="{{ sv.price }}" data-currency="{{ cart.currency.iso_code | default: shop.currency | default: 'USD' }}" {{ sb.shopify_attributes }}>
        <input type="hidden" name="id" value="{{ sv.id }}">
        <div class="apx-hk__left">
          <a class="apx-hk__media" href="{{ sp.url }}" aria-label="{{ sp.title | escape }}">
            <span class="apx-hk__chips">
              {%- if sb.settings.badge != blank -%}<span class="apx-hk__badge">{{ sb.settings.badge }}</span>{%- endif -%}
              {%- if section.settings.chip != blank -%}<span class="apx-hk__chip">{{ section.settings.chip }}</span>{%- endif -%}
            </span>
            {%- if sp.featured_image != blank -%}
              {{ sp.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 40vw, 90vw', alt: sp.featured_image.alt | default: sp.title }}
            {%- endif -%}
            {%- if section.settings.caption != blank -%}<span class="apx-hk__cap">{{ section.settings.caption }}</span>{%- endif -%}
          </a>
          <ul class="apx-hk__tabs">
            {%- for n in (1..4) -%}
              {%- assign tk = 'tab_' | append: n | append: '_title' -%}
              {%- assign xk = 'tab_' | append: n | append: '_text' -%}
              {%- if section.settings[tk] != blank -%}
                <li><span class="apx-hk__tab{% if n == 1 %} is-on{% endif %}"><b>{{ section.settings[tk] }}</b>{%- if section.settings[xk] != blank -%}<span>{{ section.settings[xk] }}</span>{%- endif -%}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
        <div class="apx-hk__info">
          {%- if section.settings.meta != blank -%}<p class="apx-hk__meta">{{ section.settings.meta }}</p>{%- endif -%}
          <h3 class="apx-hk__title"><a href="{{ sp.url }}">{{ sp.title }}</a></h3>
          {%- if section.settings.desc != blank -%}<div class="apx-hk__desc">{{ section.settings.desc }}</div>{%- endif -%}

          <ul class="apx-hk__trust">
            {%- for n in (1..4) -%}
              {%- assign tk = 'trust_' | append: n | append: '_title' -%}
              {%- assign xk = 'trust_' | append: n | append: '_text' -%}
              {%- if section.settings[tk] != blank -%}
                <li>
                  <span class="apx-hk__ti" aria-hidden="true">{%- case n -%}{%- when 1 -%}{% render 'ap-icon', name: 'sun', size: 20 %}{%- when 2 -%}{% render 'ap-icon', name: 'hand', size: 20 %}{%- when 3 -%}{% render 'ap-icon', name: 'drop', size: 20 %}{%- else -%}{% render 'ap-icon', name: 'leaf', size: 20 %}{%- endcase -%}</span>
                  <span><b>{{ section.settings[tk] }}</b>{%- if section.settings[xk] != blank -%}<em>{{ section.settings[xk] }}</em>{%- endif -%}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- if section.settings.qty_label == blank -%}<input type="hidden" name="quantity" value="1">{%- endif -%}
          {%- if section.settings.qty_label != blank -%}
            <p class="apx-hk__step" id="{{ section.id }}-qty">{{ section.settings.qty_label }}</p>
            <div class="apx-hk__qty" role="radiogroup" aria-labelledby="{{ section.id }}-qty">
              {%- for n in (1..3) -%}
                {%- assign tk = 'qty_' | append: n | append: '_title' -%}
                {%- assign xk = 'qty_' | append: n | append: '_text' -%}
                {%- if section.settings[tk] != blank -%}
                  <label class="apx-hk__q"><input type="radio" name="quantity" value="{{ n }}"{% if n == 1 %} checked{% endif %}><b>{{ section.settings[tk] }}</b>{%- if section.settings[xk] != blank -%}<span>{{ section.settings[xk] }}</span>{%- endif -%}</label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <p class="apx-hk__step">{{ section.settings.step2 }}</p>
          <div class="apx-hk__plans" role="radiogroup" aria-label="{{ section.settings.step2 | escape }}">
            {%- if alloc != blank -%}
              <label class="apx-hk__plan">
                <input type="radio" name="selling_plan" value="{{ alloc.selling_plan.id | default: alloc.selling_plan_id }}" data-price="{{ alloc.price }}" checked>
                <i aria-hidden="true"></i>
                <span><b>Subscribe &amp; save <em class="apx-hk__best">Best value</em></b><small>Pause, skip or cancel anytime</small></span>
                <strong>{{ alloc.price | money }}{%- if alloc.compare_at_price > alloc.price -%}<s>{{ alloc.compare_at_price | money }}</s>{%- endif -%}</strong>
              </label>
            {%- endif -%}
            <label class="apx-hk__plan">
              <input type="radio" name="selling_plan" value="" data-price="{{ sv.price }}"{% if alloc == blank %} checked{% endif %}>
              <i aria-hidden="true"></i>
              <span><b>One-time purchase</b><small>Standard single-order dispatch</small></span>
              <strong>{{ sv.price | money }}</strong>
            </label>
          </div>

          {%- if sv.available -%}
            <button type="submit" class="apx-hk__btn">{{ section.settings.button_label }} &mdash; <span data-ap-hk-price>{% if alloc != blank %}{{ alloc.price | money }}{% else %}{{ sv.price | money }}{% endif %}</span><span aria-hidden="true">&rarr;</span><span class="apx-sr"> {{ sp.title }}</span></button>
          {%- else -%}
            <a class="apx-hk__btn" href="{{ sp.url }}">{{ 'ap.cart.sold_out' | t }}</a>
          {%- endif -%}
          {%- if section.settings.footnote != blank -%}<p class="apx-hk__foot">{{ section.settings.footnote }}</p>{%- endif -%}
        </div>
      </form>
      {% render 'ap-cart-drawer' %}
      <script src="{{ 'ap-cart.js' | asset_url }}" type="module"></script>
      <script>
        (function () {
          var f = document.querySelector('[data-ap-hk]'); if (!f) return;
          var btn = f.querySelector('[data-ap-hk-price]'), cur = f.getAttribute('data-currency') || 'USD';
          function money(c) { try { return new Intl.NumberFormat('en-US', { style: 'currency', currency: cur }).format(c / 100); } catch (e) { return '$' + (c / 100).toFixed(2); } }
          function upd() {
            var plan = f.querySelector('input[name="selling_plan"]:checked'), q = f.querySelector('input[name="quantity"]:checked');
            var unit = Number(plan ? plan.getAttribute('data-price') : f.getAttribute('data-unit')), n = Number(q ? q.value : 1);
            if (btn && unit) btn.textContent = money(unit * n);
          }
          f.addEventListener('change', upd); upd();
        })();
      </script>
    {%- else -%}
    <ul class="apx-hp__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <li class="apx-hp__card" {{ block.shopify_attributes }}>
            <a class="apx-hp__link" href="{{ p.url }}">
              <span class="apx-hp__img">
                {%- if block.settings.badge != blank -%}<span class="apx-hp__badge">{{ block.settings.badge }}</span>{%- endif -%}
                {%- if p.featured_image != blank -%}
                  {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', sizes: '(min-width: 990px) 22vw, (min-width: 600px) 44vw, 90vw', alt: p.featured_image.alt | default: p.title }}
                {%- endif -%}
              </span>
              <span class="apx-hp__body">
                <span class="apx-hp__title">{{ p.title }}</span>
                {%- if block.settings.note != blank -%}<span class="apx-hp__note">{{ block.settings.note }}</span>{%- endif -%}
                <span class="apx-hp__price">
                  {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {% endif -%}
                  {{ p.price | money }}
                </span>
              </span>
            </a>
            <a class="apx-btn apx-hp__btn" href="{{ p.url }}">{{ section.settings.button_label }}<span class="apx-sr"> {{ p.title }}</span></a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
    {%- if section.settings.all_label != blank -%}
      <p class="apx-center apx-hp__all"><a href="{{ section.settings.all_link | default: '/collections/all' }}">{{ section.settings.all_label }} <span aria-hidden="true">&rarr;</span></a></p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-hp__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px;margin:clamp(28px,4vw,48px) 0 0;padding:0;list-style:none}
  .apx-hp__card{display:flex;flex-direction:column;gap:14px;padding:12px 12px 18px;border:1px solid var(--ap-line);border-radius:28px;background:var(--ap-white);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s}
  .apx-hp__link{display:block;color:inherit;text-decoration:none}
  .apx-hp__img{position:relative;display:block;overflow:hidden;aspect-ratio:1;border-radius:20px;background:var(--ap-sand)}
  .apx-hp__img img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .apx-hp__badge{position:absolute;left:12px;top:12px;z-index:1;padding:.3rem .8rem;border-radius:999px;background:var(--ap-ink);color:var(--ap-butter);font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .apx-hp__body{display:grid;gap:4px;padding:14px 8px 0}
  .apx-hp__title{font-family:var(--ap-font-display);font-size:1.5rem;line-height:1.15}
  .apx-hp__note{color:var(--ap-ink-soft);font-size:.9375rem}
  .apx-hp__price{font-size:1.125rem;font-weight:800;color:var(--ap-blush-deep)}
  .apx-hp__price s{margin-right:.3rem;font-weight:500;color:var(--ap-ink-soft)}
  .apx-hp__btn{margin:auto 8px 0;width:calc(100% - 16px)}
  .apx-hp--single .apx-hp__grid{grid-template-columns:minmax(0,1fr);max-width:420px;margin-inline:auto}
  @media (min-width:760px){
    .apx-hp--single .apx-hp__grid{max-width:900px}
    .apx-hp--single .apx-hp__card{display:grid;grid-template-columns:1fr 1fr;gap:0 40px;align-items:center;padding:18px}
    .apx-hp--single .apx-hp__link{display:contents}
    .apx-hp--single .apx-hp__img{grid-row:1 / span 2;border-radius:24px}
    .apx-hp--single .apx-hp__body{align-self:end;padding:0}
    .apx-hp--single .apx-hp__title{font-size:clamp(1.75rem,3vw,2.5rem)}
    .apx-hp--single .apx-hp__price{font-size:1.5rem}
    .apx-hp--single .apx-hp__btn{align-self:start;margin:20px 0 0;width:auto;justify-self:start;min-width:220px}
  }
  /* one-product "Shop the kit" panel: everything links to the product page */
  .apx-hk{display:grid;gap:28px;margin:clamp(24px,4vw,44px) auto 0;max-width:1180px;padding:clamp(16px,3vw,48px);border:1px solid var(--ap-line);border-radius:clamp(26px,3vw,44px);background:linear-gradient(180deg,#fff,#FDF8F8);box-shadow:0 30px 70px rgba(59,10,20,.07)}
  .apx-hk a{color:inherit;text-decoration:none}
  .apx-hk__left{min-width:0;align-self:center}
  .apx-hk__media{position:relative;display:block;overflow:hidden;aspect-ratio:1/1;border:1px solid var(--ap-line);border-radius:30px;background:linear-gradient(160deg,#F6E7E8,#F0D9DC)}
  .apx-hk__media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .apx-hk__chips{position:absolute;left:16px;top:16px;z-index:1;display:flex;flex-direction:column;align-items:flex-start;gap:8px}
  .apx-hk__badge{padding:.55rem 1rem;border-radius:999px;background:var(--ap-ink);color:#fff;font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .apx-hk__chip{padding:.5rem .9rem;border:1px solid var(--ap-line);border-radius:999px;background:rgba(255,255,255,.92);color:var(--ap-ink);font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .apx-hk__cap{position:absolute;left:16px;right:16px;bottom:16px;padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.95);color:var(--ap-ink);text-align:center;font-size:.9375rem;font-weight:700;line-height:1.35}
  .apx-hk__tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:14px 0 0;padding:0;list-style:none}
  .apx-hk a.apx-hk__tab{display:grid;gap:2px;align-content:center;min-height:56px;padding:10px 8px;border:1.5px solid var(--ap-line);border-radius:14px;background:#fff;text-align:center;font-size:.8125rem;transition:border-color .2s,box-shadow .2s}
  .apx-hk__tab span{font-size:.75rem;color:var(--ap-ink-soft)}
  .apx-hk__info{display:flex;flex-direction:column;justify-content:center;min-width:0}
  .apx-hk__meta{margin:0 0 .6rem;font-size:.75rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--ap-blush-deep)}
  .apx-hk__title{margin:0;font-family:var(--ap-font-display);font-size:clamp(1.9rem,3vw,2.75rem);line-height:1.05}
  .apx-hk__desc{margin:.8rem 0 0;font-size:1rem;line-height:1.65;color:var(--ap-ink-soft)}
  .apx-hk__desc p{margin:0}
  .apx-hk__desc strong{color:var(--ap-ink)}
  .apx-hk__trust{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:1.4rem 0 0;padding:0;list-style:none}
  .apx-hk__trust li{display:flex;gap:12px;align-items:flex-start;padding:16px;border:1px solid var(--ap-line);border-radius:18px;background:linear-gradient(160deg,#FFFBFB,#FBF1F2)}
  .apx-hk__ti{flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#fff;color:var(--ap-blush-deep);box-shadow:0 4px 12px rgba(59,10,20,.08)}
  .apx-hk__trust b{display:block;font-size:.9375rem;line-height:1.25;color:var(--ap-ink)}
  .apx-hk__trust em{display:block;margin-top:4px;font-style:normal;font-size:.8125rem;line-height:1.45;color:var(--ap-ink-soft)}
  .apx-hk__step{margin:1.6rem 0 .7rem;font-size:.75rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--ap-ink)}
  .apx-hk__qty{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0;padding:0;list-style:none}
  .apx-hk a.apx-hk__q{display:grid;gap:2px;justify-items:center;padding:14px 8px;border:1.5px solid var(--ap-line);border-radius:16px;background:#fff;text-align:center;font-size:.9375rem;transition:border-color .2s,box-shadow .2s}
  .apx-hk__q span{font-size:.8125rem;color:var(--ap-ink-soft)}
  .apx-hk__plans{display:grid;gap:12px;margin:0;padding:0;list-style:none}
  .apx-hk a.apx-hk__plan{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;padding:18px;border:1.5px solid var(--ap-line);border-radius:18px;background:#fff;transition:border-color .2s,box-shadow .2s,transform .2s}
  .apx-hk__plan i{width:22px;height:22px;border:2px solid var(--ap-line);border-radius:50%}
  .apx-hk__plan.is-on i{border:7px solid var(--ap-ink)}
  .apx-hk__plan b{display:block;font-size:1rem;line-height:1.3}
  .apx-hk__plan small{display:block;margin-top:3px;font-size:.875rem;color:var(--ap-ink-soft)}
  .apx-hk__best{display:inline-block;margin-left:6px;padding:.2rem .6rem;border-radius:999px;background:var(--ap-ink);color:#fff;font-style:normal;font-size:.6875rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;vertical-align:middle}
  .apx-hk__plan strong{display:grid;justify-items:end;font-family:var(--ap-font-display);font-size:1.6rem;font-weight:400}
  .apx-hk__plan s{font-family:var(--ap-font);font-size:.9375rem;color:var(--ap-ink-soft)}
  .apx-hk a.is-on{border-color:var(--ap-ink);box-shadow:0 8px 22px rgba(59,10,20,.08)}
  .apx-hk a.apx-hk__plan:hover,.apx-hk a.apx-hk__q:hover,.apx-hk a.apx-hk__tab:hover{border-color:var(--ap-blush-deep)}
  .apx-hk__btn{display:flex;align-items:center;justify-content:center;gap:10px;min-height:60px;margin-top:1.4rem;padding:0 24px;border-radius:999px;background:var(--ap-ink);color:#fff!important;font-size:1.0625rem;font-weight:800;box-shadow:0 16px 30px rgba(59,10,20,.28);transition:transform .2s,box-shadow .2s}
  .apx-hk__btn:hover{transform:translateY(-2px);box-shadow:0 22px 38px rgba(59,10,20,.34)}
  .apx-hk a:focus-visible{outline:3px solid var(--ap-blush-deep);outline-offset:3px}
  .apx-hk__foot{margin:.9rem 0 0;text-align:center;font-size:.875rem;color:var(--ap-ink-soft)}
  @media (max-width:520px){.apx-hk__trust{grid-template-columns:minmax(0,1fr)}.apx-hk__tabs{grid-template-columns:repeat(2,minmax(0,1fr))}.apx-hk a.apx-hk__plan{padding:14px;gap:10px}.apx-hk__plan strong{font-size:1.35rem}}
  @media (min-width:900px){.apx-hk{grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);gap:48px;align-items:center}.apx-hk__title{white-space:nowrap}}
  @media (hover:hover){.apx-hk__media:hover img{transform:scale(1.04)}}
  @media (prefers-reduced-motion:reduce){.apx-hk__btn,.apx-hk a.apx-hk__plan,.apx-hk a.apx-hk__q,.apx-hk a.apx-hk__tab,.apx-hk__media img{transition:none}}
  /* compact height */
  @media (min-width:900px){
    .apx-hk{padding:clamp(20px,2.4vw,36px);gap:36px}
    .apx-hk__trust{gap:10px;margin-top:1.1rem}
    .apx-hk__trust li{padding:12px 14px}
    .apx-hk__trust em{margin-top:2px}
    .apx-hk__step{margin:1.15rem 0 .55rem}
    .apx-hk a.apx-hk__plan{padding:13px 16px}
    .apx-hk__plans{gap:10px}
    .apx-hk a.apx-hk__q{padding:11px 8px}
    .apx-hk__btn{min-height:54px;margin-top:1.1rem}
    .apx-hk__foot{margin-top:.7rem}
    .apx-hk__media{aspect-ratio:1/.9}
  }

  /* real buying controls: selected state, hidden radios, button */
  .apx-hk label{cursor:pointer}
  .apx-hk input[type=radio]{position:absolute;opacity:0;pointer-events:none}
  .apx-hk__qty{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  .apx-hk label.apx-hk__q{position:relative;display:grid;gap:2px;justify-items:center;padding:14px 8px;border:1.5px solid var(--ap-line);border-radius:16px;background:#fff;text-align:center;font-size:.9375rem;transition:border-color .2s,box-shadow .2s}
  .apx-hk label.apx-hk__q:has(input:checked),.apx-hk label.apx-hk__plan:has(input:checked){border-color:var(--ap-ink);box-shadow:0 8px 22px rgba(59,10,20,.08)}
  .apx-hk label.apx-hk__plan{position:relative;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;padding:18px;border:1.5px solid var(--ap-line);border-radius:18px;background:#fff;transition:border-color .2s,box-shadow .2s}
  .apx-hk label.apx-hk__plan:has(input:checked) i{border:7px solid var(--ap-ink)}
  .apx-hk label:has(input:focus-visible){outline:3px solid var(--ap-blush-deep);outline-offset:3px}
  .apx-hk span.apx-hk__tab{display:grid;gap:2px;align-content:center;min-height:56px;padding:10px 8px;border:1.5px solid var(--ap-line);border-radius:14px;background:#fff;text-align:center;font-size:.8125rem}
  .apx-hk span.apx-hk__tab.is-on{border-color:var(--ap-ink)}
  button.apx-hk__btn{width:100%;border:0;font:inherit;font-size:1.0625rem;font-weight:800;cursor:pointer}
  button.apx-hk__btn[aria-busy="true"]{opacity:.7}
  @media (min-width:900px){.apx-hk label.apx-hk__plan{padding:13px 16px}.apx-hk label.apx-hk__q{padding:11px 8px}}
  .apx-hp__all{margin-top:28px}
  .apx-hp__all a{font-weight:800}
  @media (hover:hover){.apx-hp__card:hover{transform:translateY(-6px);box-shadow:0 22px 44px rgba(59,10,20,.12)}.apx-hp__card:hover .apx-hp__img img{transform:scale(1.06)}}
{% endstylesheet %}

{% schema %}
{
  "name": "Home products",
  "tag": "div",
  "enabled_on": { "templates": ["index"] },
  "settings": [
