{%- comment -%} 4 steps as a timeline + optional how-to video + honest scope note. {%- endcomment -%}
{%- liquid
  assign has_media = false
  if section.settings.show_builtin_video or section.settings.video != blank or section.settings.poster != blank
    assign has_media = true
  endif
-%}
<section id="how" class="apx-how apx-section{% if has_media %} apx-how--media{% endif %}" aria-labelledby="{{ section.id }}-title" data-ap-how>
  <div class="apx-wrap">
    <div class="apx-center apx-how__head">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="apx-how__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="apx-how__body">
    {%- if has_media -%}
      <div class="apx-how__stage">
        <div class="apx-how__media" data-ap-media>
          {%- if section.settings.show_builtin_video -%}
            <video class="apx-how__video" muted playsinline loop preload="none" poster="{{ 'ap-how-video.jpg' | asset_url }}" aria-label="{{ section.settings.builtin_alt | escape }}">
              <source src="{{ 'ap-how-video.mp4' | asset_url }}" type="video/mp4">
            </video>
            <button type="button" class="apx-how__play" data-ap-media-play aria-pressed="false" aria-label="{{ 'ap.video_cards.play' | t }}: {{ section.settings.heading | escape }}">
              <span class="apx-how__disc" aria-hidden="true"></span>
              {%- if section.settings.media_caption != blank -%}<span class="apx-how__cap" aria-hidden="true">{{ section.settings.media_caption }}</span>{%- endif -%}
            </button>
          {%- elsif section.settings.video != blank -%}
            {{ section.settings.video | video_tag: image_size: '900x', controls: false, muted: true, playsinline: true, preload: 'none', loop: true, class: 'apx-how__video', poster: section.settings.poster | default: section.settings.video.preview_image }}
            <button type="button" class="apx-how__play" data-ap-media-play aria-pressed="false" aria-label="{{ 'ap.video_cards.play' | t }}: {{ section.settings.heading | escape }}">
              <span class="apx-how__disc" aria-hidden="true"></span>
              {%- if section.settings.media_caption != blank -%}<span class="apx-how__cap" aria-hidden="true">{{ section.settings.media_caption }}</span>{%- endif -%}
            </button>
          {%- else -%}
            {{ section.settings.poster | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 40vw, 90vw', class: 'apx-how__video', alt: section.settings.poster.alt | default: section.settings.heading }}
          {%- endif -%}
        </div>
        <div class="apx-how__orb" aria-hidden="true">
          <span class="apx-how__orb-ring"></span>
          <span class="apx-how__orb-new"></span>
          <span class="apx-how__orb-disc"><span class="apx-how__orb-fill"></span></span>
          <span class="apx-how__orb-drop" style="--i:0"></span><span class="apx-how__orb-drop" style="--i:1"></span><span class="apx-how__orb-drop" style="--i:2"></span>
          <span class="apx-how__orb-t" data-ap-how-label></span>
        </div>
        {%- if section.settings.show_builtin_video and section.settings.demo_note != blank -%}<p class="apx-how__demo">{{ section.settings.demo_note }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ol class="apx-how__steps" data-ap-how-steps>
      {%- for block in section.blocks -%}
        <li class="apx-how__step" {{ block.shopify_attributes }}>
          <span class="apx-how__num" aria-hidden="true">{{ forloop.index }}</span>
          <div class="apx-how__card">
            <div class="apx-how__top">
              <span class="apx-how__icon" aria-hidden="true">{% render 'ap-icon', name: block.settings.icon, size: 22 %}</span>
              {%- if block.settings.chip != blank -%}<span class="apx-how__chip">{{ block.settings.chip }}</span>{%- endif -%}
            </div>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 90vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title, class: 'apx-how__img' }}
            {%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
    </div>
    <p class="apx-how__note"><span class="apx-how__note-i" aria-hidden="true">{% render 'ap-icon', name: 'heart', size: 18 %}</span><span><strong>{{ 'ap.how.note_label' | t }}</strong> {{ 'ap.how.note' | t }}</span></p>
  </div>
</section>
<script src="{{ 'ap-how.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .apx-how{position:relative;overflow:hidden;background:linear-gradient(180deg,#F5E6E8 0%,#F2DADF 100%)}
  .apx-how::before,.apx-how::after{content:"";position:absolute;z-index:0;border-radius:50%;pointer-events:none;filter:blur(8px)}
  .apx-how::before{top:-120px;right:-100px;width:380px;height:380px;background:radial-gradient(circle,rgba(233,206,212,.55),rgba(233,206,212,0) 70%)}
  .apx-how::after{bottom:-140px;left:-120px;width:420px;height:420px;background:radial-gradient(circle,rgba(255,224,102,.4),rgba(255,224,102,0) 70%)}
  .apx-how .apx-wrap{position:relative;z-index:1}
  .apx-how__sub{max-width:34em;margin:14px auto 0;color:var(--ap-ink-soft);font-size:1.0625rem;line-height:1.55}
  .apx-how__body{margin-top:clamp(28px,4vw,48px)}

  /* steps (no media): clean four-up cards */
  .apx-how__steps{display:grid;gap:16px;margin:0;padding:0;list-style:none;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
  .apx-how__step{position:relative}
  .apx-how__card{height:100%;padding:22px;border:1px solid rgba(59,10,20,.06);border-radius:22px;background:var(--ap-white);box-shadow:0 10px 30px rgba(59,10,20,.06);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,border-color .35s}
  .apx-how__card h3{margin:.55rem 0 .3rem;font-size:1.2rem}
  .apx-how__card p{margin:0;color:var(--ap-ink-soft);line-height:1.55}
  .apx-how__top{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .apx-how__icon{display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:#F5E6E8;color:var(--ap-blush-deep)}
  .apx-how__chip{padding:5px 12px;border-radius:999px;background:var(--ap-ink);color:var(--ap-white);font-size:.8125rem;font-weight:700;letter-spacing:.02em}
  .apx-how__num{display:none}
  .apx-how__img{display:block;width:100%;height:auto;margin:14px 0 4px;border-radius:var(--ap-radius-sm)}

  /* stage: video / photo */
  .apx-how__stage{position:relative}
  .apx-how__stage::before{content:"";position:absolute;inset:6% -6% -4% 8%;z-index:0;border-radius:36px;background:linear-gradient(150deg,#B4566A,#E9CED4);opacity:.35;transform:rotate(3deg)}
  .apx-how__media{position:relative;z-index:1;overflow:hidden;border:6px solid var(--ap-white);border-radius:32px;background:var(--ap-sand);box-shadow:0 28px 60px rgba(59,10,20,.2);aspect-ratio:4/5;max-width:440px;margin-inline:auto;width:100%}
  .apx-how__video{display:block;width:100%;height:100%;object-fit:cover}
  video.apx-how__video::-webkit-media-controls{display:none!important}
  .apx-how__play{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;border:0;background:linear-gradient(180deg,rgba(59,10,20,0) 45%,rgba(59,10,20,.35));cursor:pointer}
  .apx-how__disc{position:relative;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,.96);box-shadow:0 10px 28px rgba(59,10,20,.35);transition:transform .25s,opacity .25s;animation:apx-how-pulse 2.4s ease-out infinite}
  .apx-how__disc::before{content:"";position:absolute;left:32px;top:24px;border-left:22px solid var(--ap-blush-deep);border-block:16px solid transparent}
  .apx-how__cap{padding:7px 16px;border-radius:999px;background:rgba(255,255,255,.94);color:var(--ap-ink);font-size:.875rem;font-weight:700;transition:opacity .25s}
  .apx-how__play:hover .apx-how__disc{transform:scale(1.07)}
  .apx-how__play[aria-pressed="true"]{background:transparent}
  .apx-how__play[aria-pressed="true"] .apx-how__disc,.apx-how__play[aria-pressed="true"] .apx-how__cap{opacity:0;animation:none}
  .apx-how__play:focus-visible .apx-how__disc{outline:3px solid var(--ap-white);box-shadow:0 0 0 6px var(--ap-ink)}
  @keyframes apx-how-pulse{0%{box-shadow:0 10px 28px rgba(59,10,20,.35),0 0 0 0 rgba(255,255,255,.55)}70%,100%{box-shadow:0 10px 28px rgba(59,10,20,.35),0 0 0 26px rgba(255,255,255,0)}}

  /* with media: video beside a connected timeline */
  .apx-how--media .apx-how__body{display:grid;gap:36px;align-items:center}
  .apx-how--media .apx-how__steps{position:relative;grid-template-columns:1fr;gap:18px}
  .apx-how--media .apx-how__steps::before,.apx-how--media .apx-how__steps::after{content:"";position:absolute;left:23px;top:24px;bottom:24px;width:3px;border-radius:3px}
  .apx-how--media .apx-how__steps::before{background:rgba(110,20,35,.18)}
  .apx-how--media .apx-how__steps::after{background:linear-gradient(180deg,#B4566A,#6E1423);transform-origin:top;transform:scaleY(var(--ap-how-p,0));transition:transform .25s linear}
  .apx-how--media .apx-how__step{display:grid;grid-template-columns:48px minmax(0,1fr);column-gap:18px;align-items:start}
  .apx-how--media .apx-how__num{position:relative;z-index:1;display:grid;place-items:center;width:48px;height:48px;border:3px solid #F5E6E8;border-radius:50%;background:var(--ap-white);color:var(--ap-blush-deep);font-weight:800;font-size:1.05rem;transition:background .35s,color .35s,transform .35s,border-color .35s}
  .apx-how--media .apx-how__step.is-active .apx-how__num,.apx-how--media .apx-how__step.is-done .apx-how__num{background:var(--ap-blush-deep);border-color:var(--ap-blush-deep);color:var(--ap-white)}
  .apx-how--media .apx-how__step.is-active .apx-how__num{transform:scale(1.12)}
  .apx-how--media .apx-how__card{display:grid;grid-template-columns:auto 1fr;column-gap:16px;align-items:start;padding:18px 20px}
  .apx-how--media .apx-how__card{position:relative}
  .apx-how--media .apx-how__top{display:contents}
  .apx-how--media .apx-how__icon{grid-column:1;grid-row:1 / span 3}
  .apx-how--media .apx-how__chip{position:absolute;top:14px;right:16px}
  .apx-how--media .apx-how__card:has(.apx-how__chip) h3{padding-right:78px}
  .apx-how--media .apx-how__card h3{grid-column:2;margin:.1rem 0 .25rem}
  .apx-how--media .apx-how__card p{grid-column:2}
  .apx-how--media .apx-how__img{grid-column:1 / -1}
  .apx-how--media .apx-how__step.is-active .apx-how__card{border-color:rgba(110,20,35,.35);box-shadow:0 18px 40px rgba(110,20,35,.16);transform:translateX(6px)}
  @media (hover:hover){.apx-how__card:hover{box-shadow:0 18px 40px rgba(59,10,20,.12)}}
  @media (max-width:520px){
    .apx-how--media .apx-how__card{grid-template-columns:1fr}
    .apx-how--media .apx-how__icon{grid-column:1;grid-row:auto;margin-bottom:10px}
    .apx-how--media .apx-how__card h3,.apx-how--media .apx-how__card p{grid-column:1}
    .apx-how--media .apx-how__step.is-active .apx-how__card{transform:none}
  }
  @media (min-width:900px){
    .apx-how--media .apx-how__body{grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:72px}
    .apx-how--media .apx-how__stage{position:sticky;top:96px}
  }
  @media (prefers-reduced-motion:reduce){.apx-how__disc{animation:none}.apx-how--media .apx-how__steps::after{transition:none}.apx-how__card,.apx-how__num{transition:none}}

  /* 3D tilt for the video, and a little 3D patch that acts out the active step */
  .apx-how__stage{perspective:1200px}
  .apx-how__media{transform:rotateY(calc(var(--ry,0) * 9deg)) rotateX(calc(var(--rx,0) * -7deg));transition:transform .3s ease-out;will-change:transform}
  .apx-how__stage::before{transform:rotate(3deg) translate(calc(var(--ry,0) * -16px),calc(var(--rx,0) * 12px));transition:transform .3s ease-out}
  .apx-how__orb{position:absolute;z-index:3;right:-14px;top:26px;display:grid;place-items:center;width:104px;height:104px;translate:calc(var(--ry,0) * 16px) calc(var(--rx,0) * -12px);transition:translate .3s ease-out}
  .apx-how__orb-ring{position:absolute;inset:6px;border-radius:50%;border:3px solid rgba(255,255,255,.9);opacity:0}
  .apx-how__orb-disc,.apx-how__orb-new{position:absolute;width:74px;height:74px;border-radius:50%}
  .apx-how__orb-disc{overflow:hidden;background:radial-gradient(circle at 32% 28%,#fff,#EBC3CB 55%,#D98FA0);box-shadow:inset 0 0 0 3px rgba(255,255,255,.75),0 16px 30px rgba(110,20,35,.38);animation:apx-how-bob 4.5s ease-in-out infinite alternate}
  .apx-how__orb-new{background:radial-gradient(circle at 32% 28%,rgba(255,255,255,.95),rgba(255,226,232,.7) 60%,rgba(255,196,210,.55));box-shadow:inset 0 0 0 3px rgba(255,255,255,.8),0 14px 26px rgba(110,20,35,.25);opacity:0}
  .apx-how__orb-fill{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,#fff 52%,rgba(255,255,255,0) 74%);transform:scale(0);opacity:0}
  .apx-how__orb-drop{position:absolute;top:0;left:calc(50% + (var(--i) - 1) * 20px - 5px);width:10px;height:10px;border-radius:50% 50% 50% 0;background:#9FD8FF;transform:rotate(-45deg);opacity:0}
  .apx-how__orb-t{position:absolute;left:50%;bottom:-14px;translate:-50% 0;padding:.25rem .7rem;border-radius:999px;background:var(--ap-ink);color:var(--ap-white);font-size:.75rem;font-weight:800;letter-spacing:.04em;white-space:nowrap;box-shadow:0 8px 18px rgba(59,10,20,.3)}
  .apx-how__orb-t:empty{display:none}
  [data-step="1"] .apx-how__orb-drop{animation:apx-how-fall 1.6s calc(var(--i) * .35s) ease-in infinite}
  [data-step="2"] .apx-how__orb-disc{animation:apx-how-press 1.7s ease-in-out infinite}
  [data-step="2"] .apx-how__orb-ring{animation:apx-how-ripple 1.7s ease-out infinite}
  [data-step="3"] .apx-how__orb-fill{opacity:1;animation:apx-how-fill 5s ease-in-out infinite}
  [data-step="4"] .apx-how__orb-disc{animation:apx-how-peel 3s ease-in-out infinite}
  [data-step="4"] .apx-how__orb-new{animation:apx-how-fresh 3s ease-in-out infinite}
  @keyframes apx-how-bob{from{transform:translateY(0) rotateX(0)}to{transform:translateY(-7px) rotateX(10deg)}}
  @keyframes apx-how-fall{0%{opacity:0;translate:0 -4px}25%{opacity:1}80%{opacity:1;translate:0 30px}100%{opacity:0;translate:0 38px}}
  @keyframes apx-how-press{0%,100%{transform:scale(1)}45%{transform:scale(.84)}}
  @keyframes apx-how-ripple{0%{opacity:.9;transform:scale(.7)}100%{opacity:0;transform:scale(1.25)}}
  @keyframes apx-how-fill{0%,8%{transform:scale(0)}78%{transform:scale(1.15)}100%{transform:scale(1.15)}}
  @keyframes apx-how-peel{0%,35%{transform:perspective(260px) rotateX(0) translateY(0);opacity:1}70%,100%{transform:perspective(260px) rotateX(72deg) translateY(-26px);opacity:0}}
  @keyframes apx-how-fresh{0%,55%{opacity:0;transform:scale(.7)}85%,100%{opacity:1;transform:scale(1)}}
  html .apx-how__step[data-ap-in="0"]{opacity:0;transform:perspective(900px) translateX(36px) rotateY(-18deg)}
  html .apx-how__step[data-ap-in="1"]{opacity:1;transform:none}
  @media (hover:hover){.apx-how__card:hover{transform:perspective(900px) translateZ(12px) rotateX(2deg) rotateY(-3deg);box-shadow:0 22px 44px rgba(59,10,20,.16)}}
  @media (max-width:520px){.apx-how__orb{right:-4px;top:10px;width:84px;height:84px}.apx-how__orb-disc,.apx-how__orb-new{width:58px;height:58px}}
  @media (prefers-reduced-motion:reduce){.apx-how__media,.apx-how__stage::before,.apx-how__orb{transform:none;translate:none}.apx-how__orb-disc,.apx-how__orb-new,.apx-how__orb-fill,.apx-how__orb-ring,.apx-how__orb-drop{animation:none!important}.apx-how__orb-fill{opacity:1;transform:scale(.6)}}
  .apx-how__demo{position:relative;z-index:1;margin:12px 0 0;text-align:center;color:var(--ap-ink-soft);font-size:.8125rem}
  .apx-how__note{display:flex;gap:12px;align-items:flex-start;max-width:70ch;margin:clamp(32px,4vw,48px) auto 0;padding:16px 20px;border:1px solid rgba(59,10,20,.06);border-left:4px solid var(--ap-blush-deep);border-radius:0 16px 16px 0;background:var(--ap-white);font-size:.9375rem;line-height:1.55;box-shadow:0 8px 24px rgba(59,10,20,.05)}
  .apx-how__note-i{flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#F5E6E8;color:var(--ap-blush-deep)}
  @media (max-width:520px){.apx-how__orb-t{left:auto;right:0;translate:none;bottom:-12px}}
{% endstylesheet %}

{% schema %}
{
  "name": "How it works",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Press. Wait. Peel. Swap." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Four simple steps, a few seconds of effort, and the patch does the rest." },
    { "type": "checkbox", "id": "show_builtin_video", "label": "Use the built-in how-to video", "default": true, "info": "An AI-generated demonstration video (muted, tap to play). It is NOT a real customer. Turn this off to use your own video or photo below." },
    { "type": "text", "id": "demo_note", "label": "Note under the built-in video", "default": "Demonstration video" },
    { "type": "text", "id": "builtin_alt", "label": "Built-in video description", "default": "A short demonstration of washing the face, drying it, and pressing a patch onto a small spot" },
    { "type": "video", "id": "video", "label": "How-to video (optional)", "info": "Shopify-hosted. Shown beside the steps, muted, tap to play, never autoplays. Upload only videos you own." },
    { "type": "image_picker", "id": "poster", "label": "Video cover / photo (optional)", "info": "Used as the video cover, or as a photo if there is no video. Upload only images you own or have licensed." },
    { "type": "text", "id": "media_caption", "label": "Video button caption", "default": "Watch how it works" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cleanse and dry" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wash your face gently and pat dry. Patches stick best to clean, dry skin." },
        { "type": "text", "id": "chip", "label": "Time tag (optional)", "info": "A short tag such as \"10 sec\"." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "drop",
          "options": [
            { "value": "drop", "label": "Drop" },
            { "value": "hand", "label": "Hand" },
            { "value": "clock", "label": "Clock" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "check", "label": "Check" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)",
          "info": "Upload only images you own or have licensed. No supplier/competitor photos. Before/after only from real, consenting customers, unedited."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "drop", "title": "Cleanse and dry", "text": "Wash your face gently and pat dry. Patches stick best to clean, dry skin." } },
        { "type": "step", "settings": { "icon": "hand", "chip": "10 sec", "title": "Press for 10 seconds", "text": "Place the patch over the spot and press from the center out so the edges seal." } },
        { "type": "step", "settings": { "icon": "clock", "chip": "6–8 hrs", "title": "Leave on 6–8 hours", "text": "Wear it for 6–8 hours, or until the patch turns white, which means it has taken in as much fluid as it can hold." } },
        { "type": "step", "settings": { "icon": "sparkle", "title": "Peel and swap", "text": "Peel from an edge, toss it, and add a fresh patch if the spot is still there." } }
      ]
    }
  ]
}
{% endschema %}
