{%- comment -%} 4 steps + honest scope note. {%- endcomment -%}
<section class="apx-how apx-section{% if section.settings.video != blank or section.settings.poster != blank %} apx-how--media{% endif %}" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="apx-how__body">
    {%- if section.settings.video != blank or section.settings.poster != blank -%}
      <div class="apx-how__media" data-ap-media>
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: image_size: '900x', controls: false, muted: true, playsinline: true, preload: 'none', loop: true, class: 'apx-how__video', poster: section.settings.poster | default: section.settings.video.preview_image }}
          <button type="button" class="apx-how__play" data-ap-media-play aria-pressed="false" aria-label="{{ 'ap.video_cards.play' | t }}: {{ section.settings.heading | escape }}"><span aria-hidden="true"></span></button>
        {%- else -%}
          {{ section.settings.poster | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 40vw, 90vw', class: 'apx-how__video', alt: section.settings.poster.alt | default: section.settings.heading }}
        {%- endif -%}
      </div>
    {%- endif -%}
    <ol class="apx-how__steps">
      {%- for block in section.blocks -%}
        <li class="apx-how__step" {{ block.shopify_attributes }}>
          <span class="apx-how__num" aria-hidden="true">{{ forloop.index }}</span>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 90vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title, class: 'apx-how__img' }}
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
    </div>
    <p class="apx-how__note"><strong>{{ 'ap.how.note_label' | t }}</strong> {{ 'ap.how.note' | t }}</p>
  </div>
</section>

{% stylesheet %}
  .apx-how__steps{display:grid;gap:16px;margin:28px 0;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));counter-reset:none}
  .apx-how__step{padding:22px;border-radius:var(--ap-radius);background:var(--ap-white)}
  .apx-how__step h3{font-size:1.15rem}
  .apx-how__step p{margin:0;color:var(--ap-ink-soft)}
  .apx-how__num{display:inline-grid;place-items:center;width:40px;height:40px;margin-bottom:12px;border-radius:14px;background:var(--ap-ink);color:var(--ap-white);font-weight:800}
  .apx-how__img{width:100%;height:auto;margin-bottom:12px;border-radius:var(--ap-radius-sm)}
  .apx-how{background:#FFE2E8}
  .apx-how__body{display:block}
  .apx-how__media{position:relative;overflow:hidden;border-radius:28px;background:var(--ap-sand);box-shadow:0 22px 50px rgba(31,42,68,.14)}
  .apx-how__video{display:block;width:100%;height:100%;object-fit:cover}
  .apx-how__play{position:absolute;inset:0;display:grid;place-items:center;border:0;background:transparent;cursor:pointer}
  .apx-how__play span{position:relative;width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,.94);box-shadow:0 8px 24px rgba(31,42,68,.3);transition:transform .25s,opacity .25s}
  .apx-how__play span::before{content:"";position:absolute;left:29px;top:22px;border-left:20px solid var(--ap-blush-deep);border-block:13px solid transparent}
  .apx-how__play:hover span{transform:scale(1.06)}
  .apx-how__play[aria-pressed="true"] span{opacity:0}
  .apx-how__play:focus-visible span{outline:3px solid var(--ap-white);box-shadow:0 0 0 6px var(--ap-ink)}
  .apx-how--media .apx-how__body{display:grid;gap:28px;margin-top:28px;align-items:start}
  .apx-how--media .apx-how__steps{display:grid;grid-template-columns:1fr;gap:14px;margin:0;counter-reset:none}
  .apx-how--media .apx-how__step{display:grid;grid-template-columns:48px 1fr;column-gap:16px;align-items:start}
  .apx-how--media .apx-how__num{grid-row:1/span 3;margin:0;width:48px;height:48px;border-radius:50%;background:var(--ap-blush-deep)}
  .apx-how--media .apx-how__img{grid-column:2}
  .apx-how--media .apx-how__step h3{margin:.2rem 0 .25rem}
  .apx-how--media .apx-how__media{aspect-ratio:4/5;max-width:440px;margin-inline:auto;width:100%}
  @media (min-width:900px){.apx-how--media .apx-how__body{grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:64px;align-items:center}.apx-how--media .apx-how__media{position:sticky;top:96px;margin:0}}
  .apx-how--media .apx-how__note{margin-top:40px}
  .apx-how__note{max-width:70ch;margin:0 auto;padding:14px 18px;border-left:4px solid var(--ap-blush-deep);background:var(--ap-white);font-size:.9375rem}
{% endstylesheet %}

{% schema %}
{
  "name": "How it works",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Press. Wait. Peel. Swap." },
    { "type": "video", "id": "video", "label": "How-to video (optional)", "info": "Shopify-hosted. Shown beside the steps, muted, tap to play, never autoplays. Upload only videos you own." },
    { "type": "image_picker", "id": "poster", "label": "Video cover / photo (optional)", "info": "Used as the video cover, or as a photo if there is no video. Upload only images you own or have licensed." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cleanse and dry" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wash your face gently and pat dry. Patches stick best to clean, dry skin." },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)",
          "info": "Upload only images you own or have licensed. No supplier/competitor photos. Before/after only from real, consenting customers, unedited."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Cleanse and dry", "text": "Wash your face gently and pat dry. Patches stick best to clean, dry skin." } },
        { "type": "step", "settings": { "title": "Press for 10 seconds", "text": "Place the patch over the spot and press from the center out so the edges seal." } },
        { "type": "step", "settings": { "title": "Leave on 6–8 hours", "text": "Wear it for 6–8 hours, or until the patch turns white, which means it has taken in as much fluid as it can hold." } },
        { "type": "step", "settings": { "title": "Peel and swap", "text": "Peel from an edge, toss it, and add a fresh patch if the spot is still there." } }
      ]
    }
  ]
}
{% endschema %}
