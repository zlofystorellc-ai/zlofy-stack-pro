{%- comment -%}
  Ingredients, laid out like the real thing: an exploded "layer stack" drawing (or your own photo) beside numbered layers,
  then the full list printed openly like a pack label.
  EVERYTHING here is a PLACEHOLDER until you replace it with your real formula and label (see the editor note).
  - Layers: key materials in plain words (blocks). Do not describe layers your patch does not have.
  - Full list: product metafield custom.ingredients (multi-line text, one line per ingredient, in label order),
    else the section's "Full ingredient list". It must match the label on your real pack.
  - "Free from": only list what is true and documented for your formula. Empty = not shown.
  No benefit claims beyond covering and protecting a surfaced spot.
{%- endcomment -%}
{%- liquid
  assign full_list = product.metafields.custom.ingredients.value
  if full_list == blank
    assign full_list = section.settings.full_list
  endif
  assign free_items = section.settings.free_from | newline_to_br | split: '<br />'
-%}
{%- if section.blocks.size > 0 or full_list != blank -%}
<section class="apx-ing apx-section" id="ingredients" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-ing__split">
      <div class="apx-ing__visual">
        {%- if section.settings.show_builtin_photo -%}
          <figure class="apx-ing__fig">
            <div class="apx-ing__photo"><img src="{{ 'ap-card-swap.jpg' | asset_url }}" alt="{{ section.settings.builtin_alt | escape }}" width="738" height="1100" loading="lazy"></div>
            {%- if section.settings.photo_caption != blank -%}<figcaption class="apx-ing__cap">{{ section.settings.photo_caption }}</figcaption>{%- endif -%}
          </figure>
        {%- elsif section.settings.image != blank -%}
          <div class="apx-ing__photo">
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 900px) 45vw, 90vw', alt: section.settings.image.alt | default: section.settings.heading }}
          </div>
        {%- elsif section.blocks.size > 0 -%}
          <div class="apx-stack" data-ap-stack aria-hidden="true" style="--n: {{ section.blocks.size }}">
            <div class="apx-stack__scene">
              {%- for block in section.blocks -%}
                {%- assign zi = section.blocks.size | minus: 1 | minus: forloop.index0 -%}
                <span class="apx-stack__layer" style="--i: {{ zi }}"></span>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="apx-ing__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ol class="apx-ing__rows">
            {%- for block in section.blocks -%}
              <li class="apx-ing__row" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <span class="apx-ing__dot" aria-hidden="true">{{ forloop.index }}</span>
                <div>
                  <h3>{{ block.settings.name }}</h3>
                  <p>{{ block.settings.note }}</p>
                </div>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', width: 56, height: 56, class: 'apx-ing__thumb', alt: '' }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
      </div>
    </div>

    {%- liquid
      assign spec_keys = '1,2,3,4' | split: ','
      assign has_specs = false
      for k in spec_keys
        assign vk = 'spec_' | append: k | append: '_value'
        if section.settings[vk] != blank
          assign has_specs = true
        endif
      endfor
    -%}
    {%- if has_specs -%}
      <dl class="apx-ing__specs">
        {%- for k in spec_keys -%}
          {%- assign vk = 'spec_' | append: k | append: '_value' -%}
          {%- assign lk = 'spec_' | append: k | append: '_label' -%}
          {%- if section.settings[vk] != blank -%}
            <div class="apx-ing__spec"><dd>{{ section.settings[vk] }}</dd><dt>{{ section.settings[lk] }}</dt></div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    {%- endif -%}

    {%- if full_list != blank -%}
      <div class="apx-ing__label">
        <p class="apx-ing__label-t">{{ section.settings.full_list_title }}</p>
        <div class="apx-ing__label-b">
          {%- if full_list contains '<' -%}
            {{ full_list }}
          {%- else -%}
            {%- assign list_lines = full_list | strip | newline_to_br | split: '<br />' -%}
            <p>{%- for line in list_lines -%}{%- assign t = line | strip -%}{%- if t != blank -%}{{ t | escape }}{%- unless forloop.last -%}, {% endunless -%}{%- endif -%}{%- endfor -%}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.free_from != blank -%}
          <ul class="apx-ing__free" aria-label="{{ section.settings.free_title | escape }}">
            {%- for item in free_items -%}
              {%- assign fi = item | strip -%}
              {%- if fi != blank -%}<li>{{ fi }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.made_in != blank or section.settings.report_link != blank -%}
      <div class="apx-ing__proof">
        {%- if section.settings.made_in != blank -%}<p class="apx-ing__made">{% render 'ap-icon', name: 'check', size: 18 %}<span>{{ section.settings.made_in }}</span></p>{%- endif -%}
        {%- if section.settings.report_link != blank -%}<a class="apx-ing__report" href="{{ section.settings.report_link }}" target="_blank" rel="noopener">{{ section.settings.report_label | default: 'View the test report' }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign faq_keys = '1,2,3' | split: ','
      assign has_faq = false
      for k in faq_keys
        assign qk = 'faq_' | append: k | append: '_q'
        if section.settings[qk] != blank
          assign has_faq = true
        endif
      endfor
    -%}
    {%- if has_faq -%}
      <div class="apx-ing__faq">
        {%- if section.settings.faq_title != blank -%}<h3 class="apx-ing__faq-t">{{ section.settings.faq_title }}</h3>{%- endif -%}
        {%- for k in faq_keys -%}
          {%- assign qk = 'faq_' | append: k | append: '_q' -%}
          {%- assign ak = 'faq_' | append: k | append: '_a' -%}
          {%- if section.settings[qk] != blank -%}
            <details class="apx-ing__q"><summary>{{ section.settings[qk] }}</summary><p>{{ section.settings[ak] }}</p></details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}<p class="apx-fine apx-center apx-ing__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-ing__split{display:grid;gap:36px;align-items:center}
  .apx-ing__copy .apx-lede{margin:.5rem 0 0}
  .apx-ing__rows{display:grid;gap:0;margin:28px 0 0;padding:0;list-style:none;border-top:1px solid var(--ap-line)}
  .apx-ing__row{--c:var(--ap-blush);display:flex;gap:16px;align-items:center;padding:18px 4px;border-bottom:1px solid var(--ap-line);transition:background .25s,padding .25s}
  .apx-ing__row:nth-child(2){--c:var(--ap-lilac)}
  .apx-ing__row:nth-child(3){--c:var(--ap-apricot)}
  .apx-ing__row:nth-child(4){--c:var(--ap-blush-deep)}
  .apx-ing__row:nth-child(5){--c:var(--ap-ink-soft)}
  .apx-ing__dot{flex:none;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--c);color:var(--ap-ink);font-weight:800}
  .apx-ing__row:nth-child(1) .apx-ing__dot,.apx-ing__row:nth-child(4) .apx-ing__dot,.apx-ing__row:nth-child(5) .apx-ing__dot{color:var(--ap-white)}
  .apx-ing__row h3{margin:0 0 .15rem;font-size:1.125rem}
  .apx-ing__row p{margin:0;color:var(--ap-ink-soft);line-height:1.5}
  .apx-ing__thumb{flex:none;margin-left:auto;width:56px;height:56px;border-radius:16px;object-fit:cover}
  .apx-ing__photo{overflow:hidden;border-radius:28px;background:var(--ap-sand);box-shadow:0 22px 50px rgba(31,42,68,.12);aspect-ratio:4/5;max-width:480px;margin-inline:auto}
  .apx-ing__photo img{display:block;width:100%;height:100%;object-fit:cover}
  /* exploded layer stack */
  .apx-stack{--z:58px;display:grid;place-items:center;min-height:clamp(300px,42vw,440px);perspective:1400px}
  .apx-stack__scene{position:relative;width:min(62vw,300px);aspect-ratio:1;transform-style:preserve-3d;transform:rotateX(58deg) rotateZ(-34deg)}
  .apx-stack__layer{--c:var(--ap-blush);position:absolute;inset:0;border-radius:22%;background:var(--c);box-shadow:inset 0 0 0 2px rgba(255,255,255,.55),0 24px 36px rgba(31,42,68,.18);transform:translateZ(calc(var(--i) * var(--z)));transition:transform 1s cubic-bezier(.2,.7,.2,1) calc(var(--i) * 90ms),filter .3s}
  .apx-stack__layer:nth-child(2){--c:var(--ap-lilac)}
  .apx-stack__layer:nth-child(3){--c:var(--ap-apricot)}
  .apx-stack__layer:nth-child(4){--c:var(--ap-blush-deep)}
  .apx-stack__layer:nth-child(5){--c:var(--ap-ink-soft)}
  .apx-stack.is-folded{--z:4px}
  .apx-ing__split:has(.apx-ing__row:hover) .apx-stack__layer{filter:saturate(.55) opacity(.7)}
  @media (hover:hover){
    .apx-ing__row:hover{background:var(--ap-sand);padding-inline:14px}
    .apx-ing__split:has(.apx-ing__row:nth-child(1):hover) .apx-stack__layer:nth-child(1),
    .apx-ing__split:has(.apx-ing__row:nth-child(2):hover) .apx-stack__layer:nth-child(2),
    .apx-ing__split:has(.apx-ing__row:nth-child(3):hover) .apx-stack__layer:nth-child(3),
    .apx-ing__split:has(.apx-ing__row:nth-child(4):hover) .apx-stack__layer:nth-child(4),
    .apx-ing__split:has(.apx-ing__row:nth-child(5):hover) .apx-stack__layer:nth-child(5){filter:none}
  }
  /* label */
  .apx-ing__label{max-width:860px;margin:clamp(32px,5vw,56px) auto 0;padding:22px 26px;border:2px solid var(--ap-ink);border-radius:6px;background:var(--ap-white)}
  .apx-ing__label-t{margin:0 0 .5rem;padding-bottom:.5rem;border-bottom:4px solid var(--ap-ink);font-size:1.5rem;font-weight:800;letter-spacing:-.01em;line-height:1.1}
  .apx-ing__label-b{color:var(--ap-ink);font-size:.9375rem;line-height:1.6}
  .apx-ing__label-b p{margin:0}
  .apx-ing__free{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 0;padding:0;list-style:none}
  .apx-ing__free li{padding:.35rem .8rem;border:1px solid var(--ap-line);border-radius:999px;background:var(--ap-sand);color:var(--ap-blush-deep);font-size:.8125rem;font-weight:700}
  .apx-ing__fig{margin:0}
  .apx-ing__cap{margin:10px 0 0;text-align:center;color:var(--ap-ink-soft);font-size:.8125rem}
  .apx-ing__specs{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;max-width:860px;margin:clamp(28px,4vw,44px) auto 0}
  .apx-ing__spec{padding:16px;border:1px solid var(--ap-line);border-radius:18px;background:var(--ap-white);text-align:center;box-shadow:0 8px 22px rgba(31,42,68,.05)}
  .apx-ing__spec dd{margin:0;font-family:var(--ap-font-display);font-size:1.75rem;line-height:1.1;color:var(--ap-ink)}
  .apx-ing__spec dt{margin:.25rem 0 0;color:var(--ap-ink-soft);font-size:.8125rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .apx-ing__proof{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px 28px;max-width:860px;margin:22px auto 0}
  .apx-ing__made{display:inline-flex;align-items:center;gap:.5rem;margin:0;font-weight:700}
  .apx-ing__made .apx-icon{color:var(--ap-blush-deep)}
  .apx-ing__report{color:var(--ap-blush-deep);font-weight:800;text-decoration:none;border-bottom:2px solid var(--ap-blush)}
  .apx-ing__faq{max-width:860px;margin:clamp(24px,3vw,40px) auto 0}
  .apx-ing__faq-t{margin:0 0 10px;text-align:center;font-size:1.25rem}
  .apx-ing__q{border-bottom:1px solid var(--ap-line)}
  .apx-ing__q summary{cursor:pointer;padding:14px 4px;font-weight:700;list-style:none}
  .apx-ing__q summary::-webkit-details-marker{display:none}
  .apx-ing__q summary::after{content:"+";float:right;color:var(--ap-blush-deep);font-weight:800}
  .apx-ing__q[open] summary::after{content:"\2212"}
  .apx-ing__q p{margin:0 0 14px;padding:0 4px;color:var(--ap-ink-soft);line-height:1.6}
  .apx-ing__note{margin-top:14px}
  @media (min-width:900px){.apx-ing__split{grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:72px}}
  @media (prefers-reduced-motion:reduce){.apx-stack__layer{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Editor note: every default here is a placeholder. Replace the layers, the intro and the full list with your real formula, and keep the list identical to the label on your pack. Do not describe layers or materials your patch does not have." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the patch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the patch is made of" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "What is in the patch, in plain words. The full label is below, exactly as printed on the pack."
    },
    { "type": "checkbox", "id": "show_builtin_photo", "label": "Show the built-in demonstration photo", "default": true, "info": "An AI-generated photo of a used patch (white in the middle) beside a fresh one. It is NOT a real customer. Turn off to use your own photo or the layer drawing." },
    { "type": "text", "id": "photo_caption", "label": "Photo caption", "default": "Demonstration photo" },
    { "type": "text", "id": "builtin_alt", "label": "Built-in photo description", "default": "A used patch that has turned white in the middle beside a fresh clear patch, each held on a fingertip" },
    { "type": "image_picker", "id": "image", "label": "Photo (optional)", "info": "Optional. When set (and the built-in photo is off), your photo replaces the layer drawing. Upload only images you own or have licensed." },
    { "type": "text", "id": "full_list_title", "label": "Label title", "default": "Ingredients" },
    { "type": "textarea", "id": "free_from", "label": "Free from (optional, one per line)", "info": "Only list what is true and documented for your formula. Leave empty to hide." },
    { "type": "text", "id": "free_title", "label": "Free-from label (screen readers)", "default": "Free from" },
    {
      "type": "textarea",
      "id": "full_list",
      "label": "Full ingredient list",
      "info": "Used when the product metafield custom.ingredients is empty. Must match the label on your pack, in the same order."
    },
    { "type": "header", "content": "Facts at a glance (hidden when empty)" },
    { "type": "text", "id": "spec_1_value", "label": "Fact 1 value", "info": "Only numbers you measured or your supplier confirmed, for example \"6 mm\"." },
    { "type": "text", "id": "spec_1_label", "label": "Fact 1 label", "default": "Diameter" },
    { "type": "text", "id": "spec_2_value", "label": "Fact 2 value" },
    { "type": "text", "id": "spec_2_label", "label": "Fact 2 label", "default": "Thickness" },
    { "type": "text", "id": "spec_3_value", "label": "Fact 3 value" },
    { "type": "text", "id": "spec_3_label", "label": "Fact 3 label", "default": "Patches per kit" },
    { "type": "text", "id": "spec_4_value", "label": "Fact 4 value" },
    { "type": "text", "id": "spec_4_label", "label": "Fact 4 label", "default": "Wear time" },
    { "type": "header", "content": "Proof (hidden when empty)" },
    { "type": "text", "id": "made_in", "label": "Where it is made and packed", "info": "Only if true, for example \"Made in ___, packed in the USA\"." },
    { "type": "url", "id": "report_link", "label": "Test report or safety document link", "info": "Link to a real document from your supplier or lab. Leave empty to hide." },
    { "type": "text", "id": "report_label", "label": "Link text", "default": "View the test report" },
    { "type": "header", "content": "Questions (hidden when empty)" },
    { "type": "text", "id": "faq_title", "label": "Questions heading", "default": "Good to know" },
    { "type": "text", "id": "faq_1_q", "label": "Question 1", "default": "Should I patch test first?" },
    { "type": "textarea", "id": "faq_1_a", "label": "Answer 1", "default": "If your skin is sensitive, try one patch on a small area first. Stop using it and ask a doctor if you notice irritation." },
    { "type": "text", "id": "faq_2_q", "label": "Question 2", "default": "What if it will not stick?" },
    { "type": "textarea", "id": "faq_2_a", "label": "Answer 2", "default": "Patches stick best to clean, dry skin. Wash and pat dry, then press the patch on from the center out. Skip creams or oils on the spot first." },
    { "type": "text", "id": "faq_3_q", "label": "Question 3", "default": "Where can I see the full ingredient list?" },
    { "type": "textarea", "id": "faq_3_a", "label": "Answer 3", "default": "It is printed on the pack and shown above. The two always match." },
    { "type": "text", "id": "note", "label": "Small print (optional)", "default": "For external use only. Check the label on your pack." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient card",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Hydrocolloid layer" },
        { "type": "textarea", "id": "note", "label": "What it is", "default": "A soft, flexible layer that sits on the skin and covers the spot." },
        { "type": "image_picker", "id": "image", "label": "Small photo (optional)", "info": "Upload only images you own or have licensed." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Hydrocolloid", "note": "A soft, gel-forming material. It takes in fluid from the surface of a spot and keeps the area covered." } }
      ]
    }
  ]
}
{% endschema %}
