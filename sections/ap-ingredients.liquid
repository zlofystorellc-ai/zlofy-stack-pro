{%- comment -%}
  Ingredients, laid out like the real thing: an exploded "layer stack" drawing (or your own photo) beside numbered layers,
  then the full list printed openly like a pack label.
  EVERYTHING here is a PLACEHOLDER until you replace it with your real formula and label (see the editor note).
  - Layers: key materials in plain words (blocks). Do not describe layers your patch does not have.
  - Full list: product metafield custom.ingredients (multi-line text, one line per ingredient, in label order),
    else the section's "Full ingredient list". It must match the label on your real pack.
  - "Free from": only list what is true and documented for your formula. Empty = not shown.
  No benefit claims beyond covering and protecting a surfaced spot.
{%- endcomment -%}
{%- liquid
  assign full_list = product.metafields.custom.ingredients.value
  if full_list == blank
    assign full_list = section.settings.full_list
  endif
  assign free_items = section.settings.free_from | newline_to_br | split: '<br />'
-%}
{%- if section.blocks.size > 0 or full_list != blank -%}
<section class="apx-ing apx-section" id="ingredients" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-ing__split">
      <div class="apx-ing__visual">
        {%- if section.settings.image != blank -%}
          <div class="apx-ing__photo">
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 900px) 45vw, 90vw', alt: section.settings.image.alt | default: section.settings.heading }}
          </div>
        {%- elsif section.blocks.size > 0 -%}
          <div class="apx-stack" data-ap-stack aria-hidden="true" style="--n: {{ section.blocks.size }}">
            <div class="apx-stack__scene">
              {%- for block in section.blocks -%}
                {%- assign zi = section.blocks.size | minus: 1 | minus: forloop.index0 -%}
                <span class="apx-stack__layer" style="--i: {{ zi }}"></span>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="apx-ing__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ol class="apx-ing__rows">
            {%- for block in section.blocks -%}
              <li class="apx-ing__row" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <span class="apx-ing__dot" aria-hidden="true">{{ forloop.index }}</span>
                <div>
                  <h3>{{ block.settings.name }}</h3>
                  <p>{{ block.settings.note }}</p>
                </div>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', width: 56, height: 56, class: 'apx-ing__thumb', alt: '' }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
      </div>
    </div>

    {%- if full_list != blank -%}
      <div class="apx-ing__label">
        <p class="apx-ing__label-t">{{ section.settings.full_list_title }}</p>
        <div class="apx-ing__label-b">
          {%- if full_list contains '<' -%}
            {{ full_list }}
          {%- else -%}
            {%- assign list_lines = full_list | strip | newline_to_br | split: '<br />' -%}
            <p>{%- for line in list_lines -%}{%- assign t = line | strip -%}{%- if t != blank -%}{{ t | escape }}{%- unless forloop.last -%}, {% endunless -%}{%- endif -%}{%- endfor -%}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.free_from != blank -%}
          <ul class="apx-ing__free" aria-label="{{ section.settings.free_title | escape }}">
            {%- for item in free_items -%}
              {%- assign fi = item | strip -%}
              {%- if fi != blank -%}<li>{{ fi }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}<p class="apx-fine apx-center apx-ing__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-ing__split{display:grid;gap:36px;align-items:center}
  .apx-ing__copy .apx-lede{margin:.5rem 0 0}
  .apx-ing__rows{display:grid;gap:0;margin:28px 0 0;padding:0;list-style:none;border-top:1px solid var(--ap-line)}
  .apx-ing__row{--c:var(--ap-accent);display:flex;gap:16px;align-items:center;padding:18px 4px;border-bottom:1px solid var(--ap-line);transition:background .25s,padding .25s}
  .apx-ing__row:nth-child(2){--c:var(--ap-lilac)}
  .apx-ing__row:nth-child(3){--c:var(--ap-apricot)}
  .apx-ing__row:nth-child(4){--c:var(--ap-accent-text)}
  .apx-ing__row:nth-child(5){--c:var(--ap-ink-soft)}
  .apx-ing__dot{flex:none;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--c);color:var(--ap-ink);font-weight:800}
  .apx-ing__row:nth-child(1) .apx-ing__dot,.apx-ing__row:nth-child(4) .apx-ing__dot,.apx-ing__row:nth-child(5) .apx-ing__dot{color:var(--ap-on-dark)}
  .apx-ing__row h3{margin:0 0 .15rem;font-size:1.125rem}
  .apx-ing__row p{margin:0;color:var(--ap-ink-soft);line-height:1.5}
  .apx-ing__thumb{flex:none;margin-left:auto;width:56px;height:56px;border-radius:16px;object-fit:cover}
  .apx-ing__photo{overflow:hidden;border-radius:28px;background:var(--ap-sand);box-shadow:0 22px 50px rgba(31,42,68,.12);aspect-ratio:4/5;max-width:480px;margin-inline:auto}
  .apx-ing__photo img{display:block;width:100%;height:100%;object-fit:cover}
  /* exploded layer stack */
  .apx-stack{--z:58px;display:grid;place-items:center;min-height:clamp(300px,42vw,440px);perspective:1400px}
  .apx-stack__scene{position:relative;width:min(62vw,300px);aspect-ratio:1;transform-style:preserve-3d;transform:rotateX(58deg) rotateZ(-34deg)}
  .apx-stack__layer{--c:var(--ap-accent);position:absolute;inset:0;border-radius:22%;background:var(--c);box-shadow:inset 0 0 0 2px rgba(255,255,255,.55),0 24px 36px rgba(31,42,68,.18);transform:translateZ(calc(var(--i) * var(--z)));transition:transform 1s cubic-bezier(.2,.7,.2,1) calc(var(--i) * 90ms),filter .3s}
  .apx-stack__layer:nth-child(2){--c:var(--ap-lilac)}
  .apx-stack__layer:nth-child(3){--c:var(--ap-apricot)}
  .apx-stack__layer:nth-child(4){--c:var(--ap-accent-text)}
  .apx-stack__layer:nth-child(5){--c:var(--ap-ink-soft)}
  .apx-stack.is-folded{--z:4px}
  .apx-ing__split:has(.apx-ing__row:hover) .apx-stack__layer{filter:saturate(.55) opacity(.7)}
  @media (hover:hover){
    .apx-ing__row:hover{background:var(--ap-sand);padding-inline:14px}
    .apx-ing__split:has(.apx-ing__row:nth-child(1):hover) .apx-stack__layer:nth-child(1),
    .apx-ing__split:has(.apx-ing__row:nth-child(2):hover) .apx-stack__layer:nth-child(2),
    .apx-ing__split:has(.apx-ing__row:nth-child(3):hover) .apx-stack__layer:nth-child(3),
    .apx-ing__split:has(.apx-ing__row:nth-child(4):hover) .apx-stack__layer:nth-child(4),
    .apx-ing__split:has(.apx-ing__row:nth-child(5):hover) .apx-stack__layer:nth-child(5){filter:none}
  }
  /* label */
  .apx-ing__label{max-width:860px;margin:clamp(32px,5vw,56px) auto 0;padding:22px 26px;border:2px solid var(--ap-ink);border-radius:6px;background:var(--ap-white)}
  .apx-ing__label-t{margin:0 0 .5rem;padding-bottom:.5rem;border-bottom:4px solid var(--ap-ink);font-size:1.5rem;font-weight:800;letter-spacing:-.01em;line-height:1.1}
  .apx-ing__label-b{color:var(--ap-ink);font-size:.9375rem;line-height:1.6}
  .apx-ing__label-b p{margin:0}
  .apx-ing__free{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 0;padding:0;list-style:none}
  .apx-ing__free li{padding:.35rem .8rem;border:1px solid var(--ap-line);border-radius:999px;background:var(--ap-sand);color:var(--ap-accent-text);font-size:.8125rem;font-weight:700}
  .apx-ing__note{margin-top:14px}
  @media (min-width:900px){.apx-ing__split{grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:72px}}
  @media (prefers-reduced-motion:reduce){.apx-stack__layer{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Editor note: every default here is a placeholder. Replace the layers, the intro and the full list with your real formula, and keep the list identical to the label on your pack. Do not describe layers or materials your patch does not have." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the patch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the patch is made of" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Three thin layers, each with one job: cover the spot, keep it protected and stay put."
    },
    { "type": "image_picker", "id": "image", "label": "Photo (optional)", "info": "Optional. When set, your photo replaces the layer drawing. Upload only images you own or have licensed." },
    { "type": "text", "id": "full_list_title", "label": "Label title", "default": "Ingredients" },
    { "type": "textarea", "id": "free_from", "label": "Free from (optional, one per line)", "info": "Only list what is true and documented for your formula. Leave empty to hide." },
    { "type": "text", "id": "free_title", "label": "Free-from label (screen readers)", "default": "Free from" },
    {
      "type": "textarea",
      "id": "full_list",
      "label": "Full ingredient list",
      "info": "Used when the product metafield custom.ingredients is empty. Must match the label on your pack, in the same order."
    },
    { "type": "text", "id": "note", "label": "Small print (optional)", "default": "For external use only. Check the label on your pack." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient card",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Hydrocolloid layer" },
        { "type": "textarea", "id": "note", "label": "What it is", "default": "A soft, flexible layer that sits on the skin and covers the spot." },
        { "type": "image_picker", "id": "image", "label": "Small photo (optional)", "info": "Upload only images you own or have licensed." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Hydrocolloid layer", "note": "A soft, flexible layer that sits on the skin and covers the spot." } },
        { "type": "ingredient", "settings": { "name": "Breathable film", "note": "A thin outer film that keeps the patch smooth and in place." } },
        { "type": "ingredient", "settings": { "name": "Skin-friendly adhesive", "note": "Holds the patch on until you peel it off." } }
      ]
    }
  ]
}
{% endschema %}
