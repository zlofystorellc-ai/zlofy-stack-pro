{%- comment -%}
  Ingredients. Everything here is a PLACEHOLDER until you replace it with your real formula.
  - Cards: key materials in plain words (blocks).
  - Full list: product metafield custom.ingredients (multi-line text, one line per ingredient, in the order on your label),
    else the section's "Full ingredient list" setting. Must match the label on your real pack.
  Do not name ingredients you do not use. No benefit claims beyond covering and protecting a surfaced spot.
{%- endcomment -%}
{%- liquid
  assign full_list = product.metafields.custom.ingredients.value
  if full_list == blank
    assign full_list = section.settings.full_list
  endif
-%}
{%- if section.blocks.size > 0 or full_list != blank -%}
<section class="apx-ing apx-section" id="ingredients" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="apx-ing__grid">
        {%- for block in section.blocks -%}
          <li class="apx-ing__card" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.name }}</h3>
            <p>{{ block.settings.note }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if full_list != blank -%}
      <details class="apx-ing__full">
        <summary><span>{{ section.settings.full_list_title }}</span>{% render 'ap-icon', name: 'chevron', size: 20 %}</summary>
        <div class="apx-ing__list">
          {%- if full_list contains '<' -%}{{ full_list }}{%- else -%}<p>{{ full_list | escape | newline_to_br }}</p>{%- endif -%}
        </div>
      </details>
    {%- endif -%}

    {%- if section.settings.note != blank -%}<p class="apx-fine apx-center">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-ing__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:28px}
  .apx-ing__card{padding:22px 22px;border:1px solid var(--ap-line);border-radius:var(--ap-radius);background:var(--ap-white)}
  .apx-ing__card h3{margin:0 0 .35rem;font-size:1.125rem}
  .apx-ing__card p{margin:0;color:var(--ap-ink-soft)}
  .apx-ing__full{max-width:820px;margin:20px auto 0;border-top:1px solid var(--ap-line);border-bottom:1px solid var(--ap-line)}
  .apx-ing__full summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:56px;font-weight:600;cursor:pointer;list-style:none}
  .apx-ing__full summary::-webkit-details-marker{display:none}
  .apx-ing__full[open] summary .apx-icon{transform:rotate(180deg)}
  .apx-ing__list{padding-bottom:16px;color:var(--ap-ink-soft)}
  .apx-ing__list p:last-child{margin-bottom:0}
  .apx-ing .apx-fine{margin-top:14px}
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ingredients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the patch is made of" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "A short, plain-language look at the materials. Example text: replace it with your real formula before publishing."
    },
    { "type": "text", "id": "full_list_title", "label": "Full list title", "default": "Full ingredient list" },
    {
      "type": "textarea",
      "id": "full_list",
      "label": "Full ingredient list",
      "info": "Used when the product metafield custom.ingredients is empty. Must match the label on your pack, in the same order."
    },
    { "type": "text", "id": "note", "label": "Small print (optional)", "default": "For external use only. Check the label on your pack." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient card",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Hydrocolloid layer" },
        { "type": "textarea", "id": "note", "label": "What it is", "default": "A soft, flexible layer that sits on the skin and covers the spot." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Hydrocolloid layer", "note": "A soft, flexible layer that sits on the skin and covers the spot." } },
        { "type": "ingredient", "settings": { "name": "Breathable film", "note": "A thin outer film that keeps the patch smooth and in place." } },
        { "type": "ingredient", "settings": { "name": "Skin-friendly adhesive", "note": "Holds the patch on until you peel it off." } }
      ]
    }
  ]
}
{% endschema %}
