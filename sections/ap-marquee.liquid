{%- comment -%}
  Slim ticker of short product facts. Slides slowly, pauses on hover/focus, and is static with reduced-motion.
  List only facts that are true for your product.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="apx-band-text" aria-label="{{ section.settings.label | escape }}">
  <div class="apx-band-text__track">
    {%- for copy in (1..3) -%}
      <ul class="apx-band-text__list"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        {%- for block in section.blocks -%}
          <li {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-band-text{overflow:hidden;background:var(--ap-dark);color:var(--ap-on-dark)}
  .apx-band-text__track{display:flex;width:max-content;animation:apx-tick 34s linear infinite}
  .apx-band-text:hover .apx-band-text__track,.apx-band-text:focus-within .apx-band-text__track{animation-play-state:paused}
  .apx-band-text__list{display:flex;flex:none;margin:0;padding:14px 0;list-style:none;font-size:.8125rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}
  .apx-band-text__list li{display:flex;align-items:center;gap:2rem;padding-right:2rem}
  .apx-band-text__list li::after{content:"";width:6px;height:6px;border-radius:50%;background:var(--ap-accent)}
  @keyframes apx-tick{to{transform:translateX(-33.3333%)}}
  @media (prefers-reduced-motion:reduce){
    .apx-band-text__track{width:auto;justify-content:center;animation:none}
    .apx-band-text__list:not(:first-child){display:none}
    .apx-band-text__list{flex-wrap:wrap;justify-content:center;white-space:normal}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Facts band",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Product facts" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Drug-free hydrocolloid" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Facts band",
      "blocks": [
        { "type": "fact", "settings": { "text": "Drug-free hydrocolloid" } },
        { "type": "fact", "settings": { "text": "Day and night patches" } },
        { "type": "fact", "settings": { "text": "Three sizes" } },
        { "type": "fact", "settings": { "text": "For external use" } }
      ]
    }
  ]
}
{% endschema %}
