{%- comment -%}
  Page banner for content pages (like "How it works"): small pill, big title (the page title unless you type one), intro,
  and a "Shop now" button that goes to the product you pick (falls back to all products).
  Cosmetic wording only.
{%- endcomment -%}
{%- assign shop_link = section.settings.product.url | default: '/collections/all' -%}
<section class="apx-pb" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap apx-pb__wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="apx-pb__pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="apx-pb__h" id="{{ section.id }}-title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}<p class="apx-pb__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p class="apx-pb__cta"><a class="apx-btn" href="{{ shop_link }}">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<p class="apx-pb__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .apx-pb{position:relative;isolation:isolate;overflow-x:clip;padding-block:clamp(48px,8vw,104px);background:linear-gradient(180deg,var(--ap-sand),var(--ap-white));text-align:center}
  .apx-pb::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(520px 340px at 10% 10%,rgba(249,93,117,.16),transparent 70%),radial-gradient(480px 320px at 90% 0%,rgba(205,184,255,.3),transparent 70%)}
  .apx-pb__wrap{max-width:820px}
  .apx-pb__pill{display:inline-block;margin:0 0 18px;padding:.45rem 1rem;border:1.5px solid var(--ap-blush-deep);border-radius:999px;background:var(--ap-white);color:var(--ap-blush-deep);font-size:.8125rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .apx-pb__h{margin:0;font-size:clamp(2.5rem,7vw,4.5rem);line-height:1.04;letter-spacing:-.02em}
  .apx-pb__text{max-width:36em;margin:20px auto 0;font-size:clamp(1.0625rem,2vw,1.25rem);line-height:1.6;color:var(--ap-ink-soft)}
  .apx-pb__cta{margin:28px 0 0}
  .apx-pb__cta .apx-btn{min-height:56px;padding-inline:2.25rem;font-size:1.0625rem}
  .apx-pb__note{margin:14px 0 0;font-size:.875rem;color:var(--ap-ink-soft)}
{% endstylesheet %}

{% schema %}
{
  "name": "Page banner",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Pill label", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "text", "label": "Intro" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "product", "id": "product", "label": "Product for the button", "info": "Leave empty to link to all products." },
    { "type": "text", "id": "note", "label": "Small line under the button (optional)", "info": "Only state offers and guarantees that are true, for example your real return window." }
  ],
  "presets": [ { "name": "Page banner" } ]
}
{% endschema %}
