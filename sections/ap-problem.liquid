{%- comment -%}
  "A spot's day" timeline: each moment of the day shows the real annoyance and, right under it, what helps.
  Empathetic, not fear-based. Cosmetic wording only; keep every line true for your product.
{%- endcomment -%}
<section class="apx-prob apx-prob--{{ section.settings.photo_shape }} apx-section" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede apx-prob__lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <ol class="apx-prob__steps" data-ap-dots style="--n: {{ section.blocks.size }}">
      <li class="apx-prob__line" aria-hidden="true"></li>
      {%- for block in section.blocks -%}
        <li class="apx-prob__step" {{ block.shopify_attributes }}>
          {%- if block.settings.time != blank -%}<p class="apx-prob__time">{{ block.settings.time }}</p>{%- endif -%}
          <span class="apx-prob__node" aria-hidden="true">{% render 'ap-icon', name: block.settings.icon, size: 24 %}</span>
          {%- if block.settings.builtin_photo != blank -%}
            <div class="apx-prob__photo">
              <img src="{{ block.settings.builtin_photo | asset_url }}" alt="{{ block.settings.photo_alt | escape }}" width="738" height="1100" loading="lazy">
            </div>
          {%- elsif block.settings.image != blank -%}
            <div class="apx-prob__photo">
              {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 900px) 24vw, 80vw', alt: block.settings.image.alt | default: block.settings.title }}
            </div>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p class="apx-prob__moment">{{ block.settings.text }}</p>
          {%- if block.settings.fix != blank -%}
            <p class="apx-prob__fix">{% render 'ap-icon', name: 'check', size: 18 %}<span>{{ block.settings.fix }}</span></p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.photo_note != blank -%}<p class="apx-fine apx-center apx-prob__note">{{ section.settings.photo_note }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p class="apx-center apx-prob__cta"><a class="apx-prob__btn" href="{{ section.settings.button_link | default: '#buy' }}">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
    {%- if section.settings.show_trust -%}
      {%- assign trust_alt = section.settings.trust_1 | append: ', ' | append: section.settings.trust_2 | append: ', ' | append: section.settings.trust_3 -%}
      <div class="apx-prob__trust{% if section.settings.trust_use_image %} apx-prob__trust--img{% endif %}">
        {%- if section.settings.trust_use_image -%}
          <img class="apx-prob__trust-img" src="{{ 'ap-trust-strip.png' | asset_url }}" alt="{{ trust_alt | escape }}" width="1860" height="216" loading="lazy">
        {%- endif -%}
        <ul class="apx-prob__trust-list">
          <li>{% render 'ap-icon', name: 'truck', size: 20 %}<span>{{ section.settings.trust_1 }}</span></li>
          <li>{% render 'ap-icon', name: 'heart', size: 20 %}<span>{{ section.settings.trust_2 }}</span></li>
          <li>{% render 'ap-icon', name: 'shield', size: 20 %}<span>{{ section.settings.trust_3 }}</span></li>
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .apx-prob__lede{margin-inline:auto}
  .apx-prob__steps{position:relative;display:grid;gap:0;margin:clamp(32px,5vw,56px) 0 0;padding:0;list-style:none}
  .apx-prob__line{position:absolute;left:23px;top:24px;bottom:24px;width:2px;background:linear-gradient(var(--ap-blush),var(--ap-lilac),var(--ap-apricot));border-radius:2px;transform-origin:top;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
  .is-folded .apx-prob__line{transform:scaleY(0)}
  .apx-prob__step{position:relative;padding:0 0 32px 72px}
  .apx-prob__step:last-child{padding-bottom:0}
  .apx-prob__node{position:absolute;left:0;top:0;display:grid;place-items:center;width:48px;height:48px;border:2px solid var(--ap-blush);border-radius:50%;background:var(--ap-white);color:var(--ap-blush-deep)}
  .apx-prob__time{margin:0 0 6px;color:var(--ap-blush-deep);font-size:.75rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;padding-top:2px}
  .apx-prob__photo{overflow:hidden;margin:0 0 16px;border-radius:12px;background:var(--ap-sand);aspect-ratio:3/4;box-shadow:0 14px 30px rgba(31,42,68,.1)}
  @media (max-width:899px){.apx-prob--portrait .apx-prob__photo{aspect-ratio:4/3}}
  .apx-prob--landscape .apx-prob__photo{aspect-ratio:16/10}
  .apx-prob--square .apx-prob__photo{aspect-ratio:1}
  .apx-prob__photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  @media (hover:hover){.apx-prob__step:hover .apx-prob__photo img{transform:scale(1.05)}}
  .apx-prob__step h3{margin:0 0 .35rem;font-size:1.25rem}
  .apx-prob__moment{margin:0;color:var(--ap-ink-soft);line-height:1.6}
  .apx-prob__fix{display:flex;gap:10px;align-items:flex-start;margin:14px 0 0;padding:12px 14px;border-radius:14px;background:var(--ap-sand);color:var(--ap-ink);font-weight:600;line-height:1.5}
  .apx-prob__fix .apx-icon{flex:none;margin-top:2px;color:var(--ap-blush-deep)}
  .apx-prob__photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 42%}
  .apx-prob__note{margin:20px 0 0}
  .apx-prob__cta{margin-top:clamp(28px,4vw,48px)}
  .apx-prob__trust{max-width:920px;margin:clamp(24px,3vw,36px) auto 0}
  .apx-prob__trust-img{display:none;width:100%;height:auto;mix-blend-mode:multiply}
  .apx-prob__trust-list{display:grid;gap:12px;justify-content:center;margin:0;padding:0;list-style:none}
  .apx-prob__trust-list li{display:flex;align-items:center;gap:.7rem;font-weight:700;color:var(--ap-ink)}
  .apx-prob__trust-list .apx-icon{flex:none;width:36px;height:36px;padding:8px;border-radius:50%;background:#FFE9ED;color:var(--ap-blush-deep)}
  @media (min-width:700px){
    .apx-prob__trust-list{grid-auto-flow:column;gap:12px 32px}
    .apx-prob__trust--img .apx-prob__trust-img{display:block}
    .apx-prob__trust--img .apx-prob__trust-list{display:none}
  }
  .apx-prob__btn{display:inline-flex;align-items:center;min-height:56px;padding:0 2.25rem;border-radius:999px;background:var(--ap-blush-deep);color:var(--ap-white);font-weight:800;text-decoration:none;transition:transform .25s,box-shadow .25s}
  .apx-prob__btn:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(179,56,75,.35)}
  .apx-prob__btn:focus-visible{outline:3px solid var(--ap-ink);outline-offset:3px}
  @media (min-width:600px) and (max-width:899px){
    .apx-prob__steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 28px}
    .apx-prob__line{display:none}
    .apx-prob__step{padding:0}
    .apx-prob__node{position:static;margin-bottom:12px}
    .apx-prob__time{position:static;margin:0 0 6px}
  }
  @media (min-width:900px){
    .apx-prob__steps{grid-template-columns:repeat(var(--n,4),minmax(0,1fr));gap:28px}
    .apx-prob__line{left:24px;right:calc(100% / var(--n,4) - 24px);top:51px;bottom:auto;width:auto;height:2px;background:linear-gradient(90deg,var(--ap-blush),var(--ap-lilac),var(--ap-apricot));transform-origin:left}
    .is-folded .apx-prob__line{transform:scaleX(0)}
    .apx-prob__step{padding:92px 0 0}
    .apx-prob__node{left:0;top:28px}
    .apx-prob__time{position:absolute;left:0;top:0;margin:0}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Problem",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A spot's day" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spots happen. Picking shouldn't be your only plan." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "A spot shows up right before something big, and your fingers have opinions. You are not alone, and there is a gentler habit to try."
    },
    { "type": "select", "id": "photo_shape", "label": "Photo shape", "options": [ { "value": "portrait", "label": "Portrait rectangle (3:4)" }, { "value": "landscape", "label": "Landscape rectangle (16:10)" }, { "value": "square", "label": "Square" } ], "default": "portrait" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find your kit" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to scroll to the buy box." },
    { "type": "text", "id": "photo_note", "label": "Photo note (small print)", "info": "Shown under the cards. Clear it once all photos are your own real photos.", "default": "Photos are illustrative demonstrations, not customer testimonials." },
    { "type": "header", "content": "Trust line under the button" },
    { "type": "checkbox", "id": "show_trust", "label": "Show the trust line", "default": true },
    { "type": "text", "id": "trust_1", "label": "Point 1", "default": "Free US shipping on kits" },
    { "type": "text", "id": "trust_2", "label": "Point 2", "default": "US-based support" },
    { "type": "text", "id": "trust_3", "label": "Point 3", "default": "Secure checkout" },
    { "type": "checkbox", "id": "trust_use_image", "label": "Use the picture strip on larger screens", "default": true, "info": "The picture shows the default wording. If you change the points above, untick this so the text version is used on every screen. Say only what is true for your store." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "hand", "label": "Hand" },
            { "value": "clock", "label": "Clock" },
            { "value": "layers", "label": "Layers" },
            { "value": "sun", "label": "Sun" },
            { "value": "moon", "label": "Moon" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "hand"
        },
        { "type": "select", "id": "builtin_photo", "label": "Built-in sample photo", "info": "An AI-generated demonstration photo. It is NOT a real customer. Set to None to use your own photo below.", "options": [ { "value": "", "label": "None" }, { "value": "ap-card-morning.jpg", "label": "Morning: holding a patch by a small spot" }, { "value": "ap-card-midday.jpg", "label": "Midday: pressing a patch onto a small spot" }, { "value": "ap-card-night.jpg", "label": "Night: a patch on the chin in bed" }, { "value": "ap-card-swap.jpg", "label": "Next morning: a used patch beside a fresh one" } ], "default": "" },
        { "type": "text", "id": "photo_alt", "label": "Built-in photo description", "default": "An adult in a bathroom mirror holding a thin round patch next to a small spot on the chin" },
        { "type": "image_picker", "id": "image", "label": "Photo (optional)", "info": "Shown above the moment. Upload only photos you own or have licensed, ideally of real people who gave permission." },
        { "type": "text", "id": "time", "label": "Time of day", "default": "Midday" },
        { "type": "text", "id": "title", "label": "Moment", "default": "The picking loop" },
        { "type": "textarea", "id": "text", "label": "The annoyance", "default": "Hands find the spot before your brain catches up." },
        { "type": "textarea", "id": "fix", "label": "What helps", "default": "A patch gives your fingers something else to find.", "info": "Keep it true for your product. Cosmetic wording only." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem",
      "blocks": [
        { "type": "point", "settings": { "icon": "sun", "builtin_photo": "ap-card-morning.jpg", "time": "Morning", "title": "Before the big day", "text": "Photos, dates, interviews. A spot likes to show up right before them.", "fix": "A thin, low-shine day patch sits close to the skin so you can get on with your day." } },
        { "type": "point", "settings": { "icon": "hand", "builtin_photo": "ap-card-midday.jpg", "photo_alt": "A fingertip pressing a thin round patch onto a small spot on the chin", "time": "Midday", "title": "The picking loop", "text": "Hands find the spot before your brain catches up.", "fix": "A patch gives your fingers something else to find." } },
        { "type": "point", "settings": { "icon": "moon", "builtin_photo": "ap-card-night.jpg", "photo_alt": "An adult lying in bed at night with a thin round patch on a small spot on the chin", "time": "Night", "title": "Patches that slide off", "text": "Edges lift, patches curl, and one ends up on your pillow instead of your face.", "fix": "The night patch is thicker and more cushioned, so it stays put while you sleep." } },
        { "type": "point", "settings": { "icon": "clock", "builtin_photo": "ap-card-swap.jpg", "photo_alt": "A used patch that has turned white in the middle beside a fresh clear patch, each held on a fingertip", "time": "Next morning", "title": "Check, then swap", "text": "A patch that has turned white has taken in as much fluid as it can hold.", "fix": "Peel it, toss it, and add a fresh one if the spot is still there." } }
      ]
    }
  ]
}
{% endschema %}
