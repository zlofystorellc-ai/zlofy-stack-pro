{%- assign buy_fallback = '#buy' -%}{%- if template.name == 'index' -%}{%- assign buy_fallback = collections.all.products.first.url | default: '/collections/all' -%}{%- endif -%}
{%- comment -%}
  "A spot's day" timeline: each moment of the day shows the real annoyance and, right under it, what helps.
  Empathetic, not fear-based. Cosmetic wording only; keep every line true for your product.
{%- endcomment -%}
<section class="apx-prob apx-prob--{{ section.settings.photo_shape }}{% if section.settings.step_numbers %} apx-prob--numbered{% endif %} apx-section" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede apx-prob__lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if section.settings.pain_list != blank -%}
      {%- assign pains = section.settings.pain_list | newline_to_br | split: '<br />' -%}
      <div class="apx-prob__pains">
        {%- if section.settings.pain_title != blank -%}<p class="apx-prob__pains-t">{{ section.settings.pain_title }}</p>{%- endif -%}
        <ul class="apx-prob__pains-l">
          {%- for pain in pains -%}
            {%- assign pt = pain | strip -%}
            {%- if pt != blank -%}<li>{% render 'ap-icon', name: 'x', size: 14 %}<span>{{ pt }}</span></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <ol class="apx-prob__steps" data-ap-dots style="--n: {{ section.blocks.size }}">
      <li class="apx-prob__line" aria-hidden="true"></li>
      {%- for block in section.blocks -%}
        <li class="apx-prob__step" {{ block.shopify_attributes }}>
          {%- if block.settings.time != blank -%}<p class="apx-prob__time">{{ block.settings.time }}</p>{%- endif -%}
          <span class="apx-prob__node" aria-hidden="true">{% render 'ap-icon', name: block.settings.icon, size: 24 %}</span>
          {%- if block.settings.builtin_photo != blank -%}
            <div class="apx-prob__photo">
              <img src="{{ block.settings.builtin_photo | asset_url }}" alt="{{ block.settings.photo_alt | escape }}" width="738" height="1100" loading="lazy">
              {%- if block.settings.chip != blank -%}<span class="apx-prob__chip">{{ block.settings.chip }}</span>{%- endif -%}
            </div>
          {%- elsif block.settings.image != blank -%}
            <div class="apx-prob__photo">
              {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 900px) 24vw, 80vw', alt: block.settings.image.alt | default: block.settings.title }}
              {%- if block.settings.chip != blank -%}<span class="apx-prob__chip">{{ block.settings.chip }}</span>{%- endif -%}
            </div>
          {%- endif -%}
          <h3 class="apx-prob__t">{{ block.settings.title }}</h3>
          {%- if section.settings.show_text and block.settings.text != blank -%}
            <p class="apx-prob__moment">{%- if section.settings.label_problem != blank -%}<span class="apx-prob__lab">{{ section.settings.label_problem }}</span>{%- endif -%}{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.fix != blank -%}
            <div class="apx-prob__cap">
              {%- if block.settings.art != 'none' -%}
                <span class="apx-prob__art" aria-hidden="true">
                  {%- case block.settings.art -%}
                    {%- when 'magnifier' -%}<svg viewBox="0 0 64 48" width="64" height="48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="27" cy="21" r="15"/><circle cx="27" cy="21" r="3.2" fill="currentColor" stroke="none" opacity=".55"/><path d="M38 32l13 12" stroke-width="4"/></svg>
                    {%- when 'day' -%}<svg viewBox="0 0 64 48" width="64" height="48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 30c8-12 40-14 52-2-12 12-42 12-52 2z"/><ellipse cx="32" cy="30" rx="12" ry="4.5" opacity=".6"/><path d="M12 36c10 6 32 6 42-2" opacity=".5"/></svg>
                    {%- when 'night' -%}<svg viewBox="0 0 64 48" width="64" height="48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 30c4-14 30-18 44-6l-2 8c-14 8-34 8-42-2z"/><path d="M10 30c10 8 30 8 42 2" opacity=".6"/><path d="M12 36c10 6 28 6 38-2" opacity=".4"/></svg>
                    {%- when 'patch' -%}<svg viewBox="0 0 64 48" width="64" height="48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="32" cy="24" r="16"/><circle cx="32" cy="24" r="9" opacity=".5"/><circle cx="32" cy="24" r="3" fill="currentColor" stroke="none" opacity=".35"/></svg>
                  {%- endcase -%}
                </span>
              {%- endif -%}
              <p>{{ block.settings.fix }}</p>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.photo_note != blank -%}<p class="apx-fine apx-center apx-prob__note">{{ section.settings.photo_note }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="apx-prob__cta">
        {%- if section.settings.cta_pill != blank -%}<p class="apx-prob__pill"><i aria-hidden="true"></i>{{ section.settings.cta_pill }}</p>{%- endif -%}
        <a class="apx-prob__btn" href="{{ section.settings.button_link | default: buy_fallback }}">{{ section.settings.button_label }}<span aria-hidden="true">&rarr;</span></a>
        {%- if section.settings.cta_note != blank -%}<p class="apx-prob__ctanote">{{ section.settings.cta_note }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.show_trust -%}
      <ul class="apx-prob__trust">
        {%- for n in (1..3) -%}
          {%- assign tk = 'trust_' | append: n -%}
          {%- assign sk = 'trust_' | append: n | append: '_sub' -%}
          {%- if section.settings[tk] != blank -%}
            <li>
              <span class="apx-prob__ti" aria-hidden="true">{%- case n -%}{%- when 1 -%}{% render 'ap-icon', name: 'truck', size: 22 %}{%- when 2 -%}{% render 'ap-icon', name: 'chat', size: 22 %}{%- else -%}{% render 'ap-icon', name: 'lock', size: 22 %}{%- endcase -%}</span>
              <span class="apx-prob__tt"><b>{{ section.settings[tk] }}</b>{%- if section.settings[sk] != blank -%}<em>{{ section.settings[sk] }}</em>{%- endif -%}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .apx-prob__lede{margin-inline:auto}
  .apx-prob__steps{position:relative;display:grid;gap:0;margin:clamp(32px,5vw,56px) 0 0;padding:0;list-style:none}
  .apx-prob__line{position:absolute;left:23px;top:24px;bottom:24px;width:2px;background:linear-gradient(var(--ap-blush),var(--ap-lilac),var(--ap-apricot));border-radius:2px;transform-origin:top;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
  .is-folded .apx-prob__line{transform:scaleY(0)}
  .apx-prob__step{position:relative;padding:0 0 32px 72px}
  .apx-prob__step:last-child{padding-bottom:0}
  .apx-prob__node{position:absolute;left:0;top:0;display:grid;place-items:center;width:48px;height:48px;border:2px solid var(--ap-blush);border-radius:50%;background:var(--ap-white);color:var(--ap-blush-deep)}
  .apx-prob__time{margin:0 0 6px;color:var(--ap-blush-deep);font-size:.75rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;padding-top:2px}
  .apx-prob__photo{overflow:hidden;margin:0 0 16px;border-radius:12px;background:var(--ap-sand);aspect-ratio:3/4;box-shadow:0 14px 30px rgba(59,10,20,.1)}
  @media (max-width:899px){.apx-prob--portrait .apx-prob__photo{aspect-ratio:4/3}}
  .apx-prob--landscape .apx-prob__photo{aspect-ratio:16/10}
  .apx-prob--square .apx-prob__photo{aspect-ratio:1}
  .apx-prob__photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  @media (hover:hover){.apx-prob__step:hover .apx-prob__photo img{transform:scale(1.05)}}
  .apx-prob__step h3{margin:0 0 .35rem;font-size:1.25rem}
  .apx-prob__moment{margin:0;color:var(--ap-ink-soft);line-height:1.6}
  .apx-prob__fix{display:flex;gap:10px;align-items:flex-start;margin:14px 0 0;padding:12px 14px;border-radius:14px;background:var(--ap-sand);color:var(--ap-ink);font-weight:600;line-height:1.5}
  .apx-prob__fix .apx-icon{flex:none;margin-top:2px;color:var(--ap-blush-deep)}
  .apx-prob__photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 42%}
  .apx-prob__note{margin:20px 0 0}
  .apx-prob__pains{max-width:860px;margin:clamp(24px,3vw,36px) auto 0;text-align:center}
  .apx-prob__pains-t{margin:0 0 12px;font-family:var(--ap-font-display);font-size:1.25rem;color:var(--ap-ink)}
  .apx-prob__pains-l{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:0;padding:0;list-style:none}
  .apx-prob__pains-l li{display:inline-flex;align-items:center;gap:.5rem;padding:.55rem 1rem;border:1px solid rgba(110,20,35,.22);border-radius:999px;background:var(--ap-white);color:var(--ap-ink);font-size:.9375rem;font-weight:600;box-shadow:0 6px 16px rgba(59,10,20,.05)}
  .apx-prob__pains-l .apx-icon{flex:none;width:22px;height:22px;padding:4px;border-radius:50%;background:#F5E6E8;color:var(--ap-blush-deep)}
  .apx-prob__photo{position:relative}
  .apx-prob__photo img{transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  @media (hover:hover){.apx-prob__step:hover .apx-prob__photo img{transform:scale(1.05)}}
  .apx-prob__chip{position:absolute;left:12px;bottom:12px;padding:.35rem .8rem;border-radius:999px;background:rgba(255,255,255,.92);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:var(--ap-ink);font-size:.8125rem;font-weight:800;letter-spacing:.04em;box-shadow:0 6px 16px rgba(59,10,20,.2)}
  .apx-prob__lab{display:block;margin:0 0 .15rem;font-size:.6875rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--ap-blush-deep)}
  .apx-prob__lab--fix{color:var(--ap-ink-soft)}
  .apx-prob__cta{display:grid;justify-items:center;margin-top:clamp(28px,4vw,48px);text-align:center}
  .apx-prob__pill{display:inline-flex;align-items:center;gap:10px;margin:0 0 1.2rem;padding:.6rem 1.3rem;border:1.5px solid #EBDDC9;border-radius:999px;background:#fff;font-size:.8125rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--ap-ink)}
  .apx-prob__pill i{width:8px;height:8px;border-radius:50%;background:#B5495E}
  .apx-prob__ctanote{margin:1.1rem 0 0;font-size:1rem;color:var(--ap-ink-soft)}
  .apx-prob__trust{display:grid;gap:0;max-width:1100px;margin:clamp(28px,4vw,48px) auto 0;padding:10px;list-style:none;border:1px solid var(--ap-line);border-radius:36px;background:#fff;box-shadow:0 20px 50px rgba(59,10,20,.07)}
  .apx-prob__trust li{display:flex;align-items:center;gap:16px;padding:16px 20px}
  .apx-prob__trust li+li{border-top:1px solid var(--ap-line)}
  .apx-prob__ti{flex:none;display:grid;place-items:center;width:52px;height:52px;border:1px solid #F0D9DC;border-radius:16px;background:#FBEFF0;color:#B5495E}
  .apx-prob__tt{display:grid;gap:3px;min-width:0}
  .apx-prob__tt b{font-size:1.125rem;line-height:1.25;color:var(--ap-ink)}
  .apx-prob__tt em{font-style:normal;font-size:.9375rem;line-height:1.4;color:var(--ap-ink-soft)}
  @media (min-width:800px){
    .apx-prob__trust{grid-template-columns:repeat(3,minmax(0,1fr));border-radius:999px;padding:14px 18px}
    .apx-prob__trust li{padding:14px 22px}
    .apx-prob__trust li+li{border-top:0;border-left:1px solid var(--ap-line)}
  }
  .apx-prob__btn{display:inline-flex;align-items:center;gap:12px;min-height:64px;padding:0 2.75rem;font-size:1.25rem;border-radius:999px;background:var(--ap-ink);color:var(--ap-white);font-weight:800;text-decoration:none;transition:transform .25s,box-shadow .25s}
  .apx-prob__btn:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(179,56,75,.35)}
  .apx-prob__btn:focus-visible{outline:3px solid var(--ap-ink);outline-offset:3px}
  @media (min-width:600px) and (max-width:899px){
    .apx-prob__steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 28px}
    .apx-prob__line{display:none}
    .apx-prob__step{padding:0}
    .apx-prob__node{position:static;margin-bottom:12px}
    .apx-prob__time{position:static;margin:0 0 6px}
  }
  @media (min-width:900px){
    .apx-prob__steps{grid-template-columns:repeat(var(--n,4),minmax(0,1fr));gap:28px}
    .apx-prob__line{left:24px;right:calc(100% / var(--n,4) - 24px);top:51px;bottom:auto;width:auto;height:2px;background:linear-gradient(90deg,var(--ap-blush),var(--ap-lilac),var(--ap-apricot));transform-origin:left}
    .is-folded .apx-prob__line{transform:scaleX(0)}
    .apx-prob__step{padding:92px 0 0}
    .apx-prob__node{left:0;top:28px}
    .apx-prob__time{position:absolute;left:0;top:0;margin:0}
  }

  /* "Step N" cards: photo, step title, small drawing above a caption box */
  .apx-prob__steps{counter-reset:apx-prob-step}
  .apx-prob__step{counter-increment:apx-prob-step}
  .apx-prob__t{margin:0 0 .6rem;font-size:1.3125rem;line-height:1.2}
  .apx-prob--numbered .apx-prob__t::before{content:"Step " counter(apx-prob-step) ": "}
  .apx-prob__cap{position:relative;margin-top:30px;padding:34px 16px 16px;border-radius:16px;background:#F6EDEB;box-shadow:0 10px 22px rgba(59,10,20,.06);text-align:center}
  .apx-prob__cap p{margin:0;color:var(--ap-ink);font-size:1rem;line-height:1.5}
  .apx-prob__art{position:absolute;left:50%;top:-28px;transform:translateX(-50%);display:block;color:var(--ap-blush-deep)}
  .apx-prob__art svg{display:block}
  .apx-prob__cap:not(:has(.apx-prob__art)){padding-top:16px}
  .apx-prob__time{font-size:.6875rem;letter-spacing:.18em}
  .apx-prob__node{border-color:var(--ap-ink);color:var(--ap-ink);width:44px;height:44px}
  .apx-prob__chip{left:12px;bottom:12px}
  @media (min-width:900px){.apx-prob__t{min-height:2.45em;margin-bottom:4px}.apx-prob__node{top:30px}.apx-prob__line{top:52px;background:linear-gradient(90deg,var(--ap-ink),var(--ap-apricot))}}

  /* phones: swipe through the four moments instead of a long vertical list */
  @media (max-width:599px){
    .apx-prob__steps{display:flex;gap:14px;margin:24px calc(var(--ap-gutter) * -1) 0;padding:4px var(--ap-gutter) 14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
    .apx-prob__steps::-webkit-scrollbar{display:none}
    .apx-prob__line{display:none}
    .apx-prob__step{flex:0 0 76%;scroll-snap-align:center;padding:0}
    .apx-prob__node{position:static;width:40px;height:40px;margin:0 0 10px}
    .apx-prob__time{position:static;margin:0 0 6px}
    .apx-prob__photo{aspect-ratio:4/5}
    .apx-prob__t{min-height:0;font-size:1.1875rem}
    .apx-prob__cap{margin-top:26px}
    .apx-prob__pains-l li{font-size:.8125rem;padding:.45rem .8rem}
  }
  @media (max-width:599px){.apx-prob__pains-l{flex-wrap:nowrap;justify-content:flex-start;margin-inline:calc(var(--ap-gutter) * -1);padding:2px var(--ap-gutter);overflow-x:auto;scrollbar-width:none}.apx-prob__pains-l::-webkit-scrollbar{display:none}.apx-prob__pains-l li{flex:none;white-space:nowrap}}
{% endstylesheet %}

{% schema %}
{
  "name": "Problem",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From mirror to morning" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spots happen. Picking shouldn't be your only plan." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "A spot shows up right before something big, and your fingers have opinions. You are not alone, and there is a gentler habit to try."
    },
    { "type": "select", "id": "photo_shape", "label": "Photo shape", "options": [ { "value": "portrait", "label": "Portrait rectangle (3:4)" }, { "value": "landscape", "label": "Landscape rectangle (16:10)" }, { "value": "square", "label": "Square" } ], "default": "portrait" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find your kit" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to scroll to the buy box." },
    { "type": "checkbox", "id": "step_numbers", "label": "Number the steps (Step 1, Step 2...)", "default": true },
    { "type": "checkbox", "id": "show_text", "label": "Show the longer line under each title", "default": false, "info": "The text under each moment's title. Off keeps the cards short." },
    { "type": "text", "id": "pain_title", "label": "Pain points heading", "default": "Sound familiar?" },
    { "type": "textarea", "id": "pain_list", "label": "Pain points (one per line)", "info": "Short everyday annoyances your customers recognise. Leave empty to hide.", "default": "Can't stop touching it\nPatches that curl up and slide off\nCover-ups that look obvious\nNot sure when to peel it off" },
    { "type": "text", "id": "label_problem", "label": "Label above the problem", "default": "The problem" },
    { "type": "text", "id": "label_fix", "label": "Label above what helps", "default": "What helps" },
    { "type": "text", "id": "photo_note", "label": "Photo note (small print)", "info": "Shown under the cards. Clear it once all photos are your own real photos.", "default": "Photos are illustrative demonstrations, not customer testimonials." },
    { "type": "header", "content": "Button area" },
    { "type": "text", "id": "cta_pill", "label": "Small pill above the button (empty hides it)", "default": "Day & night hydrocolloid duo" },
    { "type": "text", "id": "cta_note", "label": "Line under the button (empty hides it)", "default": "30-day guarantee · Cancel or skip anytime", "info": "Keep this true for your store." },
    { "type": "header", "content": "Trust card under the button" },
    { "type": "checkbox", "id": "show_trust", "label": "Show the trust card", "default": true },
    { "type": "text", "id": "trust_1", "label": "Point 1 title", "default": "Free US shipping on kits" },
    { "type": "text", "id": "trust_1_sub", "label": "Point 1 text", "default": "Ships in 3 to 5 business days" },
    { "type": "text", "id": "trust_2", "label": "Point 2 title", "default": "US-based support" },
    { "type": "text", "id": "trust_2_sub", "label": "Point 2 text", "default": "Real humans at contact@zlofy.com" },
    { "type": "text", "id": "trust_3", "label": "Point 3 title", "default": "Secure checkout" },
    { "type": "text", "id": "trust_3_sub", "label": "Point 3 text", "default": "Encrypted checkout · Apple Pay & Shop Pay" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "hand", "label": "Hand" },
            { "value": "clock", "label": "Clock" },
            { "value": "layers", "label": "Layers" },
            { "value": "sun", "label": "Sun" },
            { "value": "moon", "label": "Moon" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "hand"
        },
        { "type": "select", "id": "builtin_photo", "label": "Built-in sample photo", "info": "An AI-generated demonstration photo. It is NOT a real customer. Set to None to use your own photo below.", "options": [ { "value": "", "label": "None" }, { "value": "ap-card-morning.jpg", "label": "Morning: holding a patch by a small spot" }, { "value": "ap-card-midday.jpg", "label": "Midday: pressing a patch onto a small spot" }, { "value": "ap-card-night.jpg", "label": "Night: a patch on the chin in bed" }, { "value": "ap-card-swap.jpg", "label": "Next morning: a used patch beside a fresh one" } ], "default": "" },
        { "type": "text", "id": "photo_alt", "label": "Built-in photo description", "default": "An adult in a bathroom mirror holding a thin round patch next to a small spot on the chin" },
        { "type": "image_picker", "id": "image", "label": "Photo (optional)", "info": "Shown above the moment. Upload only photos you own or have licensed, ideally of real people who gave permission." },
        { "type": "select", "id": "art", "label": "Small drawing above the caption", "default": "none", "options": [
          { "value": "none", "label": "None" }, { "value": "magnifier", "label": "Magnifier on a spot" }, { "value": "day", "label": "Thin day patch" },
          { "value": "night", "label": "Cushioned night patch" }, { "value": "patch", "label": "Round patch" } ] },
        { "type": "text", "id": "time", "label": "Time of day", "default": "Midday" },
        { "type": "text", "id": "chip", "label": "Time tag on the photo", "info": "A small tag on the photo, for example \"7:30 AM\".", "default": "" },
        { "type": "text", "id": "title", "label": "Moment", "default": "The picking loop" },
        { "type": "textarea", "id": "text", "label": "The annoyance", "default": "Hands find the spot before your brain catches up." },
        { "type": "textarea", "id": "fix", "label": "What helps", "default": "A patch gives your fingers something else to find.", "info": "Keep it true for your product. Cosmetic wording only." }
      ]
    }
  ],
  "presets": [
    {
