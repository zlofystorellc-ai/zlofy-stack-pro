{%- comment -%}
  Big-number strip. Use ONLY numbers that are true facts about your product (counts, sizes, hours).
  Do not enter customer-survey or "clinical" percentages unless you hold the study and can cite it on the page.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="apx-stats apx-section" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
    </div>
    <ul class="apx-stats__grid">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="apx-stats__n">{{ block.settings.value }}</span>
          <span class="apx-stats__l">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.note != blank -%}<p class="apx-fine apx-center">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-stats__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:28px 0 14px}
  .apx-stats__grid li{display:grid;gap:.35rem;padding:22px 16px;border-radius:var(--ap-radius);background:var(--ap-sand);text-align:center}
  .apx-stats__n{font-family:var(--ap-font-display);font-size:clamp(2rem,5vw,3rem);font-weight:500;letter-spacing:-.02em;line-height:1;color:var(--ap-blush-deep)}
  .apx-stats__l{font-size:.9375rem;color:var(--ap-ink-soft)}
{% endstylesheet %}

{% schema %}
{
  "name": "Big numbers",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "At a glance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What is in the kit" },
    { "type": "text", "id": "note", "label": "Small print (optional)", "default": "Example numbers: edit them to match your real product." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Number",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "value", "label": "Number", "default": "36" },
        { "type": "text", "id": "label", "label": "Label", "default": "patches in the kit" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Big numbers",
      "blocks": [
        { "type": "stat", "settings": { "value": "36", "label": "patches in the kit" } },
        { "type": "stat", "settings": { "value": "2", "label": "patch types: day and night" } },
        { "type": "stat", "settings": { "value": "3", "label": "sizes for different spots" } },
        { "type": "stat", "settings": { "value": "6–8h", "label": "typical wear time" } }
      ]
    }
  ]
}
{% endschema %}
