{%- comment -%}
  Store locator: search box, filter chips, a list of places and a map of the lower 48 states with a pin for each place.
  The list comes ONLY from the "Place" blocks you add. Nothing is invented: with no places, the section says you sell online.
  Add a place only when a shop, pharmacy or clinic really stocks or recommends your product, and you have their OK.
  Pins need latitude and longitude; a place without them is still listed.
{%- endcomment -%}
<section class="apx-loc apx-section" aria-labelledby="{{ section.id }}-title" data-ap-loc>
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size == 0 -%}
      <div class="apx-loc__empty">
        <p>{{ section.settings.empty_text }}</p>
        {%- if section.settings.empty_button_label != blank -%}<a class="apx-btn" href="{{ section.settings.empty_button_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_button_label }}</a>{%- endif -%}
      </div>
    {%- else -%}
      <div class="apx-loc__grid">
        <div class="apx-loc__side">
          <form class="apx-loc__search" role="search" data-ap-loc-form>
            <label class="apx-sr" for="{{ section.id }}-q">{{ section.settings.search_label }}</label>
            <input id="{{ section.id }}-q" type="search" placeholder="{{ section.settings.search_label | escape }}" autocomplete="postal-code" data-ap-loc-q>
            <button type="submit">{{ section.settings.search_button }}</button>
          </form>
          <div class="apx-loc__chips" role="group" aria-label="Filter" data-ap-loc-chips>
            <button type="button" class="is-on" aria-pressed="true" data-kind="all">All</button>
            {%- assign seen = '' -%}
            {%- for block in section.blocks -%}
              {%- unless seen contains block.settings.kind -%}
                {%- assign seen = seen | append: block.settings.kind | append: '|' -%}
                <button type="button" aria-pressed="false" data-kind="{{ block.settings.kind | handleize }}">{{ block.settings.kind }}</button>
              {%- endunless -%}
            {%- endfor -%}
          </div>
          <p class="apx-loc__count" aria-live="polite" data-ap-loc-count></p>
          <ul class="apx-loc__list" data-ap-loc-list>
            {%- for block in section.blocks -%}
              <li class="apx-loc__item" data-kind="{{ block.settings.kind | handleize }}" data-lat="{{ block.settings.lat }}" data-lon="{{ block.settings.lon }}" data-text="{{ block.settings.name }} {{ block.settings.address }} {{ block.settings.city }} {{ block.settings.state }} {{ block.settings.zip }}" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <button type="button" class="apx-loc__card" data-ap-loc-card>
                  <span class="apx-loc__kind">{{ block.settings.kind }}</span>
                  <strong>{{ block.settings.name }}</strong>
                  <span>{{ block.settings.address }}{% if block.settings.address != blank and block.settings.city != blank %}, {% endif %}{{ block.settings.city }}{% if block.settings.state != blank %}, {{ block.settings.state }}{% endif %} {{ block.settings.zip }}</span>
                </button>
                {%- if block.settings.link != blank -%}<a class="apx-loc__go" href="{{ block.settings.link }}">{{ section.settings.link_label }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          <p class="apx-loc__none" data-ap-loc-none hidden>{{ section.settings.none_text }}</p>
        </div>
        <div class="apx-loc__map" aria-hidden="true">
          <svg viewBox="0 0 1000 637" data-ap-loc-svg preserveAspectRatio="xMidYMid meet">
            <path class="apx-loc__land" d="M102.4 20.0L144.6 31.6L189.0 42.3L203.8 45.5L249.9 54.6L294.7 62.0L340.6 68.1L386.6 72.8L438.8 76.2L491.5 77.9L523.4 77.9L523.4 69.2L528.6 69.0L531.5 81.5L536.3 85.3L547.2 86.5L563.1 89.7L578.5 96.2L591.0 92.6L610.5 97.4L615.6 96.8L629.0 89.2L644.4 96.3L660.5 103.7L674.0 110.0L687.1 116.0L689.4 121.8L693.3 123.6L692.6 126.0L697.0 126.2L699.8 123.5L701.3 128.8L705.0 132.0L709.4 131.4L712.1 134.0L710.6 138.3L728.9 146.8L735.3 167.1L741.6 186.7L738.7 201.0L732.6 214.9L730.0 223.5L729.9 225.9L732.3 229.0L738.6 231.8L742.8 231.2L760.7 215.9L777.4 209.5L797.3 194.3L797.2 191.9L794.4 185.1L791.0 181.1L797.7 176.1L813.8 173.0L828.9 170.0L832.3 160.0L833.9 157.8L847.5 137.8L853.7 132.0L877.9 126.2L907.2 118.8L907.3 112.8L912.1 110.3L917.8 105.0L920.6 93.3L920.4 74.7L927.3 54.6L934.0 58.9L943.1 52.2L951.8 56.5L961.0 86.7L975.0 96.1L980.0 102.5L966.5 118.4L952.5 131.0L937.4 142.4L932.6 158.2L931.2 164.0L934.3 176.0L943.0 186.4L950.0 185.1L946.0 177.3L952.3 180.9L952.8 187.7L942.6 194.5L934.5 196.2L923.2 203.4L916.2 206.4L906.7 210.0L894.3 220.0L918.0 209.6L924.0 212.6L902.1 225.4L891.3 228.0L891.1 225.1L887.5 232.6L892.7 232.5L892.9 249.7L884.3 270.2L881.7 264.6L877.6 264.3L870.7 259.8L876.9 271.3L882.2 274.4L884.4 283.0L880.8 293.1L874.7 313.6L872.9 313.0L875.0 296.3L864.1 289.5L858.0 270.9L856.8 281.5L863.6 295.2L851.2 294.0L864.9 298.9L870.2 320.6L875.7 321.1L879.2 328.6L886.7 350.9L878.7 370.4L860.9 381.1L851.2 396.9L842.1 400.2L834.1 410.4L832.8 418.6L814.4 437.1L805.4 449.8L798.4 464.9L797.9 481.7L803.9 497.2L813.6 515.7L825.2 530.4L826.8 540.3L840.9 565.1L842.9 580.5L843.5 589.5L840.6 604.2L834.8 608.1L824.0 607.0L819.1 597.5L810.5 593.5L796.5 575.6L784.4 559.5L780.1 551.0L782.1 535.2L774.8 523.3L756.6 506.2L748.4 503.7L729.5 516.6L725.8 515.8L714.9 506.1L701.8 501.7L679.6 506.8L661.7 505.7L646.6 508.5L638.7 512.6L642.7 518.5L643.0 528.0L647.6 532.3L644.0 535.5L636.2 532.6L628.9 537.5L614.2 537.7L598.5 526.2L581.1 529.8L566.3 5