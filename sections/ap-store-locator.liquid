            <g data-ap-loc-pins></g>
          </svg>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'ap-locator.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .apx-loc{background:linear-gradient(180deg,#FBF7F5,#F5E6E8)}
  .apx-loc__empty{max-width:560px;margin:34px auto 0;padding:28px;border:1px solid var(--ap-line);border-radius:20px;background:#fff;text-align:center;box-shadow:0 14px 32px rgba(59,10,20,.07)}
  .apx-loc__empty p{margin:0 0 18px;font-size:1.0625rem;line-height:1.6}
  .apx-loc__grid{display:grid;gap:24px;margin-top:clamp(28px,4vw,48px)}
  .apx-loc__search{display:flex;gap:0;overflow:hidden;border:1.5px solid var(--ap-ink);border-radius:999px;background:#fff}
  .apx-loc__search input{flex:1;min-width:0;min-height:50px;padding:0 20px;border:0;background:transparent;font:inherit;font-size:1rem;color:var(--ap-ink)}
  .apx-loc__search input:focus-visible{outline:3px solid var(--ap-blush-deep);outline-offset:-4px}
  .apx-loc__search button{flex:none;padding:0 24px;border:0;background:var(--ap-ink);color:#fff;font:inherit;font-weight:700;cursor:pointer}
  .apx-loc__chips{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 6px}
  .apx-loc__chips button{min-height:40px;padding:0 18px;border:1px solid var(--ap-line);border-radius:999px;background:#fff;color:var(--ap-ink);font:inherit;font-size:.9375rem;font-weight:600;cursor:pointer}
  .apx-loc__chips button.is-on{background:var(--ap-ink);border-color:var(--ap-ink);color:#fff}
  .apx-loc__chips button:focus-visible,.apx-loc__card:focus-visible,.apx-loc__search button:focus-visible{outline:3px solid var(--ap-blush-deep);outline-offset:2px}
  .apx-loc__count{margin:6px 0 10px;font-size:.875rem;color:var(--ap-ink-soft)}
  .apx-loc__list{display:grid;gap:10px;max-height:560px;margin:0;padding:0 4px 4px 0;overflow:auto;list-style:none}
  .apx-loc__item[hidden]{display:none}
  .apx-loc__card{display:grid;gap:3px;width:100%;padding:14px 16px;border:1.5px solid var(--ap-line);border-radius:14px;background:#fff;color:var(--ap-ink);font:inherit;text-align:left;cursor:pointer;transition:border-color .2s,box-shadow .2s}
  .apx-loc__item.is-on .apx-loc__card,.apx-loc__card:hover{border-color:var(--ap-ink);box-shadow:0 10px 22px rgba(59,10,20,.1)}
  .apx-loc__kind{font-size:.6875rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--ap-blush-deep)}
  .apx-loc__card span:last-child{font-size:.9375rem;color:var(--ap-ink-soft)}
  .apx-loc__go{display:inline-block;margin:6px 4px 0;font-size:.875rem;font-weight:700;color:var(--ap-blush-deep)}
  .apx-loc__none{margin:12px 0 0;padding:14px;border-radius:12px;background:#fff;color:var(--ap-ink-soft)}
  .apx-loc__map{position:relative;padding:18px;border:1px solid var(--ap-line);border-radius:24px;background:#fff;box-shadow:0 16px 36px rgba(59,10,20,.08)}
  .apx-loc__map svg{display:block;width:100%;height:auto}
  .apx-loc__land{fill:#F2E3E5;stroke:#C99AA3;stroke-width:1.4;stroke-linejoin:round}
  .apx-loc__pin{cursor:pointer}
  .apx-loc__pin circle{fill:var(--ap-ink);stroke:#fff;stroke-width:3;transition:r .2s,fill .2s}
  .apx-loc__pin.is-on circle,.apx-loc__pin:hover circle{fill:var(--ap-blush-deep)}
  @media (min-width:900px){.apx-loc__grid{grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:32px;align-items:start}}
{% endstylesheet %}

{% schema %}
{
  "name": "Store locator",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "paragraph", "content": "Add a Place only when a shop, pharmacy or clinic really stocks or recommends your product and has agreed to be listed. With no places added, visitors see the message below. No places are made up for you." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Where to buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find a store" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "" },
    { "type": "textarea", "id": "empty_text", "label": "Message when no places are added", "default": "Zlofy is sold online for now, and we ship across the United States. Stores that carry it will be listed here." },
    { "type": "text", "id": "empty_button_label", "label": "Button under that message", "default": "Shop the kit" },
    { "type": "url", "id": "empty_button_link", "label": "Button link", "info": "Leave empty to go to all products." },
    { "type": "text", "id": "search_label", "label": "Search box text", "default": "Search by zip code, city or store" },
    { "type": "text", "id": "search_button", "label": "Search button", "default": "Search" },
    { "type": "text", "id": "none_text", "label": "Message when a search finds nothing", "default": "No places match that search. Try a city or a state." },
    { "type": "text", "id": "link_label", "label": "Link text for a place's website", "default": "Visit" }
  ],
  "blocks": [
    {
      "type": "place",
      "name": "Place",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "select", "id": "kind", "label": "Type", "default": "Store", "options": [
          { "value": "Store", "label": "Store" }, { "value": "Pharmacy", "label": "Pharmacy" }, { "value": "Clinic", "label": "Clinic" }, { "value": "Other", "label": "Other" } ] },
        { "type": "text", "id": "address", "label": "Street address" },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "text", "id": "state", "label": "State (for example TX)" },
        { "type": "text", "id": "zip", "label": "Zip code" },
        { "type": "text", "id": "lat", "label": "Latitude (for the map pin)", "info": "For example 29.7604. Leave empty for no pin." },
        { "type": "text", "id": "lon", "label": "Longitude (for the map pin)", "info": "For example -95.3698." },
        { "type": "url", "id": "link", "label": "Website (optional)" }
      ]
    }
  ],
  "presets": [ { "name": "Store locator" } ]
}
{% endschema %}
