{%- comment -%}
  "The system": the parts of the kit side by side (here the day patch and the night patch), each with a short description,
  a few plain points and an optional photo (upload only photos you own or have licensed). Without a photo a drawn
  patch illustration is shown. Describe only what your real patches do.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="apx-sys apx-section" aria-labelledby="{{ section.id }}-title">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="apx-lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ul class="apx-sys__grid">
      {%- for block in section.blocks -%}
        <li class="apx-sys__card apx-sys__card--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
          <div class="apx-sys__visual">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', sizes: '(min-width: 760px) 40vw, 90vw', alt: block.settings.image.alt | default: block.settings.title }}
            {%- else -%}
              <span class="apx-sys__patch" aria-hidden="true"></span>
            {%- endif -%}
          </div>
          <div class="apx-sys__body">
            {%- if block.settings.tag != blank -%}<p class="apx-sys__tag">{% if block.settings.tone == 'night' %}{% render 'ap-icon', name: 'moon', size: 18 %}{% else %}{% render 'ap-icon', name: 'sun', size: 18 %}{% endif %}{{ block.settings.tag }}</p>{%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            <ul class="apx-sys__points">
              {%- for n in (1..3) -%}
                {%- assign key = 'point_' | append: n -%}
                {%- if block.settings[key] != blank -%}<li>{% render 'ap-icon', name: 'check', size: 18 %}<span>{{ block.settings[key] }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .apx-sys__grid{display:grid;gap:20px;margin:clamp(28px,4vw,48px) 0 0;padding:0;list-style:none}
  .apx-sys__card{display:grid;overflow:hidden;border-radius:32px}
  .apx-sys__card--day{background:linear-gradient(160deg,#FFF3BF,#FFE066);color:var(--ap-ink)}
  .apx-sys__card--night{background:linear-gradient(160deg,#2A2A55,var(--ap-ink));color:var(--ap-white)}
  .apx-sys__visual{display:grid;place-items:center;min-height:220px;padding:28px}
  .apx-sys__visual img{display:block;width:100%;max-width:320px;aspect-ratio:1;object-fit:cover;border-radius:50%;box-shadow:0 20px 40px rgba(0,0,0,.22)}
  .apx-sys__patch{position:relative;width:min(60%,220px);aspect-ratio:1;border-radius:50%;animation:apx-float 7s ease-in-out infinite}
  .apx-sys__card--day .apx-sys__patch{background:var(--ap-white);box-shadow:inset 0 0 0 6px rgba(207,39,73,.18),0 24px 40px rgba(133,79,11,.22)}
  .apx-sys__card--night .apx-sys__patch{background:var(--ap-blush-deep);box-shadow:inset 0 0 0 6px rgba(255,255,255,.3),0 24px 40px rgba(0,0,0,.4);animation-delay:-3s}
  .apx-sys__patch::after{content:"";position:absolute;left:50%;top:50%;width:14%;height:14%;margin:-7%;border-radius:50%;background:rgba(255,255,255,.92)}
  .apx-sys__body{padding:0 clamp(22px,4vw,40px) clamp(24px,4vw,40px)}
  .apx-sys__tag{display:inline-flex;align-items:center;gap:.4rem;margin:0 0 6px;font-size:.8125rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .apx-sys__body h3{margin:0 0 8px;color:inherit;font-size:clamp(1.75rem,3.5vw,2.5rem)}
  .apx-sys__body > p{margin:0;font-size:1.0625rem;line-height:1.6}
  .apx-sys__points{display:grid;gap:8px;margin:18px 0 0;padding:0;list-style:none}
  .apx-sys__points li{display:flex;gap:.6rem;align-items:flex-start;font-weight:600}
  .apx-sys__points .apx-icon{flex:none;margin-top:.15rem}
  @media (min-width:760px){.apx-sys__grid{grid-template-columns:1fr 1fr}.apx-sys__card{grid-template-rows:auto 1fr}}
{% endstylesheet %}

{% schema %}
{
  "name": "System parts",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Editor note: the default text is an example. Describe your real patches. Upload only photos you own or have licensed." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The system" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two patches. One kit." },
    { "type": "textarea", "id": "text", "label": "Intro (optional)" }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Part",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "tone", "label": "Look", "options": [ { "value": "day", "label": "Day (warm)" }, { "value": "night", "label": "Night (navy)" } ], "default": "day" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Day" },
        { "type": "text", "id": "title", "label": "Title", "default": "Thin and low-shine" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this part in plain words." },
        { "type": "text", "id": "point_1", "label": "Point 1" },
        { "type": "text", "id": "point_2", "label": "Point 2" },
        { "type": "text", "id": "point_3", "label": "Point 3" },
        { "type": "image_picker", "id": "image", "label": "Photo (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "System parts",
      "blocks": [
        { "type": "part", "settings": { "tone": "day", "tag": "Day", "title": "Thin and low-shine", "text": "Sits close to the skin, so you can wear it to school, work or errands.", "point_1": "Matte, low-shine finish", "point_2": "Thin, so it stays discreet", "point_3": "Made for the daytime" } },
        { "type": "part", "settings": { "tone": "night", "tag": "Night", "title": "Cushioned and steady", "text": "A thicker patch that stays put while you sleep.", "point_1": "Soft, cushioned feel", "point_2": "Made to stay in place overnight", "point_3": "Peel it off in the morning" } }
      ]
    }
  ]
}
{% endschema %}
