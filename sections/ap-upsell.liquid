{%- comment -%}
  "Complete your routine": Shopify product recommendations (intent: complementary),
  falling back to a collection of your choice (section setting, else Theme settings > Upsell fallback collection).
  Server-renders the fallback so it works without JS; assets/ap-upsell.js swaps in live recommendations.
{%- endcomment -%}
{%- liquid
  assign items = recommendations.products
  assign fallback = section.settings.fallback_collection | default: settings.upsell_collection
  if items.size == 0 and fallback != blank
    assign items = fallback.products
  endif
  assign max = section.settings.limit | default: 4
-%}
<section class="apx-upsell apx-section" data-ap-upsell-section
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ max | plus: 1 }}&intent=complementary">
  <div class="apx-wrap">
    <div class="apx-center">
      {%- if section.settings.eyebrow != blank -%}<p class="apx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="apx-h2">{{ section.settings.heading }}</h2>
    </div>
    <ul class="apx-upsell__list" data-ap-upsell-list>
      {%- assign shown = 0 -%}
      {%- for item in items -%}
        {%- if item.id != product.id and shown < max -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="apx-upsell__card">
            {%- if item.featured_image -%}
              {{ item.featured_image | image_url: width: 480 | image_tag: widths: '240, 360, 480', sizes: '(min-width: 990px) 22vw, 45vw', loading: 'lazy', alt: item.featured_image.alt | default: item.title }}
            {%- endif -%}
            <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
            <p><strong>{{ item.price | money }}</strong></p>
            {% render 'ap-quick-add', product: item %}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if shown == 0 and request.design_mode -%}
      <p class="apx-editor-note" role="note">{{ 'ap.upsell.editor_note' | t }}</p>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'ap-upsell.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .apx-upsell__list{display:grid;gap:16px;margin-top:28px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
  .apx-upsell__card{display:flex;flex-direction:column;gap:6px;padding:14px;border-radius:var(--ap-radius);background:var(--ap-sand)}
  .apx-upsell__card img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;border-radius:var(--ap-radius-sm);background:var(--ap-white)}
  .apx-upsell__card h3{margin:.25rem 0 0;font-size:1.05rem}
  .apx-upsell__card h3 a{color:var(--ap-ink);text-decoration:none}
  .apx-upsell__card h3 a:hover{text-decoration:underline}
  .apx-upsell__card p{margin:0}
  .apx-upsell__card form,.apx-upsell__card > a.apx-btn{margin-top:auto}
  .apx-editor-note{margin:16px auto;padding:12px 16px;border:2px dashed var(--ap-ink);border-radius:var(--ap-radius-sm);background:var(--ap-sand);font-weight:600}
{% endstylesheet %}

{% schema %}
{
  "name": "Complete your routine",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Add to your routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your routine" },
    { "type": "collection", "id": "fallback_collection", "label": "Fallback collection", "info": "Used when Shopify has no complementary recommendations yet." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "presets": [
    { "name": "Complete your routine" }
  ]
}
{% endschema %}
