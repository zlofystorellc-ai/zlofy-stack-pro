{%- comment -%}
  Video cards: a swipeable row of tall cards (poster or short video) with a name and a short label,
  plus a stats row underneath. Cards render as empty tinted slots until you add your own media.
  Use ONLY real customers/people who gave permission, and only videos and photos you own or have licensed.
  Do not use celebrity or expert names, titles or quotes unless you have a signed agreement.
{%- endcomment -%}
<section class="apx-vc apx-section" aria-labelledby="{{ section.id }}-title" data-ap-vc>
  <div class="apx-vc__head">
    {%- if section.settings.eyebrow != blank -%}<p class="apx-vc__pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="apx-vc__h" id="{{ section.id }}-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p class="apx-vc__sub">{{ section.settings.subtext }}</p>{%- endif -%}
  </div>

  {%- assign cards = section.blocks | where: 'type', 'card' -%}
  {%- if cards.size > 0 -%}
    <div class="apx-vc__nav" data-ap-vc-nav hidden>
      <button type="button" class="apx-vc__arrow" data-ap-vc-prev aria-label="{{ 'ap.video_cards.prev' | t }}"><span aria-hidden="true">&larr;</span></button>
      <button type="button" class="apx-vc__arrow" data-ap-vc-next aria-label="{{ 'ap.video_cards.next' | t }}"><span aria-hidden="true">&rarr;</span></button>
    </div>
    <div class="apx-vc__row" role="region" aria-label="{{ section.settings.heading | escape }}" tabindex="0">
      {%- for block in cards -%}
        <article class="apx-vc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: image_size: '720x', autoplay: false, loop: true, muted: true, controls: false, preload: 'none', playsinline: true, class: 'apx-vc__media', data-ap-vc-video: true }}
          {%- elsif block.settings.poster != blank -%}
            {{ block.settings.poster | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 990px) 25vw, 78vw', class: 'apx-vc__media', alt: block.settings.poster.alt | default: block.settings.name }}
          {%- endif -%}
          {%- if block.settings.video != blank -%}
            <button type="button" class="apx-vc__play" data-ap-vc-play aria-pressed="false" aria-label="{{ 'ap.video_cards.play' | t }}: {{ block.settings.name | escape }}"><span aria-hidden="true"></span></button>
          {%- endif -%}
          <div class="apx-vc__cap">
            {%- if block.settings.name != blank -%}<p class="apx-vc__name">{{ block.settings.name }}</p>{%- endif -%}
            {%- if block.settings.role != blank -%}<p class="apx-vc__role">{{ block.settings.role }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- assign stats = section.blocks | where: 'type', 'stat' -%}
  {%- if stats.size > 0 -%}
    <ul class="apx-vc__stats">
      {%- for block in stats -%}
        <li {{ block.shopify_attributes }}><span class="apx-vc__sn">{{ block.settings.number }}</span><span class="apx-vc__sl">{{ block.settings.label }}</span></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>
<script src="{{ 'ap-video-cards.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .apx-vc{padding-block:clamp(48px,6vw,88px);background:var(--ap-white);overflow:hidden}
  .apx-vc__head{display:flex;flex-direction:column;align-items:center;max-width:900px;margin-inline:auto;padding-inline:var(--ap-gutter);text-align:center}
  .apx-vc__pill{margin:0;padding:.55rem 1.4rem;border:1px solid var(--ap-line);border-radius:999px;background:var(--ap-sand);color:var(--ap-blush-deep);font-size:.8125rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .apx-vc__h{margin:20px 0 0;color:var(--ap-blush-deep);font-size:clamp(2rem,4.2vw,3.5rem);font-weight:500;line-height:1.15}
  .apx-vc__sub{margin:16px 0 0;color:var(--ap-ink-soft);font-size:.9375rem}
  .apx-vc__nav{display:flex;justify-content:flex-end;gap:10px;max-width:1400px;margin:28px auto 0;padding-inline:var(--ap-gutter)}
  .apx-vc__nav[hidden]{display:none}
  .apx-vc__arrow{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--ap-blush-deep);border-radius:50%;background:var(--ap-white);color:var(--ap-blush-deep);font-size:1.25rem;cursor:pointer}
  .apx-vc__arrow:disabled{opacity:.35;cursor:default}
  .apx-vc__arrow:focus-visible{outline:3px solid var(--ap-ink);outline-offset:2px}
  .apx-vc__row{display:flex;gap:14px;margin-top:16px;padding-inline:var(--ap-gutter);overflow-x:auto;scroll-behavior:smooth;scroll-padding-inline:var(--ap-gutter);scroll-snap-type:x mandatory;scrollbar-width:none}
  .apx-vc__row::-webkit-scrollbar{display:none}
  .apx-vc__row:focus-visible{outline:3px solid var(--ap-blush-deep);outline-offset:-3px}
  .apx-vc__card{position:relative;flex:none;width:min(78vw,340px);aspect-ratio:489/540;scroll-snap-align:start;overflow:hidden;border:1px solid var(--ap-line);border-radius:24px;background:linear-gradient(160deg,var(--ap-sand),#F6CBD3);color:var(--ap-white)}
  .apx-vc__media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .apx-vc__card::after{content:"";position:absolute;inset:auto 0 0;height:55%;background:linear-gradient(to top,rgba(31,42,68,.78),transparent);pointer-events:none}
  .apx-vc__cap{position:absolute;inset:auto 0 0;z-index:2;padding:0 24px 24px}
  .apx-vc__name{margin:0;font-size:1.375rem;font-weight:600;line-height:1.2}
  .apx-vc__role{margin:4px 0 0;font-size:.9375rem}
  .apx-vc__play{position:absolute;inset:0;z-index:1;display:grid;place-items:center;border:0;background:transparent;cursor:pointer}
  .apx-vc__play span{width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,.92);position:relative}
  .apx-vc__play span::before{content:"";position:absolute;left:24px;top:19px;border-left:17px solid var(--ap-blush-deep);border-block:11px solid transparent}
  .apx-vc__play[aria-pressed="true"] span{opacity:0;transition:opacity .2s}
  .apx-vc__play:focus-visible span{outline:3px solid var(--ap-white);box-shadow:0 0 0 6px var(--ap-ink)}
  .apx-vc__stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:24px;max-width:760px;margin:clamp(32px,5vw,64px) auto 0;padding:clamp(28px,4vw,48px) var(--ap-gutter) 0;border-top:1px solid var(--ap-line);list-style:none;text-align:center}
  .apx-vc__sn{display:block;color:var(--ap-blush-deep);font-family:var(--ap-font-display);font-size:clamp(2rem,4vw,3rem);font-weight:500;line-height:1.1}
  .apx-vc__sl{display:block;margin-top:8px;color:var(--ap-blush-deep);font-size:.75rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  @media (min-width:990px){.apx-vc__card{width:max(280px,26vw)}}
  @media (prefers-reduced-motion:reduce){.apx-vc__row{scroll-behavior:auto}}
{% endstylesheet %}

{% schema %}
{
  "name": "Video cards",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Cards stay as empty tinted slots until you add your own poster or video. Use only real people who gave permission and media you own or have licensed." },
    { "type": "text", "id": "eyebrow", "label": "Pill label", "default": "Real routines" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See how people use their patches" },
    { "type": "text", "id": "subtext", "label": "Small line", "default": "Add your own customer clips below." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Video card",
      "limit": 8,
      "settings": [
        { "type": "video", "id": "video", "label": "Video (optional)", "info": "Shopify-hosted video. Plays on tap, muted." },
        { "type": "image_picker", "id": "poster", "label": "Image (used when no video)" },
        { "type": "text", "id": "name", "label": "Name", "default": "First name" },
        { "type": "text", "id": "role", "label": "Short label", "default": "Customer" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "2" },
        { "type": "text", "id": "label", "label": "Label", "default": "Patch types" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video cards",
      "blocks": [
        { "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" },
        { "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" },
        { "type": "stat", "settings": { "number": "2", "label": "Patch types" } },
        { "type": "stat", "settings": { "number": "30", "label": "Day guarantee" } },
        { "type": "stat", "settings": { "number": "6–8", "label": "Hours per patch" } }
      ]
    }
  ]
}
{% endschema %}
