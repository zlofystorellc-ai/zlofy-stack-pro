{%- comment -%}
  Footer: four link columns (from Theme settings > Footer links), a sign-up card, a large soft wordmark and a bottom bar.
  Each link line is "Text | address". Leave a column title empty to hide the column. Only link pages that really exist.
{%- endcomment -%}
{%- liquid
  assign email = settings.support_email
  assign year = 'now' | date: '%Y'
-%}
<footer class="apx-footer apx-ft">
  <div class="apx-wrap apx-ft__top">
    <nav class="apx-ft__cols" aria-label="{{ 'ap.footer.nav' | t }}">
      {%- for n in (1..4) -%}
        {%- assign tk = 'footer_' | append: n | append: '_title' -%}
        {%- assign lk = 'footer_' | append: n | append: '_links' -%}
        {%- if settings[tk] != blank -%}
          <div class="apx-ft__col">
            <h2 class="apx-ft__h">{{ settings[tk] }}</h2>
            <ul>
              {%- assign lines = settings[lk] | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign parts = line | strip | split: '|' -%}
                {%- assign label = parts[0] | strip -%}
                {%- assign url = parts[1] | strip -%}
                {%- if label != blank -%}
                  {%- if url == 'email' -%}{%- assign url = 'mailto:' | append: email -%}{%- endif -%}
                  <li><a href="{{ url | default: '/' }}">{{ label }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- if settings.footer_signup_title != blank -%}
      <div class="apx-ft__card">
        <h2 class="apx-ft__card-t" id="ap-ft-title">{{ settings.footer_signup_title }}</h2>
        {%- form 'customer', id: 'ap-footer-form', class: 'apx-ft__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="apx-sr" for="ap-ft-email">{{ 'ap.newsletter.email' | t }}</label>
          <input class="apx-ft__input" id="ap-ft-email" type="email" name="contact[email]" autocomplete="email" inputmode="email" required placeholder="{{ 'ap.newsletter.placeholder' | t }}" aria-describedby="ap-ft-msg">
          <button class="apx-ft__btn" type="submit">{{ settings.footer_signup_button }}</button>
        {%- endform -%}
        <p class="apx-ft__card-p" id="ap-ft-msg" role="status">
          {%- if form.posted_successfully? -%}{{ 'ap.newsletter.thanks' | t }}{%- else -%}{{ settings.footer_signup_text }}{%- endif -%}
        </p>
      </div>
    {%- endif -%}
  </div>

  <div class="apx-ft__mark" aria-hidden="true"><span>{{ settings.brand_name | default: 'Zlofy' }}</span></div>

  <div class="apx-wrap apx-ft__bottom">
    <p class="apx-ft__copy">&copy; {{ year }} {{ settings.brand_name | capitalize }}. All rights reserved.</p>
    <ul class="apx-ft__legal">
      {%- assign lines = settings.footer_legal_links | newline_to_br | split: '<br />' -%}
      {%- for line in lines -%}
        {%- assign parts = line | strip | split: '|' -%}
        {%- assign label = parts[0] | strip -%}
        {%- if label != blank -%}<li><a href="{{ parts[1] | strip | default: '/' }}">{{ label }}</a></li>{%- endif -%}
      {%- endfor -%}
    </ul>
    <p class="apx-ft__fine">{{ 'ap.footer.fine_print' | t }}</p>
  </div>
</footer>

{% stylesheet %}
  .apx-ft{padding:0;background:linear-gradient(180deg,#2A0A11 0%,#33101A 70%,#2A0A11 100%);color:#F5E6E8;text-align:left}
  .apx-ft a{color:#F5E6E8;text-decoration:none}
  .apx-ft a:hover{text-decoration:underline;text-underline-offset:3px}
  .apx-ft a:focus-visible,.apx-ft__input:focus-visible,.apx-ft__btn:focus-visible{outline:3px solid #fff;outline-offset:3px}
  .apx-ft__top{display:grid;gap:36px;padding-block:56px 40px}
  .apx-ft__cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 24px}
  .apx-ft__h{margin:0 0 14px;font-family:var(--ap-font);font-size:1.0625rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#E4A3B1}
  .apx-ft__col ul{display:grid;gap:2px;margin:0;padding:0;list-style:none}
  .apx-ft__col a{display:inline-flex;align-items:center;min-height:36px;font-size:1.0625rem}
  .apx-ft__card{align-self:start;padding:22px 20px 18px;border-radius:14px;background:#EFE9DA;color:#3B0A14;text-align:center;box-shadow:0 18px 40px rgba(0,0,0,.28)}
  .apx-ft__card-t{margin:0 0 14px;font-family:var(--ap-font);font-size:1.375rem;font-weight:800;letter-spacing:.02em;text-transform:uppercase;color:#3B0A14}
  .apx-ft__form{display:flex;align-items:stretch;overflow:hidden;border:1.5px solid #3B0A14;border-radius:999px;background:#F7F2E6}
  .apx-ft__input{flex:1;min-width:0;min-height:48px;padding:0 16px;border:0;background:transparent;color:#3B0A14;font:inherit;font-size:1rem}
  .apx-ft__input::placeholder{color:#6A4C54;opacity:1}
  .apx-ft__input:focus-visible{outline-offset:-4px}
  .apx-ft__btn{flex:none;min-height:48px;padding:0 20px;border:0;background:#3B0A14;color:#fff;font:inherit;font-size:.9375rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;transition:background .2s}
  .apx-ft__btn:hover{background:#6E1423}
  .apx-ft__card-p{margin:12px 0 0;font-size:.875rem;line-height:1.45;color:#3B0A14}
  .apx-ft__mark{position:relative;overflow:hidden;padding:clamp(16px,4vw,40px) 0;background:rgba(255,255,255,.035);text-align:center;user-select:none}
  .apx-ft__mark span{display:block;font-family:var(--ap-font-display);font-size:clamp(4.5rem,22vw,15rem);line-height:1;letter-spacing:.02em;text-transform:uppercase;color:rgba(228,163,177,.14)}
  .apx-ft__bottom{display:grid;gap:12px;padding-block:24px 28px;font-size:.9375rem}
  .apx-ft__copy,.apx-ft__fine{margin:0}
  .apx-ft__fine{font-size:.75rem;color:#D5BCC1;line-height:1.5}
  .apx-ft__legal{display:flex;flex-wrap:wrap;gap:4px 28px;margin:0;padding:0;list-style:none}
  .apx-ft__legal a{display:inline-flex;align-items:center;min-height:36px}
  @media (min-width:760px){
    .apx-ft__cols{grid-template-columns:repeat(4,max-content);justify-content:space-between;gap:32px 40px}
    .apx-ft__bottom{grid-template-columns:1fr auto 1fr;align-items:center}
    .apx-ft__legal{justify-content:center}
    .apx-ft__fine{grid-column:1/-1;text-align:center}
  }
  @media (min-width:1100px){
    .apx-ft__top{grid-template-columns:minmax(0,1fr) 340px;gap:56px;align-items:start}
    .apx-ft__cols{grid-template-columns:repeat(4,max-content);justify-content:start;gap:32px 64px}
  }
  @media (max-width:759px){.apx-footer.apx-ft{padding-bottom:calc(76px + env(safe-area-inset-bottom))}}
{% endstylesheet %}
