{%- comment -%}
  Footer: brand + tagline + sign-up, three link columns and a customer care card,
  a big soft wordmark, and a bottom bar with legal links and payment logos.
  Links are in Theme settings > Footer links (one "Text | address" per line; "email" opens your support email).
  Keep every point true for your store. Nothing here makes a result claim.
{%- endcomment -%}
{%- liquid
  assign email = settings.support_email
  assign year = 'now' | date: '%Y'
  assign badges = settings.footer_badges | newline_to_br | split: '<br />'
-%}
<footer class="apx-footer apx-ft">

  <div class="apx-wrap apx-ft__top">
    <div class="apx-ft__brand">
      <a class="apx-ft__logo" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name }}">{{ settings.brand_name | upcase }}</a>
      {%- if settings.footer_tagline != blank -%}<p class="apx-ft__tag">{{ settings.footer_tagline }}</p>{%- endif -%}
      {%- if settings.footer_badges != blank -%}
        <ul class="apx-ft__badges">
          {%- for b in badges -%}{%- assign bt = b | strip -%}{%- if bt != blank -%}<li>{{ bt }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if settings.footer_signup_title != blank -%}
        {%- form 'customer', id: 'ap-footer-form', class: 'apx-ft__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="apx-sr" for="ap-ft-email">{{ settings.footer_signup_title }}</label>
          <input class="apx-ft__input" id="ap-ft-email" type="email" name="contact[email]" autocomplete="email" inputmode="email" required placeholder="{{ 'ap.newsletter.placeholder' | t }}" aria-describedby="ap-ft-msg">
          <button class="apx-ft__btn" type="submit">{{ settings.footer_signup_button }}</button>
        {%- endform -%}
        <p class="apx-ft__msg" id="ap-ft-msg" role="status">{%- if form.posted_successfully? -%}{{ 'ap.newsletter.thanks' | t }}{%- else -%}{{ settings.footer_signup_text }}{%- endif -%}</p>
      {%- endif -%}
    </div>

    <nav class="apx-ft__cols" aria-label="{{ 'ap.footer.nav' | t }}">
      {%- for n in (1..4) -%}
        {%- assign tk = 'footer_' | append: n | append: '_title' -%}
        {%- assign lk = 'footer_' | append: n | append: '_links' -%}
        {%- if settings[tk] != blank -%}
          <div class="apx-ft__col">
            <h2 class="apx-ft__h">{{ settings[tk] }}</h2>
            <ul>
              {%- assign lines = settings[lk] | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign parts = line | strip | split: '|' -%}
                {%- assign label = parts[0] | strip -%}
                {%- assign url = parts[1] | strip -%}
                {%- if label != blank -%}
                  {%- if url == 'email' -%}{%- assign url = 'mailto:' | append: email -%}{%- endif -%}
                  <li><a href="{{ url | default: '/' }}">{{ label }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- if settings.footer_care_title != blank -%}
      <div class="apx-ft__care">
        <h2 class="apx-ft__care-t">{{ settings.footer_care_title }}</h2>
        {%- if settings.footer_care_text != blank -%}<p class="apx-ft__care-p">{{ settings.footer_care_text }}</p>{%- endif -%}
        {%- if email != blank -%}<a class="apx-ft__care-a" href="mailto:{{ email }}">{{ email }}</a>{%- endif -%}
        {%- if settings.contact_url != blank -%}<a class="apx-ft__care-m" href="{{ settings.contact_url }}">{{ 'ap.product.contact_form' | t | capitalize }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
        {%- if settings.footer_care_note != blank -%}<p class="apx-ft__care-n">{{ settings.footer_care_note }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="apx-ft__mark" aria-hidden="true"><span>{{ settings.brand_name | default: 'Zlofy' }}</span></div>

  <div class="apx-wrap apx-ft__bottom">
    <p class="apx-ft__copy">&copy; {{ year }} {{ settings.brand_name | capitalize }}. All rights reserved.</p>
    <ul class="apx-ft__legal">
      {%- assign lines = settings.footer_legal_links | newline_to_br | split: '<br />' -%}
      {%- for line in lines -%}
        {%- assign parts = line | strip | split: '|' -%}
        {%- assign label = parts[0] | strip -%}
        {%- if label != blank -%}<li><a href="{{ parts[1] | strip | default: '/' }}">{{ label }}</a></li>{%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if settings.footer_show_payments -%}
      <img class="apx-ft__pay" src="{{ 'ap-payment-strip.png' | asset_url }}" alt="{{ 'ap.product.payment_methods' | t }}: Visa, Mastercard, American Express, Apple Pay, Shop Pay" width="1000" height="135" loading="lazy">
    {%- endif -%}
    <p class="apx-ft__fine">{{ 'ap.footer.fine_print' | t }}</p>
  </div>
</footer>

{% stylesheet %}
  .apx-ft{padding:0;background:var(--ap-ink);color:#F5E6E8;text-align:left}
  .apx-ft a{color:#F5E6E8;text-decoration:none}
  .apx-ft a:hover{text-decoration:underline;text-underline-offset:3px}
  .apx-ft a:focus-visible,.apx-ft__input:focus-visible,.apx-ft__btn:focus-visible{outline:3px solid #fff;outline-offset:3px}
  /* trust bar */
  .apx-ft__trust{border-bottom:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04)}
  .apx-ft__trust-l{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 16px;margin:0 auto;padding-block:26px;list-style:none}
  .apx-ft__trust-l li{display:flex;gap:14px;align-items:flex-start}
  .apx-ft__ico{flex:none;display:grid;place-items:center;width:44px;height:44px;border:1px solid rgba(255,255,255,.2);border-radius:12px;background:rgba(255,255,255,.05);color:#E4A3B1}
  .apx-ft__trust-t{display:grid;gap:2px;font-size:.875rem;line-height:1.45;color:#D5BCC1}
  .apx-ft__trust-t strong{font-size:1rem;color:#fff}
  /* main */
  .apx-ft__top{display:grid;gap:40px;padding-block:48px 44px}
  .apx-ft__logo{font-family:var(--ap-font-display);font-size:2.25rem;letter-spacing:.04em;color:#fff}
  .apx-ft__tag{max-width:26em;margin:14px 0 0;font-size:1.0625rem;line-height:1.55;color:#E8D3D6}
  .apx-ft__badges{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 0;padding:0;list-style:none}
  .apx-ft__badges li{padding:.42rem .85rem;border:1px solid rgba(255,255,255,.22);border-radius:999px;background:rgba(255,255,255,.05);font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#F5E6E8}
  .apx-ft__form{display:flex;align-items:stretch;max-width:360px;margin-top:22px;overflow:hidden;border:1px solid rgba(255,255,255,.3);border-radius:999px;background:rgba(255,255,255,.06)}
  .apx-ft__input{flex:1;min-width:0;min-height:46px;padding:0 16px;border:0;background:transparent;color:#fff;font:inherit;font-size:.9375rem}
  .apx-ft__input::placeholder{color:#D5BCC1;opacity:1}
  .apx-ft__input:focus-visible{outline-offset:-4px}
  .apx-ft__btn{flex:none;min-height:46px;padding:0 18px;border:0;background:#F5E6E8;color:#3B0A14;font:inherit;font-size:.8125rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:background .2s}
  .apx-ft__btn:hover{background:#fff}
  .apx-ft__msg{max-width:26em;margin:10px 0 0;font-size:.8125rem;line-height:1.45;color:#D5BCC1}
  .apx-ft__cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 20px}
  .apx-ft__h{margin:0 0 16px;font-family:var(--ap-font);font-size:.8125rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#E4A3B1}
  .apx-ft__col ul{display:grid;gap:2px;margin:0;padding:0;list-style:none}
  .apx-ft__col a{display:inline-flex;align-items:center;min-height:36px;font-size:1rem;color:#F0DADD}
  .apx-ft__care{align-self:start;padding:20px;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:rgba(255,255,255,.05)}
  .apx-ft__care-t{margin:0;font-family:var(--ap-font);font-size:1.0625rem;font-weight:700;color:#fff}
  .apx-ft__care-p{margin:10px 0 16px;font-size:.9375rem;line-height:1.55;color:#D5BCC1}
  .apx-ft__care-a{display:block;padding:13px 14px;border-radius:12px;background:#fff;color:#3B0A14!important;font-size:.9375rem;font-weight:700;text-align:center;word-break:break-all}
  .apx-ft__care-a:hover{text-decoration:none!important;background:#F5E6E8}
  .apx-ft__care-m{display:block;margin-top:12px;text-align:center;font-size:.9375rem;font-weight:700}
  .apx-ft__care-n{margin:12px 0 0;font-size:.8125rem;line-height:1.45;text-align:center;color:#D5BCC1}
  /* wordmark */
  .apx-ft__mark{overflow:hidden;padding:clamp(14px,3vw,32px) 0;border-block:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.035);text-align:center;user-select:none}
  .apx-ft__mark span{display:block;font-family:var(--ap-font-display);font-size:clamp(4.5rem,24vw,13rem);line-height:1;letter-spacing:.18em;text-indent:.18em;text-transform:uppercase;color:rgba(228,163,177,.16)}
  /* bottom */
  .apx-ft__bottom{display:grid;gap:14px;padding-block:24px 30px;font-size:.9375rem}
  .apx-ft__copy,.apx-ft__fine{margin:0}
  .apx-ft__fine{padding-top:14px;border-top:1px solid rgba(255,255,255,.1);font-size:.75rem;line-height:1.55;color:#D5BCC1}
  .apx-ft__legal{display:flex;flex-wrap:wrap;gap:2px 24px;margin:0;padding:0;list-style:none}
  .apx-ft__legal a{display:inline-flex;align-items:center;min-height:36px}
  .apx-ft__pay{display:block;width:min(100%,300px);height:auto;border-radius:8px}
  @media (min-width:760px){
    .apx-ft__trust-l{grid-template-columns:repeat(4,minmax(0,1fr))}
    .apx-ft__cols{grid-template-columns:repeat(3,minmax(0,1fr))}
    .apx-ft__bottom{grid-template-columns:1fr auto;align-items:center}
    .apx-ft__legal{justify-content:flex-end;grid-column:2;grid-row:1}
    .apx-ft__pay{grid-column:1;grid-row:2}
    .apx-ft__fine{grid-column:1/-1}
  }
  @media (min-width:1100px){
    .apx-ft__top{grid-template-columns:minmax(0,1.15fr) minmax(0,2fr) minmax(0,1.1fr);gap:48px;align-items:start}
  }
  @media (max-width:759px){.apx-footer.apx-ft{padding-bottom:calc(76px + env(safe-area-inset-bottom))}.apx-ft__col a,.apx-ft__legal a,.apx-ft__care-m{min-height:44px;display:inline-flex;align-items:center}.apx-ft__care-m{display:flex;justify-content:center}.apx-ft__top{padding-block:36px 28px;gap:28px}.apx-ft__trust-l{padding-block:18px;gap:16px 12px}.apx-ft__ico{width:38px;height:38px}.apx-ft__mark span{font-size:clamp(3.2rem,22vw,5rem)}}
{% endstylesheet %}
