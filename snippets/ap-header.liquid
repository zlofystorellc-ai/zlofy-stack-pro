{%- comment -%}
  Minimal header (single-product store).
  Left: logo (links to the homepage). Right: day/night toggle + cart.
  Desktop (990px and up): three anchor links. Mobile: nothing else (no menu button, no search, no account).
  The "Reviews" link stays hidden unless a reviews section exists on the page (assets/ap-header.js).
  The cart link opens the drawer when JavaScript is available and goes to /cart otherwise.
{%- endcomment -%}
<header class="apx-header" data-ap-header>
  <div class="apx-wrap apx-header__row">
    <a class="apx-header__brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: width: settings.logo_width, alt: settings.brand_name, loading: 'eager' }}
      {%- else -%}
        {% render 'ap-logo' %}
      {%- endif -%}
    </a>

    <nav class="apx-header__nav" aria-label="{{ 'ap.header.primary_nav' | t }}">
      <a href="#how">{{ 'ap.header.how' | t }}</a>
      <a href="#reviews" data-ap-reviews-link hidden>{{ 'ap.header.reviews' | t }}</a>
      <a href="#faq">{{ 'ap.header.faq' | t }}</a>
    </nav>

    <div class="apx-header__right">
      <button
        type="button"
        class="apx-iconbtn apx-theme"
        data-ap-theme-toggle
        aria-pressed="false"
        data-label-to-night="{{ 'ap.header.to_night' | t | escape }}"
        data-label-to-day="{{ 'ap.header.to_day' | t | escape }}"
        aria-label="{{ 'ap.header.to_night' | t }}"
      >
        <span class="apx-theme__sun">{% render 'ap-icon', name: 'sun', size: 24 %}</span>
        <span class="apx-theme__moon">{% render 'ap-icon', name: 'moon', size: 24 %}</span>
      </button>
      <a class="apx-header__cart" href="{{ routes.cart_url }}" data-ap-cart-toggle aria-label="{{ 'ap.header.cart' | t }}">
        {% render 'ap-icon', name: 'bag', size: 24 %}
        <span class="apx-header__count" data-ap-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>
<script src="{{ 'ap-header.js' | asset_url }}" type="module"></script>
