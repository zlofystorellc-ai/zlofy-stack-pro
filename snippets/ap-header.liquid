{%- comment -%}
  Header: nav left (plain links, no dropdowns), centered logo, nav right + account + cart.
  Under 760px the nav collapses into a menu button. Cart link opens the drawer when it exists (JS), else goes to /cart.
  Menu: Online Store > Navigation > "Main menu". Sub-links are ignored: every item is a plain link.
{%- endcomment -%}
{%- liquid
  assign menu = linklists['main-menu']
  assign use_custom = false
  for n in (1..5)
    assign lk = 'nav_' | append: n | append: '_label'
    if settings[lk] != blank
      assign use_custom = true
    endif
  endfor
-%}
<header class="apx-header" data-ap-header>
  <div class="apx-wrap apx-header__row">
    <button type="button" class="apx-iconbtn apx-header__burger" data-ap-menu-toggle aria-expanded="false" aria-controls="ap-mobile-menu" aria-label="{{ 'ap.header.menu' | t }}">
      {% render 'ap-icon', name: 'menu', size: 24 %}
    </button>

    <a class="apx-header__brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: width: settings.logo_width, alt: settings.brand_name, loading: 'eager' }}
      {%- else -%}
        {% render 'ap-logo' %}
      {%- endif -%}
    </a>

    <nav class="apx-header__nav" aria-label="{{ 'ap.header.primary_nav' | t }}">
      <ul>
        {%- if use_custom -%}
          {%- for n in (1..5) -%}
            {%- assign lk = 'nav_' | append: n | append: '_label' -%}
            {%- assign uk = 'nav_' | append: n | append: '_url' -%}
            {%- if settings[lk] != blank -%}<li><a href="{{ settings[uk] | default: '/' }}">{{ settings[lk] }}</a></li>{%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for link in menu.links -%}{% render 'ap-nav-item', link: link %}{%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    <div class="apx-header__right">
      {%- if shop.customer_accounts_enabled -%}
        <a class="apx-header__cart" href="{{ routes.account_url }}" aria-label="{{ 'ap.header.account' | t }}">
          {% render 'ap-icon', name: 'user', size: 24 %}
        </a>
      {%- endif -%}
      <a class="apx-header__cart apx-header__bag" href="{{ routes.cart_url }}" data-ap-cart-toggle aria-label="{{ 'ap.header.cart' | t }}">
        <span class="apx-header__bag-t" aria-hidden="true">{{ 'ap.header.bag' | t }}</span>
        <span class="apx-header__count" data-ap-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav class="apx-mobilemenu" id="ap-mobile-menu" data-ap-menu hidden aria-label="{{ 'ap.header.primary_nav' | t }}">
    <ul class="apx-wrap">
      {%- if use_custom -%}
        {%- for n in (1..5) -%}
          {%- assign lk = 'nav_' | append: n | append: '_label' -%}
          {%- assign uk = 'nav_' | append: n | append: '_url' -%}
          {%- if settings[lk] != blank -%}<li><a href="{{ settings[uk] | default: '/' }}">{{ settings[lk] }}</a></li>{%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for link in menu.links -%}
          <li>
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </nav>
</header>
<script src="{{ 'ap-header.js' | asset_url }}" type="module"></script>
