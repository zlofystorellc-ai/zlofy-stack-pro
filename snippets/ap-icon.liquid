{%- comment -%}
  Original inline SVG icons (drawn for this theme). Decorative: aria-hidden.
  Usage: {% render 'ap-icon', name: 'sun', size: 24 %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
-%}
<svg class="apx-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6L6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/>
    {%- when 'moon' -%}
      <path d="M20.5 14A8.5 8.5 0 1 1 10 3.5a7 7 0 0 0 10.5 10.5z"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'x' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5.5c0 4.4-3 7.6-7 9.5-4-1.9-7-5.1-7-9.5V6z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'truck' -%}
      <path d="M2.5 7h10.5v9H2.5zM13 10h4.5l3 3v3H13"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l8.5 6 8.5-6"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19c3-5 6-8 10-10"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 20.5c1-4 4-6 8-6s7 2 8 6"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'bag' -%}
      <path d="M6 8h12l1 12H5z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'sparkle' -%}
      <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>
    {%- when 'drop' -%}
      <path d="M12 3c4 4.5 6 7.5 6 10.5a6 6 0 0 1-12 0C6 10.5 8 7.5 12 3z"/>
    {%- when 'layers' -%}
      <path d="M12 4l9 5-9 5-9-5z"/><path d="M3 14l9 5 9-5"/>
    {%- when 'pebble' -%}
      <rect x="4" y="4" width="16" height="16" rx="6"/>
    {%- when 'chevron' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'pause' -%}
      <path d="M8 5v14M16 5v14"/>
    {%- when 'play' -%}
      <path d="M8 5l11 7-11 7z"/>
    {%- when 'star' -%}
      <path fill="currentColor" stroke="none" d="M12 3.2l2.6 5.5 6 .8-4.4 4.1 1.1 5.9L12 16.6 6.7 19.5l1.1-5.9L3.4 9.5l6-.8z"/>
    {%- when 'hand' -%}
      <path d="M8 12V6.5a1.5 1.5 0 0 1 3 0V11m0-1.5a1.5 1.5 0 0 1 3 0V12m0-1.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-.5A5.5 5.5 0 0 1 6 16.5l-1.6-3a1.4 1.4 0 0 1 2.2-1.6L8 13"/>
    {%- else -%}
      <rect x="4" y="4" width="16" height="16" rx="6"/>
  {%- endcase -%}
</svg>
