{%- comment -%}
  ZLOFY logo: classic lowercase serif wordmark "zlofy" with the "o" in blush red.
  The name is real text (set in the theme's heading serif), so it is crisp at every size and needs no image.
  Used when no logo image is uploaded in Theme settings. Any brand name other than ZLOFY is shown as plain serif text.
{%- endcomment -%}
{%- assign brand = settings.brand_name | strip -%}
{%- assign low = brand | downcase -%}
<span class="apx-logo">
  <span class="apx-sr">{{ brand }}</span>
  {%- if low == 'zlofy' -%}
    <span class="apx-logo__w" aria-hidden="true">zl<span class="apx-logo__o">o</span>fy</span>
  {%- else -%}
    <span class="apx-logo__w" aria-hidden="true">{{ brand }}</span>
  {%- endif -%}
</span>
