{%- comment -%}
  ZLOFY wordmark with a patch "O": the O is a round hydrocolloid patch (the product itself) with a small clear centre.
  The name stays real text (letters are text, only the O is drawn). Used when no logo image is uploaded in Theme settings.
  Letters ZL + FY are generated from the brand name only when it is exactly "ZLOFY"; any other brand name is shown as plain text.
{%- endcomment -%}
{%- assign brand = settings.brand_name | strip -%}
{%- assign up = brand | upcase -%}
<span class="apx-logo">
  <span class="apx-sr">{{ brand }}</span>
  {%- if up == 'ZLOFY' -%}
    <span class="apx-logo__w" aria-hidden="true">ZL</span>
    <svg class="apx-logo__o" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="15" fill="var(--ap-blush-deep)"/>
      <circle cx="16" cy="16" r="9.5" fill="none" stroke="var(--ap-white)" stroke-opacity=".45" stroke-width="1.5"/>
      <circle cx="16" cy="16" r="3.4" fill="var(--ap-white)"/>
    </svg>
    <span class="apx-logo__w" aria-hidden="true">FY</span>
  {%- else -%}
    <span class="apx-logo__w" aria-hidden="true">{{ brand }}</span>
  {%- endif -%}
</span>
