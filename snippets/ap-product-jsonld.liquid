{%- comment -%}
  Product + BreadcrumbList JSON-LD.
  aggregateRating is output ONLY when real data exists in the reviews.rating / reviews.rating_count
  product metafields (written by your reviews app). Never hand-type ratings here.
  Params: product
{%- endcomment -%}
{%- liquid
  assign jl_variant = product.selected_or_first_available_variant
  assign jl_rating = product.metafields.reviews.rating.value
  assign jl_count = product.metafields.reviews.rating_count.value | default: 0
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ canonical_url | json }},
  "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
  {%- if jl_variant.sku != blank %}
  "sku": {{ jl_variant.sku | json }},
  {%- endif %}
  {%- if product.images.size > 0 %}
  "image": [
    {%- for image in product.images limit: 4 -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  ],
  {%- endif %}
  "brand": { "@type": "Brand", "name": {{ settings.brand_name | json }} },
  {%- if jl_rating != blank and jl_count > 0 %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ jl_rating.rating | json }},
    "bestRating": {{ jl_rating.scale_max | json }},
    "ratingCount": {{ jl_count | json }}
  },
  {%- endif %}
  "offers": [
    {%- for variant in product.variants limit: 50 -%}
    {
      "@type": "Offer",
      "url": {{ variant.url | prepend: shop.url | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition"
    }{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'ap.general.home' | t | json }}, "item": {{ shop.url | json }} }
    {%- if collection != blank %},
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: shop.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
    {%- else %},
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
    {%- endif %}
  ]
}
</script>
