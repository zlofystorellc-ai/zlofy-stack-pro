{%- comment -%}
  Design tokens + shared base stylesheet.
  Rendered in <head> by layout/theme.liquid and again (harmless duplicate) by sections/ap-hero.liquid,
  so the product page still works when these files are merged into another theme's layout.
{%- endcomment -%}
<style>
  :root {
    --ap-ink: {{ settings.color_ink | default: '#1B1B3A' }};
    --ap-blush: {{ settings.color_blush | default: '#F95D75' }};
    --ap-blush-deep: {{ settings.color_blush_deep | default: '#CF2749' }};
    --ap-lilac: {{ settings.color_lilac | default: '#CDB8FF' }};
    --ap-sand: {{ settings.color_sand | default: '#FFF0F2' }};
    --ap-butter: {{ settings.color_butter | default: '#FFE066' }};
    --ap-apricot: {{ settings.color_apricot | default: '#FFB270' }};
    --ap-white: {{ settings.color_white | default: '#FFFFFF' }};
    --ap-ink-soft: #4A4A6A;
    --ap-line: #F2D0D8;
    --ap-radius: 18px;
    --ap-radius-sm: 12px;
    --ap-gutter: 16px;
    --ap-max: 1200px;
    --ap-font: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --ap-font-display: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --ap-sticky-offset: 0px;
  }
</style>
<link rel="stylesheet" href="{{ 'ap-base.css' | asset_url }}">
