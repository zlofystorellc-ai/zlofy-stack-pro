{%- comment -%}
  Design tokens + shared base stylesheet.
  Rendered in <head> by layout/theme.liquid and again (harmless duplicate) by sections/ap-hero.liquid,
  so the product page still works when these files are merged into another theme's layout.
{%- endcomment -%}
<style>
  :root {
    --ap-ink: {{ settings.color_ink | default: '#1F2A44' }};
    --ap-blush: {{ settings.color_blush | default: '#E5707F' }};
    --ap-blush-deep: {{ settings.color_blush_deep | default: '#B3384B' }};
    --ap-lilac: {{ settings.color_lilac | default: '#C8B6E2' }};
    --ap-sand: {{ settings.color_sand | default: '#FBEBED' }};
    --ap-apricot: {{ settings.color_apricot | default: '#F4A261' }};
    --ap-white: {{ settings.color_white | default: '#FFFFFF' }};
    --ap-ink-soft: #44506B;
    --ap-line: #EBCDD2;
    --ap-radius: 18px;
    --ap-radius-sm: 12px;
    --ap-gutter: 16px;
    --ap-max: 1200px;
    --ap-font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --ap-font-display: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --ap-sticky-offset: 0px;
  }
</style>
<link rel="stylesheet" href="{{ 'ap-base.css' | asset_url }}">
