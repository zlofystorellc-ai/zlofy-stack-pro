{%- comment -%}
  Design tokens + shared base stylesheet.
  Rendered in <head> by layout/theme.liquid and again (harmless duplicate) by sections/ap-hero.liquid,
  so the product page still works when these files are merged into another theme's layout.
{%- endcomment -%}
<style>
  :root {
    --ap-ink: {{ settings.color_ink | default: '#3B0A14' }};
    --ap-blush: {{ settings.color_blush | default: '#B4566A' }};
    --ap-blush-deep: {{ settings.color_blush_deep | default: '#6E1423' }};
    --ap-lilac: {{ settings.color_lilac | default: '#E9CED4' }};
    --ap-sand: {{ settings.color_sand | default: '#FBF7F5' }};
    --ap-butter: {{ settings.color_butter | default: '#EBD3A8' }};
    --ap-apricot: {{ settings.color_apricot | default: '#E3B79A' }};
    --ap-white: {{ settings.color_white | default: '#FFFFFF' }};
    --ap-ink-soft: #6A4C54;
    --ap-line: #EAD6D9;
    --ap-radius: 18px;
    --ap-radius-sm: 12px;
    --ap-gutter: 16px;
    --ap-max: 1200px;
    --ap-font: "DM Sans", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --ap-font-display: "DM Serif Display", Georgia, "Times New Roman", serif;
    --ap-sticky-offset: 0px;
  }
</style>
<link rel="stylesheet" href="{{ 'ap-base.css' | asset_url }}">
