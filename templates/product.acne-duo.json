    "how": {
      "type": "ap-how-it-works",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Cleanse and dry",
            "text": "Wash your face gently and pat dry. Patches stick best to clean, dry skin."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Press for 10 seconds",
            "text": "Place the patch over the spot and press from the center out so the edges seal."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Leave on 6–8 hours",
            "text": "Wear it for 6–8 hours, or until the patch turns white, which means it has taken in as much fluid as it can hold."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Peel and swap",
            "text": "Peel from an edge, toss it, and add a fresh patch if the spot is still there."
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3",
        "step_4"
      ]
